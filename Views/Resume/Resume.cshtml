@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;

    ViewData["Title"] = "Resume";

    var p = Model.Profile;
}

@functions {

    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();

                if (idValue == id.ToString())
                    return nameProp.GetValue(item)?.ToString() ?? "";
            }
        }

        return "";
    }

    bool Has(string s)
    {
        return !string.IsNullOrWhiteSpace(s);
    }

    bool HasNum(int? n)
    {
        return n.HasValue && n.Value != 0;
    }
}
<script>
    document.addEventListener("DOMContentLoaded", function () {

        var addressEl = document.getElementById("rvAddress");
        if (!addressEl) return;

        var countryID = addressEl.getAttribute("data-country-id") || "";
        var stateID   = addressEl.getAttribute("data-state-id") || "";
        var cityID    = addressEl.getAttribute("data-city-id") || "";
        var pincode   = addressEl.getAttribute("data-pincode") || "";

        function renderAddress(cityName, stateName, countryName) {
            var parts = [cityName, stateName, countryName, pincode]
                .filter(function (p) { return p && p.trim() !== ""; });

            addressEl.textContent = parts.length ? parts.join(", ") : "-";
        }

        if (!countryID) {
            // Nothing to resolve — leave Pincode-only display as-is
            return;
        }

        fetch('/Location/GetCountries')
            .then(function (res) { return res.json(); })
            .then(function (countries) {

                var country = countries.find(function (c) {
                    return String(c.id) === String(countryID);
                });

                var countryName = country ? country.name : "";
                var countryCode = country ? country.iso2 : countryID;

                if (!stateID) {
                    renderAddress("", "", countryName);
                    return;
                }

                fetch('/Location/GetStates?countryCode=' + encodeURIComponent(countryCode))
                    .then(function (res) { return res.json(); })
                    .then(function (states) {

                        var state = states.find(function (s) {
                            return String(s.id) === String(stateID);
                        });

                        var stateName = state ? state.name : "";

                        var stateCode = state
                            ? (state.stateCode || (String(state.id).split(':')[1] || state.id))
                            : "";

                        if (!cityID) {
                            renderAddress("", stateName, countryName);
                            return;
                        }

                        fetch('/Location/GetCities?countryCode=' + encodeURIComponent(countryCode) +
                              '&stateCode=' + encodeURIComponent(stateCode))
                            .then(function (res) { return res.json(); })
                            .then(function (cities) {

                                var city = cities.find(function (c) {
                                    return String(c.id) === String(cityID);
                                });

                                var cityName = city ? city.name : "";

                                renderAddress(cityName, stateName, countryName);
                            })
                            .catch(function () { renderAddress("", stateName, countryName); });
                    })
                    .catch(function () { renderAddress("", "", countryName); });
            })
            .catch(function (err) {
                console.log("Address resolution error:", err);
            });
    });

    async function downloadResumePDF() {

    const resumeSheet =
        document.getElementById("resumeSheet");

    if (!resumeSheet) {
        alert("Resume not found.");
        return;
    }

    const downloadBtn =
        document.querySelector(".btn-download");

    const originalText =
        downloadBtn.innerHTML;

    try {

        /* =========================================
           BUTTON LOADING
           ========================================= */

        downloadBtn.disabled = true;

        downloadBtn.innerHTML =
            '<i class="fa fa-spinner fa-spin"></i> Generating...';


        /* =========================================
           WAIT FOR IMAGES
           ========================================= */

        const images =
            resumeSheet.querySelectorAll("img");

        await Promise.all(
            Array.from(images).map(function (img) {

                if (img.complete) {
                    return Promise.resolve();
                }

                return new Promise(function (resolve) {

                    img.onload = resolve;
                    img.onerror = resolve;

                });

            })
        );


        /* =========================================
           CAPTURE RESUME
           ========================================= */

        const canvas =
            await html2canvas(
                resumeSheet,
                {
                    scale: 3,
                    useCORS: true,
                    allowTaint: false,
                    backgroundColor: "#ffffff",
                    logging: false
                }
            );


        /* =========================================
           CREATE A4 PDF
           ========================================= */

        const {
            jsPDF
        } = window.jspdf;


        const pdf =
            new jsPDF(
                {
                    orientation: "portrait",
                    unit: "mm",
                    format: "a4",
                    compress: true
                }
            );


        const pageWidth =
            pdf.internal.pageSize.getWidth();

        const pageHeight =
            pdf.internal.pageSize.getHeight();


        /* =========================================
           FIT IMAGE PERFECTLY TO A4
           ========================================= */

        const imageWidth =
            pageWidth;

        const imageHeight =
            canvas.height *
            imageWidth /
            canvas.width;


        const image =
            canvas.toDataURL(
                "image/jpeg",
                0.95
            );


        pdf.addImage(
            image,
            "JPEG",
            0,
            0,
            imageWidth,
            imageHeight,
            undefined,
            "FAST"
        );


        /* =========================================
           FILE NAME
           ========================================= */

        let candidateName =
            "@(Model.CandidateName ?? "Candidate")";


        candidateName =
            candidateName
                .trim()
                .replace(
                    /[^a-zA-Z0-9-_ ]/g,
                    ""
                )
                .replace(
                    /\s+/g,
                    "_"
                );


        if (!candidateName) {
            candidateName = "Candidate";
        }


        const fileName =
            candidateName +
            "_Resume.pdf";


        /* =========================================
           DOWNLOAD
           ========================================= */

        pdf.save(fileName);

    }
    catch (error) {

        console.error(
            "PDF generation error:",
            error
        );

        alert(
            "Unable to generate PDF. Please try again."
        );

    }
    finally {

        downloadBtn.disabled = false;

        downloadBtn.innerHTML =
            originalText;

    }

}
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @(Model.CandidateName ?? "Candidate") - Resume
    </title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>

        /* =========================================================
           THEME VARIABLES
           ========================================================= */

        :root {
            --accent: #f5a623;
            --sidebar-bg: #2b2b2b;
        }


        /* =========================================================
           PAGE
           ========================================================= */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #e9e9e9;
            font-family: "Segoe UI", Arial, sans-serif;
        }


        /* =========================================================
           TOOLBAR
           ========================================================= */

        .resume-toolbar {
            max-width: 210mm;
            margin: 20px auto 16px auto;

            display: flex;
            justify-content: flex-end;
            align-items: center;

            gap: 10px;
        }

        .resume-toolbar a,
        .resume-toolbar button {
            border: none;
            padding: 9px 15px;

            border-radius: 6px;

            font-size: 13px;

            cursor: pointer;

            text-decoration: none;
        }

        .btn-edit {
            background: #fff;
            color: #333;

            border: 1px solid #ccc !important;
        }

        .btn-print {
            background: #0d9488;
            color: #fff;
        }

        .btn-print:hover {
            background: #0f766e;
        }


        /* =========================================================
           THEME SWITCHER
           ========================================================= */

        .theme-switcher {
            max-width: 210mm;
            margin: 0 auto 12px auto;

            display: flex;
            align-items: center;

            gap: 8px;
        }

        .theme-switcher span {
            font-size: 12px;
            color: #666;
            font-weight: 600;

            margin-right: 4px;
        }

        .theme-swatch {
            width: 26px;
            height: 26px;

            border-radius: 50%;

            cursor: pointer;

            border: 2px solid #fff;

            box-shadow: 0 0 0 1px #ccc;

            transition:
                transform 0.15s ease,
                box-shadow 0.15s ease;
        }

        .theme-swatch:hover {
            transform: scale(1.12);
        }

        .theme-swatch.active {
            box-shadow: 0 0 0 2px #333;
        }


        /* =========================================================
           PAGE WRAPPER
           ========================================================= */

        .resume-page-wrapper {
            background: #e9e9e9;

            padding: 24px 0 60px 0;
        }


        /* =========================================================
           A4 RESUME
           ========================================================= */

        .resume-sheet {

            width: 210mm;
            height: 297mm;

            margin: 0 auto;

            background: #fff;

            box-shadow:
                0 0 18px rgba(0, 0, 0, 0.25);

            display: flex;

            align-items: stretch;

            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            color: #333;

            position: relative;

            box-sizing: border-box;

            overflow: hidden;
        }


        /* =========================================================
           ACCENT
           ========================================================= */

        .resume-accent {
            color: var(--accent);
        }


        /* =========================================================
           LEFT SIDEBAR
           ========================================================= */

        .resume-sidebar {

            width: 35%;

            background: var(--sidebar-bg);

            color: #eee;

            padding: 30px 20px;

            box-sizing: border-box;

            min-width: 0;

            overflow: hidden;
        }


        /* =========================================================
           PHOTO
           ========================================================= */

        .resume-photo-wrap {

            text-align: center;

            margin-bottom: 25px;
        }

        .resume-photo {

            width: 120px;
            height: 120px;

            border-radius: 50%;

            object-fit: cover;

            border:
                4px solid var(--accent);

            background: #444;
        }

        .resume-photo-placeholder {

            width: 120px;
            height: 120px;

            border-radius: 50%;

            border:
                4px solid var(--accent);

            background: #444;

            margin: 0 auto;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 40px;

            color: #999;
        }


        /* =========================================================
           SIDEBAR SECTION
           ========================================================= */

        .resume-sidebar-section {

            margin-bottom: 26px;
        }

        .resume-sidebar-title {

            color: var(--accent);

            font-size: 13px;

            font-weight: 700;

            letter-spacing: 1px;

            text-transform: uppercase;

            margin-bottom: 12px;

            border-bottom:
                1px solid #555;

            padding-bottom: 6px;
        }

        .resume-sidebar-item {

            font-size: 11.5px;

            line-height: 1.5;

            margin-bottom: 10px;

            word-break: break-word;
        }

        .resume-sidebar-item strong {

            display: block;

            color: #fff;

            font-size: 12px;
        }

        .resume-sidebar-item .muted {

            color: #bbb;
        }


        /* =========================================================
           RIGHT CONTENT
           ========================================================= */

        .resume-main {

            width: 65%;

            padding: 35px;

            box-sizing: border-box;

            min-width: 0;

            overflow: hidden;
        }


        /* =========================================================
           NAME
           ========================================================= */

        .resume-name {

            font-size: 26px;

            font-weight: 700;

            color: #2b2b2b;

            margin: 0;

            text-transform: uppercase;

            letter-spacing: 1px;

            word-break: break-word;
        }

        .resume-role {

            font-size: 13px;

            color: var(--accent);

            font-weight: 600;

            letter-spacing: 2px;

            text-transform: uppercase;

            margin-bottom: 25px;
        }


        /* =========================================================
           SECTION
           ========================================================= */

        .resume-section {

            margin-bottom: 26px;

            break-inside: avoid;

            page-break-inside: avoid;
        }

        .resume-section-title {

            font-size: 15px;

            font-weight: 700;

            color: #2b2b2b;

            text-transform: uppercase;

            letter-spacing: 1px;

            margin-bottom: 12px;

            position: relative;

            padding-left: 18px;
        }

        .resume-section-title::before {

            content: "";

            position: absolute;

            left: 0;

            top: 3px;

            width: 10px;

            height: 10px;

            background: var(--accent);

            border-radius: 2px;

            transform: rotate(45deg);
        }


        /* =========================================================
           BODY
           ========================================================= */

        .resume-section-body p {

            font-size: 12.5px;

            line-height: 1.6;

            color: #555;

            margin: 0 0 6px 0;

            word-break: break-word;
        }


        /* =========================================================
           EXPERIENCE
           ========================================================= */

        .resume-entry {

            margin-bottom: 16px;

            padding-left: 14px;

            border-left:
                2px solid #f0f0f0;

            break-inside: avoid;

            page-break-inside: avoid;
        }

        .resume-entry-title {

            font-size: 13px;

            font-weight: 700;

            color: #2b2b2b;
        }

        .resume-entry-sub {

            font-size: 11.5px;

            color: var(--accent);

            font-weight: 600;

            margin-bottom: 4px;
        }

        .resume-entry-meta {

            font-size: 11px;

            color: #888;
        }


        /* =========================================================
           SKILLS
           ========================================================= */

        .resume-skill-row {

            margin-bottom: 10px;
        }

        .resume-skill-label {

            font-size: 12px;

            color: #444;

            margin-bottom: 4px;

            display: flex;

            justify-content: space-between;
        }


        /* =========================================================
           THEMES
           ========================================================= */

        .resume-sheet[data-theme="orange"] {
            --accent: #f5a623;
            --sidebar-bg: #2b2b2b;
        }

        .resume-sheet[data-theme="navy-gold"] {
            --accent: #d4af37;
            --sidebar-bg: #0f2140;
        }

        .resume-sheet[data-theme="teal-coral"] {
            --accent: #ff6f61;
            --sidebar-bg: #0f3d3e;
        }

        .resume-sheet[data-theme="charcoal-blue"] {
            --accent: #3b82f6;
            --sidebar-bg: #1f2937;
        }

        .resume-sheet[data-theme="maroon-beige"] {
            --accent: #d9a56b;
            --sidebar-bg: #4a1a1a;
        }

        .resume-sheet[data-theme="emerald"] {
            --accent: #34d399;
            --sidebar-bg: #064e3b;
        }

 /* =========================================================
   MOBILE / TABLET
   EXACTLY SAME AS DESKTOP
   ========================================================= */

@@media screen and (max-width: 1100px) {

    html,
    body {
        margin: 0;
        padding: 0;
        background: #e9e9e9;
    }

    /*
       Keep the toolbar same desktop design
    */
    .resume-toolbar {
        width: 210mm;
        max-width: none;
        margin: 20px auto 16px auto;

        display: flex;
        justify-content: flex-end;
        align-items: center;

        gap: 10px;

        flex-wrap: nowrap;
    }

    .resume-toolbar a,
    .resume-toolbar button {
        padding: 9px 15px;
        font-size: 13px;
        white-space: nowrap;
    }


    /*
       Keep theme switcher same desktop design
    */
    .theme-switcher {
        width: 210mm;
        max-width: none;
        margin: 0 auto 12px auto;

        display: flex;
        align-items: center;

        gap: 8px;

        flex-wrap: nowrap;
    }


    /*
       Allow horizontal scrolling on small screens
       instead of changing resume design
    */
    .resume-page-wrapper {

        width: 100%;

        padding: 24px 0 60px 0;

        
        overflow-y: visible;
    }


    /*
       EXACT SAME DESKTOP RESUME
    */
    .resume-sheet {

        width: 210mm;
        height: 297mm;

        min-width: 210mm;
        min-height: 297mm;

        max-width: none;

        margin: 0 auto;

        display: flex;

        flex-direction: row;

        align-items: stretch;

        overflow: hidden;

        box-shadow:
            0 0 18px rgba(0, 0, 0, 0.25);

        transform: none;
    }


    /*
       EXACT SAME SIDEBAR
    */
    .resume-sidebar {

        width: 35%;

        flex: 0 0 35%;

        padding: 30px 20px;

        overflow: hidden;
    }


    /*
       EXACT SAME MAIN
    */
    .resume-main {

        width: 65%;

        flex: 0 0 65%;

        padding: 35px;

        overflow: hidden;
    }


    /*
       DO NOT CHANGE PHOTO SIZE
    */
    .resume-photo,
    .resume-photo-placeholder {

        width: 120px;
        height: 120px;
    }


    /*
       DO NOT CHANGE TYPOGRAPHY
    */
    .resume-name {
        font-size: 26px;
    }

    .resume-role {
        font-size: 13px;
    }

    .resume-section-title {
        font-size: 15px;
    }

    .resume-section-body p {
        font-size: 12.5px;
    }

    .resume-sidebar-item {
        font-size: 11.5px;
    }
}


        /* =========================================================
           PRINT
           ========================================================= */

        @@media print {

            html,
            body {

                width: 210mm;

                height: 297mm;

                margin: 0;

                padding: 0;

                background: #fff;
            }

            body * {

                visibility: hidden;
            }

            .resume-sheet,
            .resume-sheet * {

                visibility: visible;
            }

            .resume-page-wrapper {

                padding: 0;

                margin: 0;

                background: #fff;
            }

            .resume-sheet {

                width: 210mm;

                height: 297mm;

                min-height: 297mm;

                margin: 0;

                box-shadow: none;

                display: flex;

                overflow: hidden;
            }

            .resume-toolbar,
            .theme-switcher {

                display: none !important;
            }

            .resume-section,
            .resume-entry,
            .resume-sidebar-section {

                break-inside: avoid;

                page-break-inside: avoid;
            }

            @@page {

                size: A4;

                margin: 0;
            }
        }

        .btn-download {
    background: #2b2b2b;
    color: #fff;
}

.btn-download:hover {
    background: #111;
}

    </style>

</head>


<body>

    <!-- =========================================================
         TOOLBAR
         ========================================================= -->

    <div class="resume-toolbar">

        <a asp-controller="Candidate"
           asp-action="Profile"
           class="btn-edit">

            <i class="fa fa-pen"></i>

            Edit Profile

        </a>


        <button type="button"
                class="btn-print"
                onclick="window.print()">

            <i class="fa fa-print"></i>

            Print / Save as PDF

        </button>

         <button type="button"
            class="btn-download"
            onclick="downloadResumePDF()">

        <i class="fa fa-download"></i>
        Download PDF

    </button>

    </div>


    <!-- =========================================================
         THEME SWITCHER
         ========================================================= -->

    <div class="theme-switcher">

        <span>Theme</span>

        <div class="theme-swatch active"
             data-theme="orange"
             style="background:#2b2b2b;"
             title="Orange & Charcoal">
        </div>

        <div class="theme-swatch"
             data-theme="navy-gold"
             style="background:#0f2140;"
             title="Navy & Gold">
        </div>

        <div class="theme-swatch"
             data-theme="teal-coral"
             style="background:#0f3d3e;"
             title="Teal & Coral">
        </div>

        <div class="theme-swatch"
             data-theme="charcoal-blue"
             style="background:#1f2937;"
             title="Charcoal & Blue">
        </div>

        <div class="theme-swatch"
             data-theme="maroon-beige"
             style="background:#4a1a1a;"
             title="Maroon & Beige">
        </div>

        <div class="theme-swatch"
             data-theme="emerald"
             style="background:#064e3b;"
             title="Emerald">
        </div>

    </div>


    <!-- =========================================================
         RESUME PAGE
         ========================================================= -->

    <div class="resume-page-wrapper">

        <div class="resume-sheet"
             id="resumeSheet"
             data-theme="orange">


            <!-- =================================================
                 SIDEBAR
                 ================================================= -->

            <div class="resume-sidebar">


                <!-- PHOTO -->

                <div class="resume-photo-wrap">

                    @if (Has(p.sPhoto))
                    {
                        <img src="@p.sPhoto"
                             class="resume-photo"
                             alt="Candidate Photo" />
                    }
                    else
                    {
                        <div class="resume-photo-placeholder">

                            <i class="fa fa-user"></i>

                        </div>
                    }

                </div>


                <!-- =================================================
                     ADDRESS
                     ================================================= -->

              

               @if (Has(p.CountryID) || Has(p.StateID) || Has(p.CityID) || Has(p.Pincode))
{
    <div class="resume-sidebar-section">

        <div class="resume-sidebar-title">
            Address
        </div>

        <div class="resume-sidebar-item">

            <i class="fa fa-map-marker resume-accent"></i>

            <span class="muted"
                  id="rvAddress"
                  data-country-id="@p.CountryID"
                  data-state-id="@p.StateID"
                  data-city-id="@p.CityID"
                  data-pincode="@p.Pincode">

                @if (Has(p.Pincode))
                {
                    @p.Pincode
                }
                else
                {
                    <text>-</text>
                }

            </span>

        </div>

    </div>
}


                <!-- =================================================
                     CONTACT
                     ================================================= -->

                @if (Has(Model.CandidateEmail))
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">
                            Contact Me
                        </div>

                        <div class="resume-sidebar-item">

                            <i class="fa fa-envelope resume-accent"></i>

                            <span class="muted">
                                @Model.CandidateEmail
                            </span>

                        </div>

                    </div>

                }


                <!-- =================================================
                     PHONE
                     ================================================= -->

                @if (Has(Model.CandidatePhone))
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">
                            Phone
                        </div>

                        <div class="resume-sidebar-item">

                            <i class="fa fa-phone resume-accent"></i>

                            <span class="muted">
                                @Model.CandidatePhone
                            </span>

                        </div>

                    </div>

                }


                <!-- =================================================
                     PREFERRED LOCATION
                     ================================================= -->

            

                @if (
    Has(p.Preferred_City) ||
    Has(p.Preferred_State) ||
    Has(p.Preferred_Country) ||
    Has(GetLookupName(Model.InternshipFellowshipType, p.Internship_FellowshipType))
)
{
    <div class="resume-sidebar-section">

        <div class="resume-sidebar-title">
            Internship / Fellowship Preference
        </div>

        @{
            var prefType = GetLookupName(
                Model.InternshipFellowshipType,
                p.Internship_FellowshipType
            );
        }

        @if (Has(prefType))
        {
            <div class="resume-sidebar-item">
                <i class="fa fa-briefcase resume-accent"></i>
                <span class="muted">@prefType</span>
            </div>
        }

        @if (Has(p.Preferred_City) || Has(p.Preferred_State) || Has(p.Preferred_Country))
        {
            <div class="resume-sidebar-item">
                <i class="fa fa-location-arrow resume-accent"></i>
                <span class="muted">
                    @string.Join(
                        ", ",
                        new[] { p.Preferred_City, p.Preferred_State, p.Preferred_Country }.Where(Has)
                    )
                </span>
            </div>
        }

    </div>
}
                <!-- =================================================
                     SOCIAL LINKS
                     ================================================= -->

                @if (Has(p.GitHub) || Has(p.Linkedin))
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">
                            Links
                        </div>


                        @if (Has(p.GitHub))
                        {

                            <div class="resume-sidebar-item">

                                <i class="fa fa-github resume-accent"></i>

                                <span class="muted">
                                    @p.GitHub
                                </span>

                            </div>

                        }


                        @if (Has(p.Linkedin))
                        {

                            <div class="resume-sidebar-item">

                                <i class="fa fa-linkedin resume-accent"></i>

                                <span class="muted">
                                    @p.Linkedin
                                </span>

                            </div>

                        }

                    </div>

                }


                <!-- =================================================
                     REFERENCES
                     ================================================= -->

                @if (Has(p.sRefName1) || Has(p.sRefName2))
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">
                            References
                        </div>


                        @if (Has(p.sRefName1))
                        {

                            <div class="resume-sidebar-item">

                                <strong>
                                    @p.sRefName1
                                </strong>

                                <span class="muted">

                                    @GetLookupName(
                                        Model.Relationships,
                                        p.sRefRelationName1
                                    )

                                </span>

                                <br />

                                @if (Has(p.sLocation1))
                                {
                                    <span class="muted">
                                        @p.sLocation1
                                    </span>

                                    <br />
                                }

                                @if (Has(p.sMobile1))
                                {
                                    <span class="muted">
                                        Tel: @p.sMobile1
                                    </span>
                                }

                            </div>

                        }


                        @if (Has(p.sRefName2))
                        {

                            <div class="resume-sidebar-item">

                                <strong>
                                    @p.sRefName2
                                </strong>

                                <span class="muted">

                                    @GetLookupName(
                                        Model.Relationships,
                                        p.sRefRelationName2
                                    )

                                </span>

                                <br />

                                @if (Has(p.sLocation2))
                                {
                                    <span class="muted">
                                        @p.sLocation2
                                    </span>

                                    <br />
                                }

                                @if (Has(p.sMobile2))
                                {
                                    <span class="muted">
                                        Tel: @p.sMobile2
                                    </span>
                                }

                            </div>

                        }

                    </div>

                }


                <!-- =================================================
                     EDUCATION
                     ================================================= -->

                @if (
                    HasNum(p.Graduation_Year) ||
                    HasNum(p.PG_Year) ||
                    HasNum(p.HSC_DIPLOMA_YEAR) ||
                    HasNum(p.SSC_YEAR)
                )
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">
                            Education
                        </div>


                        @if (HasNum(p.PG_Year))
                        {

                            <div class="resume-sidebar-item">

                                <strong>

                                    @GetLookupName(
                                        Model.Streams,
                                        p.PG_Stream
                                    )

                                    — Post Graduation

                                </strong>

                                <span class="muted">

                                    @p.PG_Year

                                    &middot;

                                    @GetLookupName(
                                        Model.Divisions,
                                        p.PG_Division
                                    )

                                </span>

                            </div>

                        }


                        @if (HasNum(p.Graduation_Year))
                        {

                            <div class="resume-sidebar-item">

                                <strong>

                                    @GetLookupName(
                                        Model.Streams,
                                        p.Graduation_Stream
                                    )

                                    — Graduation

                                </strong>

                                <span class="muted">

                                    @p.Graduation_Year

                                    &middot;

                                    @GetLookupName(
                                        Model.Divisions,
                                        p.Graduation_Division
                                    )

                                </span>

                            </div>

                        }


                        @if (HasNum(p.HSC_DIPLOMA_YEAR))
                        {

                            <div class="resume-sidebar-item">

                                <strong>
                                    HSC / Diploma
                                </strong>

                                <span class="muted">

                                    @p.HSC_DIPLOMA_YEAR

                                    &middot;

                                    @GetLookupName(
                                        Model.Divisions,
                                        p.HSC_DIPLOMA_DIVISION
                                    )

                                </span>

                            </div>

                        }


                        @if (HasNum(p.SSC_YEAR))
                        {

                            <div class="resume-sidebar-item">

                                <strong>
                                    SSC / 10th
                                </strong>

                                <span class="muted">

                                    @p.SSC_YEAR

                                    &middot;

                                    @GetLookupName(
                                        Model.Divisions,
                                        p.SSC_DIVISION
                                    )

                                </span>

                            </div>

                        }

                    </div>

                }


                <!-- =================================================
                     LANGUAGES
                     ================================================= -->

                @{
                    var langItems =
                        new List<(string Lang, string Star)>();

                    for (int i = 1; i <= 8; i++)
                    {
                        var lang =
                            typeof(ErJobPortal.Models.CandidateProfileModel)
                                .GetProperty($"sLanguage{i}")
                                ?.GetValue(p)
                                ?.ToString();

                        var star =
                            typeof(ErJobPortal.Models.CandidateProfileModel)
                                .GetProperty($"sLanguageStar{i}")
                                ?.GetValue(p)
                                ?.ToString();

                        if (Has(lang))
                        {
                            langItems.Add((lang, star));
                        }
                    }
                }


                @if (langItems.Any())
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">
                            Languages
                        </div>


                        @foreach (var l in langItems)
                        {

                            <div class="resume-sidebar-item">

                                <span class="muted">
                                    @l.Lang
                                </span>

                                @if (Has(l.Star))
                                {
                                    <span>
                                        — @l.Star&#9733;
                                    </span>
                                }

                            </div>

                        }

                    </div>

                }


                <!-- =================================================
                     HOBBIES
                     ================================================= -->

                @if (Has(p.sHobbies))
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">
                            Hobbies
                        </div>

                        <div class="resume-sidebar-item muted">

                            @p.sHobbies

                        </div>

                    </div>

                }

            </div>


            <!-- =================================================
                 MAIN CONTENT
                 ================================================= -->

            <div class="resume-main">


                <!-- NAME -->

                <h1 class="resume-name">

                    @(string.IsNullOrWhiteSpace(Model.CandidateName)
                        ? "Candidate"
                        : Model.CandidateName)

                </h1>


                <!-- ROLE -->

                <div class="resume-role">

                    @GetLookupName(
                        Model.InternshipFellowshipType,
                        p.Internship_FellowshipType
                    )

                </div>


                <!-- =================================================
                     ABOUT ME
                     ================================================= -->

                @if (Has(p.Objective))
                {

                    <div class="resume-section">

                        <div class="resume-section-title">
                            About Me
                        </div>

                        <div class="resume-section-body">

                            <p>
                                @p.Objective
                            </p>

                        </div>

                    </div>

                }


                <!-- =================================================
                     INTERNSHIP EXPERIENCE
                     ================================================= -->

                @{
                    var internships =
                        new[]
                        {
                            new
                            {
                                Name = p.sOrgName1,
                                Title = p.sOrgIntTitle1,
                                Duration = p.sOrgIntDuration1,
                                Status = p.sOrgIntStatus1
                            },

                            new
                            {
                                Name = p.sOrgName2,
                                Title = p.sOrgIntTitle2,
                                Duration = p.sOrgIntDuration2,
                                Status = p.sOrgIntStatus2
                            },

                            new
                            {
                                Name = p.sOrgName3,
                                Title = p.sOrgIntTitle3,
                                Duration = p.sOrgIntDuration3,
                                Status = p.sOrgIntStatus3
                            },

                            new
                            {
                                Name = p.sOrgName4,
                                Title = p.sOrgIntTitle4,
                                Duration = p.sOrgIntDuration4,
                                Status = p.sOrgIntStatus4
                            }

                        }
                        .Where(x => Has(x.Name))
                        .ToList();
                }


                @if (internships.Any())
                {

                    <div class="resume-section">

                        <div class="resume-section-title">
                            Internship Experience
                        </div>


                        @foreach (var it in internships)
                        {

                            <div class="resume-entry">

                                <div class="resume-entry-title">

                                    @GetLookupName(
                                        Model.InternshipTitles,
                                        it.Title
                                    )

                                </div>


                                <div class="resume-entry-sub">

                                    @it.Name

                                </div>


                                <div class="resume-entry-meta">

                                    @GetLookupName(
                                        Model.InternshipDurations,
                                        it.Duration
                                    )


                                    @if (
                                        Has(
                                            GetLookupName(
                                                Model.InternshipStatuses,
                                                it.Status
                                            )
                                        )
                                    )
                                    {

                                        <span>

                                            &middot;

                                            @GetLookupName(
                                                Model.InternshipStatuses,
                                                it.Status
                                            )

                                        </span>

                                    }

                                </div>

                            </div>

                        }

                    </div>

                }


                <!-- =================================================
                     ACHIEVEMENTS
                     ================================================= -->

                @{
                    var achievements =
                        new[]
                        {
                            p.Achievements_Certification1,
                            p.Achievements_Certification2,
                            p.Achievements_Certification3
                        }
                        .Where(Has)
                        .ToList();
                }


                @if (achievements.Any())
                {

                    <div class="resume-section">

                        <div class="resume-section-title">

                            Achievements & Certifications

                        </div>


                        <div class="resume-section-body">

                            @foreach (var a in achievements)
                            {

                                <p>
                                    &bull; @a
                                </p>

                            }

                        </div>

                    </div>

                }


                <!-- =================================================
                     SKILLS
                     ================================================= -->

                @{
                    var skillGroups =
                        new[]
                        {
                            ("Technical", p.sTechnicalSkillIDs),
                            ("Medical", p.sMedicalSkillIDs),
                            ("Non-Technical", p.sNonTechnicalSkillIDs)
                        }
                        .Where(x => Has(x.Item2))
                        .ToList();
                }


                @if (skillGroups.Any())
                {

                    <div class="resume-section">

                        <div class="resume-section-title">
                            Skills
                        </div>


                        @foreach (var g in skillGroups)
                        {

                            <div class="resume-skill-row">

                                <div class="resume-skill-label">

                                    <span>
                                        @g.Item1
                                    </span>

                                </div>


                                <div class="resume-section-body">

                                    <p>
                                        @g.Item2
                                    </p>

                                </div>

                            </div>

                        }

                    </div>

                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                /* ============================================
                   THEME
                   ============================================ */

                const resumeSheet =
                    document.getElementById("resumeSheet");

                const swatches =
                    document.querySelectorAll(".theme-swatch");


                const savedTheme =
                    localStorage.getItem("resumeTheme");


                if (savedTheme) {

                    resumeSheet.setAttribute(
                        "data-theme",
                        savedTheme
                    );


                    swatches.forEach(function (swatch) {

                        swatch.classList.remove("active");


                        if (
                            swatch.dataset.theme ===
                            savedTheme
                        ) {

                            swatch.classList.add("active");

                        }

                    });

                }


                swatches.forEach(function (swatch) {

                    swatch.addEventListener(
                        "click",
                        function () {

                            const theme =
                                this.dataset.theme;


                            resumeSheet.setAttribute(
                                "data-theme",
                                theme
                            );


                            swatches.forEach(
                                function (item) {

                                    item.classList.remove(
                                        "active"
                                    );

                                }
                            );


                            this.classList.add("active");


                            localStorage.setItem(
                                "resumeTheme",
                                theme
                            );

                        }
                    );

                });

            }
        );

    </script>

</body>

</html>