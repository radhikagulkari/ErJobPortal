	/* =====================================================
   REFERENCE VALIDATION
   Reference 1 and Reference 2 must be different
===================================================== */

function normalizeReference(value) {

    return value
        .trim()
        .toLowerCase()
        .replace(/\s+/g, ' ');

}


function validateReferences() {

    const name1 =
        normalizeReference(
            document.getElementById('Reference1Name').value
        );

    const name2 =
        normalizeReference(
            document.getElementById('Reference2Name').value
        );

    const mobile1 =
        document.getElementById('Reference1Mobile').value
            .replace(/\D/g, '');

    const mobile2 =
        document.getElementById('Reference2Mobile').value
            .replace(/\D/g, '');

    const email1 =
        normalizeReference(
            document.getElementById('Reference1Email').value
        );

    const email2 =
        normalizeReference(
            document.getElementById('Reference2Email').value
        );

    const error =
        document.getElementById('referenceError');


    /*
       Consider references the same if:
       - Name is same
       - Mobile number is same
       - Email is same
    */

    const sameName =
        name1 !== '' &&
        name2 !== '' &&
        name1 === name2;

    const sameMobile =
        mobile1 !== '' &&
        mobile2 !== '' &&
        mobile1 === mobile2;

    const sameEmail =
        email1 !== '' &&
        email2 !== '' &&
        email1 === email2;


    if (sameName || sameMobile || sameEmail) {

        error.textContent =
            'Reference 1 and Reference 2 must be different persons. Please provide two different references.';

        error.style.display = 'block';

        return false;

    }


    error.textContent = '';

    error.style.display = 'none';

    return true;

}


</script>

