@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Edit Profile";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />

	<title>Edit Profile — 1Trainee</title>

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
		  rel="stylesheet">

	<style>

		/* =========================================================
						   ROOT
						========================================================= */

		:root {
			--navy: #152A4A;
			--navy-deep: #0E1E38;
			--teal: #0E8C82;
			--teal-dark: #0B786F;
			--teal-light: #E4F5F3;
			--teal-soft: #F1FBFA;
			--amber: #D98A2B;
			--bg: #F5F7FA;
			--card: #FFFFFF;
			--line: #E3E8EF;
			--text: #1F2937;
			--muted: #6B7686;
			--danger: #D64545;
			--success: #198754;
			--radius: 12px;
			--shadow: 0 1px 2px rgba(21,42,74,.04), 0 8px 24px -12px rgba(21,42,74,.12);
		}

		* {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
		}

		body {
			margin: 0;
			background: var(--bg);
			color: var(--text);
			font-family: 'Inter', system-ui, sans-serif;
			-webkit-font-smoothing: antialiased;
		}

		h1,
		h2,
		h3,
		h4,
		.brand {
			font-family: 'Sora', system-ui, sans-serif;
		}


		/* =========================================================
						   TOP BAR
						========================================================= */

		.topbar {
			background: var(--navy-deep);
			color: #fff;
			padding: 16px 32px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 20px;
		}

		.brand {
			display: flex;
			align-items: center;
			gap: 10px;
			font-weight: 700;
			font-size: 17px;
			letter-spacing: .2px;
		}

		.brand-mark {
			width: 34px;
			height: 34px;
			border-radius: 8px;
			background: linear-gradient( 135deg, var(--teal), #0BB8AB );
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 14px;
			font-weight: 700;
			color: #04211E;
		}

		.profile-chip {
			display: flex;
			align-items: center;
			gap: 10px;
			padding: 6px 12px;
			background: rgba(255,255,255,.06);
			border: 1px solid rgba(255,255,255,.12);
			border-radius: 999px;
			color: #C7D0E0;
			font-size: 12.5px;
		}

		.profile-mini {
			width: 28px;
			height: 28px;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--teal);
			color: white;
			font-size: 11px;
			font-weight: 700;
		}


		/* =========================================================
						   PAGE HEADER
						========================================================= */

		.page-header {
			background: linear-gradient( 180deg, var(--navy) 0%, var(--navy-deep) 100% );
			color: #fff;
			padding: 40px 32px 64px;
		}

		.page-header-inner {
			max-width: 1180px;
			margin: auto;
		}

		.eyebrow {
			text-transform: uppercase;
			font-size: 11.5px;
			letter-spacing: 1.6px;
			color: #8FE0D6;
			font-weight: 600;
			margin-bottom: 10px;
		}

		.page-header h1 {
			margin: 0 0 8px;
			font-size: 30px;
			font-weight: 700;
		}

		.page-header p {
			margin: 0;
			color: #B9C4D6;
			font-size: 14.5px;
			max-width: 650px;
			line-height: 1.6;
		}


		/* =========================================================
						   MAIN LAYOUT
						========================================================= */

		.layout {
			max-width: 1180px;
			margin: -40px auto 60px;
			padding: 0 32px;
			display: grid;
			grid-template-columns: 250px 1fr;
			gap: 28px;
			align-items: start;
		}


		/* =========================================================
						   SIDE NAVIGATION
						========================================================= */

		.side-nav {
			position: sticky;
			top: 24px;
			background: var(--card);
			border-radius: var(--radius);
			box-shadow: var(--shadow);
			padding: 10px;
			border: 1px solid var(--line);
		}

			.side-nav a {
				display: flex;
				align-items: center;
				gap: 10px;
				text-decoration: none;
				color: var(--muted);
				font-size: 13px;
				font-weight: 500;
				padding: 10px 12px;
				border-radius: 8px;
				transition: background .15s ease, color .15s ease;
			}

				.side-nav a:hover {
					background: var(--teal-light);
					color: var(--navy);
				}

				.side-nav a.active {
					background: var(--teal-light);
					color: var(--teal);
					font-weight: 600;
				}

		.nav-number {
			width: 23px;
			height: 23px;
			border-radius: 7px;
			background: #F0F2F5;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 10px;
			font-weight: 700;
			color: var(--muted);
		}

		.side-nav a.active .nav-number {
			background: var(--teal);
			color: white;
		}

		.side-note {
			margin-top: 14px;
			padding: 14px;
			background: #FBF6EC;
			border: 1px solid #F0E1BE;
			border-radius: 10px;
			font-size: 12px;
			color: #8A6416;
			line-height: 1.5;
		}


		/* =========================================================
						   FORM
						========================================================= */

		form {
			display: flex;
			flex-direction: column;
			gap: 22px;
		}

		.section {
			background: var(--card);
			border: 1px solid var(--line);
			border-radius: var(--radius);
			box-shadow: var(--shadow);
			padding: 26px 28px 28px;
			scroll-margin-top: 24px;
		}


		/* =========================================================
						   SECTION HEADER
						========================================================= */

		.section-head {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 22px;
		}

		.section-icon {
			width: 36px;
			height: 36px;
			border-radius: 9px;
			background: var(--teal-light);
			color: var(--teal);
			display: flex;
			align-items: center;
			justify-content: center;
			flex: none;
		}

		.section-head h2 {
			margin: 0;
			font-size: 16.5px;
			font-weight: 600;
			color: var(--navy);
		}

		.section-head .sub {
			margin: 3px 0 0;
			font-size: 12px;
			color: var(--muted);
			font-weight: 400;
		}


		/* =========================================================
						   GRID
						========================================================= */

		.grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 18px;
		}

		.span-2 {
			grid-column: span 2;
		}

		.span-3 {
			grid-column: span 3;
		}

		.span-4 {
			grid-column: span 4;
		}


		/* =========================================================
						   FIELD
						========================================================= */

		.field label {
			display: block;
			font-size: 13px;
			font-weight: 600;
			color: var(--text);
			margin-bottom: 7px;
		}

		.req {
			color: var(--danger);
			margin-left: 2px;
		}

		.field input,
		.field select,
		.field textarea {
			width: 100%;
			padding: 10px 12px;
			font-size: 13px;
			font-family: 'Inter', sans-serif;
			color: var(--text);
			background: #fff;
			border: 1.5px solid var(--line);
			border-radius: 8px;
			outline: none;
			transition: border-color .15s ease, box-shadow .15s ease;
		}

		.field textarea {
			resize: vertical;
			min-height: 100px;
			line-height: 1.5;
		}

		.field select {
			appearance: none;
			background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6'><path d='M0 0l5 6 5-6z' fill='%236B7686'/></svg>");
			background-repeat: no-repeat;
			background-position: right 12px center;
			padding-right: 30px;
		}

			.field input:focus,
			.field select:focus,
			.field textarea:focus {
				border-color: var(--teal);
				box-shadow: 0 0 0 3px rgba(14,140,130,.13);
			}

			.field input:disabled,
			.field select:disabled {
				background: #F2F4F7;
				color: var(--muted);
				cursor: not-allowed;
			}

		.hint {
			display: block;
			font-size: 11px;
			color: var(--muted);
			margin-top: 6px;
		}


		/* =========================================================
						   PROFILE PHOTO
						========================================================= */

		.photo-box {
			display: flex;
			align-items: center;
			gap: 18px;
			padding: 16px;
			background: var(--teal-soft);
			border: 1px solid #D7EEEA;
			border-radius: 10px;
		}

		.profile-photo {
			width: 76px;
			height: 76px;
			border-radius: 50%;
			background: linear-gradient( 135deg, var(--teal), #0BB8AB );
			display: flex;
			align-items: center;
			justify-content: center;
			color: white;
			font-size: 22px;
			font-weight: 700;
			flex: none;
			overflow: hidden;
		}

			.profile-photo img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

		.photo-info strong {
			display: block;
			font-size: 13px;
			color: var(--navy);
			margin-bottom: 5px;
		}

		.photo-info span {
			display: block;
			font-size: 11.5px;
			color: var(--muted);
			margin-bottom: 9px;
		}

		.upload-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 7px 12px;
			border-radius: 7px;
			border: 1px solid var(--teal);
			background: white;
			color: var(--teal);
			font-size: 11.5px;
			font-weight: 600;
			cursor: pointer;
		}

			.upload-btn:hover {
				background: var(--teal-light);
			}


		/* =========================================================
						   ACCORDION / CHECKBOX
						========================================================= */

		.acc {
			border: 1.5px solid var(--line);
			border-radius: 10px;
			overflow: hidden;
		}

			.acc + .acc {
				margin-top: 12px;
			}

			.acc summary {
				list-style: none;
				cursor: pointer;
				padding: 13px 16px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 13px;
				font-weight: 600;
				color: var(--navy);
				background: #FAFBFC;
			}

				.acc summary::-webkit-details-marker {
					display: none;
				}

				.acc summary:after {
					content: '▾';
					color: var(--muted);
					transition: transform .15s ease;
				}

			.acc[open] summary:after {
				transform: rotate(180deg);
			}

		.acc-body {
			padding: 16px;
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 10px;
			border-top: 1px solid var(--line);
		}

		.chk {
			display: flex;
			align-items: center;
			gap: 9px;
			background: #fff;
			border: 1.5px solid var(--line);
			border-radius: 8px;
			padding: 10px 12px;
			font-size: 12.5px;
			font-weight: 500;
			color: var(--text);
			cursor: pointer;
			transition: border-color .15s ease, background .15s ease;
		}

			.chk:hover {
				border-color: var(--teal);
				background: var(--teal-soft);
			}

			.chk input {
				width: 16px;
				height: 16px;
				accent-color: var(--teal);
				flex: none;
			}

		.count {
			font-size: 10.5px;
			font-weight: 600;
			color: var(--teal);
			background: var(--teal-light);
			padding: 3px 8px;
			border-radius: 999px;
			margin-left: auto;
			margin-right: 10px;
		}


		/* =========================================================
						   INLINE OPTIONS
						========================================================= */

		.radio-group {
			display: flex;
			gap: 10px;
			flex-wrap: wrap;
		}

		.radio-option {
			position: relative;
			flex: 1;
			min-width: 100px;
		}

			.radio-option input {
				position: absolute;
				opacity: 0;
			}

			.radio-option label {
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 10px 12px;
				border: 1.5px solid var(--line);
				border-radius: 8px;
				font-size: 12px;
				font-weight: 600;
				cursor: pointer;
				background: white;
				color: var(--muted);
			}

			.radio-option input:checked + label {
				border-color: var(--teal);
				background: var(--teal-light);
				color: var(--teal);
			}


		/* =========================================================
						   EDUCATION / INTERNSHIP CARDS
						========================================================= */

		.repeat-card {
			border: 1px solid var(--line);
			border-radius: 10px;
			padding: 18px;
			background: #FCFDFE;
			margin-bottom: 14px;
		}

		.repeat-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 16px;
		}

		.repeat-title {
			font-size: 13px;
			font-weight: 700;
			color: var(--navy);
		}

		.repeat-number {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 24px;
			height: 24px;
			border-radius: 7px;
			background: var(--teal-light);
			color: var(--teal);
			margin-right: 8px;
			font-size: 10px;
		}


		/* =========================================================
						   REMOVE BUTTON
						========================================================= */

		.remove-btn {
			border: 1px solid #F0CACA;
			background: #FFF7F7;
			color: var(--danger);
			border-radius: 7px;
			padding: 6px 10px;
			font-size: 11px;
			cursor: pointer;
		}

			.remove-btn:hover {
				background: #FDECEC;
			}


		/* =========================================================
						   ADD BUTTON
						========================================================= */

		.add-btn {
			border: 1.5px dashed var(--teal);
			background: var(--teal-soft);
			color: var(--teal);
			border-radius: 8px;
			padding: 10px 14px;
			font-size: 12px;
			font-weight: 600;
			cursor: pointer;
			    width: 30%; 
    margin: 0 auto;
    display: block;
		}

			.add-btn:hover {
				background: var(--teal-light);
			}


		/* =========================================================
						   PROFILE COMPLETION
						========================================================= */

		.completion-box {
			padding: 15px 16px;
			border-radius: 10px;
			background: var(--teal-soft);
			border: 1px solid #D8EEEA;
			margin-bottom: 20px;
		}

		.completion-top {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 9px;
		}

			.completion-top strong {
				font-size: 12px;
				color: var(--navy);
			}

		.completion-percent {
			font-size: 12px;
			font-weight: 700;
			color: var(--teal);
		}

		.progress {
			height: 7px;
			background: #DDEBE9;
			border-radius: 999px;
			overflow: hidden;
		}

		.progress-bar {
			height: 100%;
			width: 70%;
			background: var(--teal);
			border-radius: 999px;
			transition: width .3s ease;
		}


		/* =========================================================
						   SUBMIT BAR
						========================================================= */

		.submit-bar {
			position: sticky;
			bottom: 0;
			background: var(--card);
			border: 1px solid var(--line);
			border-radius: var(--radius);
			box-shadow: 0 -5px 25px rgba(21,42,74,.08);
			padding: 16px 20px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
			flex-wrap: wrap;
			z-index: 10;
		}

			.submit-bar p {
				margin: 0;
				font-size: 11.5px;
				color: var(--muted);
				max-width: 450px;
				line-height: 1.5;
			}

		.btn-row {
			display: flex;
			gap: 10px;
		}

		.btn {
			border: none;
			border-radius: 8px;
			padding: 10px 18px;
			font-size: 12.5px;
			font-weight: 600;
			font-family: 'Inter', sans-serif;
			cursor: pointer;
			transition: transform .1s ease, background .15s ease;
		}

			.btn:active {
				transform: translateY(1px);
			}

		.btn-primary {
			background: var(--teal);
			color: white;
		}

			.btn-primary:hover {
				background: var(--teal-dark);
			}

		.btn-secondary {
			background: transparent;
			color: var(--navy);
			border: 1.5px solid var(--line);
		}

			.btn-secondary:hover {
				border-color: var(--navy);
			}


		/* =========================================================
						   FOOTER
						========================================================= */

		footer {
			text-align: center;
			padding: 26px 20px 40px;
			font-size: 11.5px;
			color: var(--muted);
		}

			footer a {
				color: var(--teal);
				text-decoration: none;
				font-weight: 600;
			}


		/* =========================================================
						   RESPONSIVE
						========================================================= */

		@@media (max-width: 1000px) {
			.layout {
				grid-template-columns: 1fr;
			}

			.side-nav {
				position: static;
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 5px;
			}

			.side-note {
				grid-column: 1 / -1;
			}

			.grid {
				grid-template-columns: repeat(2, 1fr);
			}

			.span-3,
			.span-4 {
				grid-column: span 2;
			}

			.acc-body {
				grid-template-columns: repeat(2, 1fr);
			}
		}


		@@media (max-width: 700px) {
			.topbar {
				padding: 12px 16px;
			}

			.profile-chip {
				display: none;
			}

			.page-header {
				padding: 30px 18px 55px;
			}

				.page-header h1 {
					font-size: 24px;
				}

			.layout {
				margin-top: -30px;
				padding: 0 14px;
			}

			.side-nav {
				display: flex;
				overflow-x: auto;
				flex-wrap: nowrap;
				padding: 7px;
			}

				.side-nav a {
					white-space: nowrap;
				}

			.side-note {
				display: none;
			}

			.section {
				padding: 20px 16px;
			}

			.grid {
				grid-template-columns: 1fr;
			}

			.span-2,
			.span-3,
			.span-4 {
				grid-column: span 1;
			}

			.acc-body {
				grid-template-columns: 1fr;
			}

			.photo-box {
				align-items: flex-start;
			}

			.submit-bar {
				position: static;
			}

			.submit-bar,
			.btn-row {
				width: 100%;
			}

				.btn-row .btn {
					flex: 1;
				}
		}

		/* =====================================================
   RESUME PROFILE PREVIEW
===================================================== */

.profile-preview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    padding: 18px;
}


/* PROFILE CARD */

.resume-profile-card {
    display: block;
    cursor: pointer;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    padding: 12px;
    transition: .2s ease;
}


/* TITLE */

.resume-profile-title {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
    font-size: 13px;
    font-weight: 600;
}

.resume-profile-title input {
    width: 16px;
    height: 16px;
    accent-color: var(--teal);
}


/* PREVIEW */

.resume-preview {
    width: 100%;
    aspect-ratio: 0.72;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
}

.resume-preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
}


/* SELECTED PROFILE */

.resume-profile-card:has(
    input[type="radio"]:checked
) {
    border-color: var(--teal);
    box-shadow: 0 0 0 2px rgba(0, 128, 128, .12);
}


/* RESPONSIVE */

@@media (max-width: 1100px) {

    .profile-preview-grid {
        grid-template-columns: repeat(3, 1fr);
    }

}

@@media (max-width: 800px) {

    .profile-preview-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@@media (max-width: 500px) {

    .profile-preview-grid {
        grid-template-columns: 1fr;
    }

}

	</style>
</head>

