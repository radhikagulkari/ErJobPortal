    @@media print {

        body * {
            visibility: hidden;
        }

        .resume-sheet,
        .resume-sheet * {
            visibility: visible;
        }

        body {
            margin: 0;
            padding: 0;
            background: #fff;
        }

        .resume-page-wrapper {
            padding: 0;
            margin: 0;
            background: #fff;
        }

        .resume-sheet {
            width: 210mm;
            min-height: 297mm;
            height: auto;
            margin: 0;
            box-shadow: none;
            display: flex;
            align-items: stretch;
            position: relative;
        }

        .resume-toolbar,
        .resume-empty-hint {
            display: none !important;
        }

        .resume-section,
        .resume-entry,
        .resume-sidebar-section {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        @@page {
            size: A4;
            margin: 0;
        }
    }

</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="resume-toolbar">
    <a asp-action="Profile" asp-controller="Candidate" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-pen"></i> Edit Profile
    </a>
    <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
        <i class="fa fa-print"></i> Print / Save as PDF
    </button>
</div>

<div class="resume-page-wrapper">
    <div class="resume-sheet">

        <!-- ================= SIDEBAR ================= -->
        <div class="resume-sidebar">

            <div class="resume-photo-wrap">
                @if (Has(p.sPhoto))
                {
                    <img src="@p.sPhoto" class="resume-photo" alt="Photo" />
                }
                else
                {
                    <div class="resume-photo-placeholder">
                        <i class="fa fa-user"></i>
                    </div>
                }
            </div>

            @* -------- ADDRESS -------- *@
            @if (Has(p.CountryID) || Has(p.Pincode))
            {
                <div class="resume-sidebar-section">
                    <div class="resume-sidebar-title">Address</div>
                    <div class="resume-sidebar-item">
                        <i class="fa fa-map-marker resume-accent"></i>
                        <span class="muted" id="rvAddress">Loading...</span>
                    </div>
                </div>
            }

            @* -------- CONTACT -------- *@
            @if (Has(ViewBag.CandidateEmail as string))
            {
                <div class="resume-sidebar-section">
                    <div class="resume-sidebar-title">Contact Me</div>
                    <div class="resume-sidebar-item">
                        <i class="fa fa-envelope resume-accent"></i>
                        <span class="muted">@ViewBag.CandidateEmail</span>
                    </div>
                </div>
            }

            @* -------- INTERNSHIP PREFERENCE -------- *@
            @if (Has(p.Preferred_City) || Has(p.Preferred_State) || Has(p.Preferred_Country))
            {
                <div class="resume-sidebar-section">
                    <div class="resume-sidebar-title">Preferred Location</div>
                    <div class="resume-sidebar-item">
                        <i class="fa fa-location-arrow resume-accent"></i>
                        <span class="muted">
                            @string.Join(", ", new[] { p.Preferred_City, p.Preferred_State, p.Preferred_Country }.Where(Has))
                        </span>
                    </div>
                </div>
            }

            @* -------- SOCIAL LINKS -------- *@
            @if (Has(p.GitHub) || Has(p.Linkedin))
            {
                <div class="resume-sidebar-section">
                    <div class="resume-sidebar-title">Links</div>

                    @if (Has(p.GitHub))
                    {
                        <div class="resume-sidebar-item">
                            <i class="fa fa-github resume-accent"></i>
                            <span class="muted">@p.GitHub</span>
                        </div>
                    }

                    @if (Has(p.Linkedin))
                    {
                        <div class="resume-sidebar-item">
                            <i class="fa fa-linkedin resume-accent"></i>
                            <span class="muted">@p.Linkedin</span>
                        </div>
                    }
                </div>
            }

            @* -------- REFERENCES -------- *@
            @if (Has(p.sRefName1) || Has(p.sRefName2))
            {
                <div class="resume-sidebar-section">
                    <div class="resume-sidebar-title">References</div>

                    @if (Has(p.sRefName1))
                    {
                        <div class="resume-sidebar-item">
                            <strong>@p.sRefName1</strong>
                            <span class="muted">@GetLookupName(Model.Relationships, p.sRefRelationName1)</span><br />
                            @if (Has(p.sLocation1))
                            {
                                <span class="muted">@p.sLocation1</span>
                                <br />
         }
                            @if (Has(p.sMobile1))
                            {
                                <span class="muted">Tel: @p.sMobile1</span>
                            }
                        </div>
                    }

                    @if (Has(p.sRefName2))
                    {
                        <div class="resume-sidebar-item">
                            <strong>@p.sRefName2</strong>
                            <span class="muted">@GetLookupName(Model.Relationships, p.sRefRelationName2)</span><br />
                            @if (Has(p.sLocation2))
                            {
                                <span class="muted">@p.sLocation2</span>
                                <br />
         }
                            @if (Has(p.sMobile2))
                            {
                                <span class="muted">Tel: @p.sMobile2</span>
                            }
                        </div>
                    }
                </div>
            }

            @* -------- EDUCATION -------- *@
            @if (HasNum(p.Graduation_Year) || HasNum(p.PG_Year) || HasNum(p.HSC_DIPLOMA_YEAR) || HasNum(p.SSC_YEAR))
            {
                <div class="resume-sidebar-section">
                    <div class="resume-sidebar-title">Education</div>

                    @if (HasNum(p.PG_Year))
                    {
                        <div class="resume-sidebar-item">
                            <strong>@GetLookupName(Model.Streams, p.PG_Stream) — Post Graduation</strong>
                            <span class="muted">@p.PG_Year &middot; @GetLookupName(Model.Divisions, p.PG_Division)</span>
                        </div>
                    }

                    @if (HasNum(p.Graduation_Year))
                    {
                        <div class="resume-sidebar-item">
                            <strong>@GetLookupName(Model.Streams, p.Graduation_Stream) — Graduation</strong>
                            <span class="muted">@p.Graduation_Year &middot; @GetLookupName(Model.Divisions, p.Graduation_Division)</span>
                        </div>
                    }

                    @if (HasNum(p.HSC_DIPLOMA_YEAR))
                    {
                        <div class="resume-sidebar-item">
                            <strong>HSC / Diploma</strong>
                            <span class="muted">@p.HSC_DIPLOMA_YEAR &middot; @GetLookupName(Model.Divisions, p.HSC_DIPLOMA_DIVISION)</span>
                        </div>
                    }

                    @if (HasNum(p.SSC_YEAR))
                    {
                        <div class="resume-sidebar-item">
                            <strong>SSC / 10th</strong>
                            <span class="muted">@p.SSC_YEAR &middot; @GetLookupName(Model.Divisions, p.SSC_DIVISION)</span>
                        </div>
                    }
                </div>
            }

            @* -------- LANGUAGES -------- *@
            @{
                var langItems = new List<(string Lang, string Star)>();
                for (int i = 1; i <= 8; i++)
                {
                    var lang = typeof(ErJobPortal.Models.CandidateProfileModel)
                    .GetProperty($"sLanguage{i}")?.GetValue(p)?.ToString();
                    var star = typeof(ErJobPortal.Models.CandidateProfileModel)
                    .GetProperty($"sLanguageStar{i}")?.GetValue(p)?.ToString();

                    if (Has(lang)) langItems.Add((lang, star));
                }
            }
            @if (langItems.Any())
            {
                <div class="resume-sidebar-section">
                    <div class="resume-sidebar-title">Languages</div>
                    @foreach (var l in langItems)
                    {
                        <div class="resume-sidebar-item">
                            <span class="muted">@l.Lang</span>
                            @if (Has(l.Star))
                            {
                                <span> — @l.Star&#9733;</span>
                            }
                        </div>
                    }
                </div>
            }

            @* -------- DIVYANG -------- *@
@if (Has(p.sDivyang))
{
    <div class="resume-sidebar-section">
        <div class="resume-sidebar-title">Divyang</div>

        <div class="resume-sidebar-item">
            <i class="fa fa-wheelchair resume-accent"></i>
            <span class="muted">@p.sDivyang</span>
        </div>
    </div>
}


@* -------- HOBBIES -------- *@
@if (Has(p.sHobbies))
{
    <div class="resume-sidebar-section">
        <div class="resume-sidebar-title">Hobbies</div>
        <div class="resume-sidebar-item muted">@p.sHobbies</div>
    </div>
}

        </div>

        <!-- ================= MAIN CONTENT ================= -->
        <div class="resume-main">

            <h1 class="resume-name">@(ViewBag.CandidateName ?? "Candidate")</h1>
            <div class="resume-role">
                @GetLookupName(Model.InternshipFellowshipType, p.Internship_FellowshipType)
            </div>

            @* -------- ABOUT ME / OBJECTIVE -------- *@
            @if (Has(p.Objective))
            {
                <div class="resume-section">
                    <div class="resume-section-title">About Me</div>
                    <div class="resume-section-body">
                        <p>@p.Objective</p>
                    </div>
                </div>
            }

            @* -------- INTERNSHIP EXPERIENCE -------- *@
            @{
                var internships = new[]
                {
                        new { Name = p.sOrgName1, Title = p.sOrgIntTitle1, Duration = p.sOrgIntDuration1, Status = p.sOrgIntStatus1 },
                        new { Name = p.sOrgName2, Title = p.sOrgIntTitle2, Duration = p.sOrgIntDuration2, Status = p.sOrgIntStatus2 },
                        new { Name = p.sOrgName3, Title = p.sOrgIntTitle3, Duration = p.sOrgIntDuration3, Status = p.sOrgIntStatus3 },
                        new { Name = p.sOrgName4, Title = p.sOrgIntTitle4, Duration = p.sOrgIntDuration4, Status = p.sOrgIntStatus4 },
                        }.Where(x => Has(x.Name)).ToList();
            }
            @if (internships.Any())
            {
                <div class="resume-section">
                    <div class="resume-section-title">Internship Experience</div>
                    @foreach (var it in internships)
                    {
                        <div class="resume-entry">
                            <div class="resume-entry-title">@GetLookupName(Model.InternshipTitles, it.Title)</div>
                            <div class="resume-entry-sub">@it.Name</div>
                            <div class="resume-entry-meta">
                                @GetLookupName(Model.InternshipDurations, it.Duration)
                                @if (Has(GetLookupName(Model.InternshipStatuses, it.Status)))
                                {
                                    <span> &middot; @GetLookupName(Model.InternshipStatuses, it.Status)</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @* -------- ACHIEVEMENTS -------- *@
            @{
                var achievements = new[] { p.Achievements_Certification1, p.Achievements_Certification2, p.Achievements_Certification3 }
                .Where(Has).ToList();
            }
            @if (achievements.Any())
            {
                <div class="resume-section">
                    <div class="resume-section-title">Achievements &amp; Certifications</div>
                    <div class="resume-section-body">
                        @foreach (var a in achievements)
                        {
                            <p style="margin-bottom:6px;">&bull; @a</p>
                        }
                    </div>
                </div>
            }

            @* -------- SKILLS -------- *@
            @{
                var skillGroups = new[]
                {
                        ("Technical", p.sTechnicalSkillIDs),
                        ("Medical", p.sMedicalSkillIDs),
                        ("Non-Technical", p.sNonTechnicalSkillIDs)
                        }.Where(x => Has(x.Item2)).ToList();
            }
            @if (skillGroups.Any())
            {
                <div class="resume-section">
                    <div class="resume-section-title">Skills</div>
                    @foreach (var g in skillGroups)
                    {
                        <div class="resume-skill-row">
                            <div class="resume-skill-label"><span>@g.Item1</span></div>
                            <div class="resume-section-body"><p>@g.Item2</p></div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>