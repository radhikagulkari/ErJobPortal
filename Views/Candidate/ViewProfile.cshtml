@model ErJobPortal.Models.CandidateProfileViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "My Resume";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
    var p = Model.Profile;
}

@functions {
    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();
                if (idValue == id.ToString())
                    return nameProp.GetValue(item)?.ToString() ?? "";
            }
        }
        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);
    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

@section Scripts {
    <script>
        // Force reload if this tab is restored from bfcache
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                window.location.reload();
            }
        });

        // Resolve CountryID / StateID / CityID into readable names
        $(document).ready(function () {

            var countryID = '@Html.Raw(p.CountryID)';
            var stateID = '@Html.Raw(p.StateID)';
            var cityID = '@Html.Raw(p.CityID)';
            var pincode = '@Html.Raw(p.Pincode)';

            console.log('Address resolve start:', countryID, stateID, cityID, pincode);

            if (!countryID) {
                $('#rvAddress').text(pincode || '-');
                return;
            }

            $.ajax({
                url: '/Location/GetCountries',
                type: 'GET',
                success: function (countries) {
                    console.log('Countries loaded:', countries.length);

                    var country = countries.find(function (c) { return c.id == countryID; });

                    if (!country) {
                        console.warn('Country not matched for id:', countryID);
                        $('#rvAddress').text(pincode || '-');
                        return;
                    }

                    if (!stateID) {
                        var parts = [country.name];
                        if (pincode) parts.push(pincode);
                        $('#rvAddress').text(parts.join(', '));
                        return;
                    }

                    $.ajax({
                        url: '/Location/GetStates',
                        type: 'GET',
                        data: { countryCode: country.iso2 },
                        success: function (states) {
                            console.log('States loaded:', states.length);

                            var state = states.find(function (s) { return s.id == stateID; });

                            if (!state) {
                                console.warn('State not matched for id:', stateID);
                                var parts = [country.name];
                                if (pincode) parts.push(pincode);
                                $('#rvAddress').text(parts.join(', '));
                                return;
                            }

                            var stateCode = state.stateCode;
                            if (!stateCode && state.id) {
                                var sp = state.id.split(':');
                                stateCode = sp.length > 1 ? sp[1] : state.id;
                            }

                            if (!cityID || !stateCode) {
                                var parts = [state.name, country.name];
                                if (pincode) parts.push(pincode);
                                $('#rvAddress').text(parts.join(', '));
                                return;
                            }

                            $.ajax({
                                url: '/Location/GetCities',
                                type: 'GET',
                                data: { countryCode: country.iso2, stateCode: stateCode },
                                success: function (cities) {
                                    console.log('Cities loaded:', cities.length);

                                    var city = cities.find(function (c) { return c.id == cityID; });

                                    var parts = [];
                                    if (city) parts.push(city.name);
                                    parts.push(state.name);
                                    parts.push(country.name);
                                    if (pincode) parts.push(pincode);

                                    $('#rvAddress').text(parts.join(', '));
                                },
                                error: function (xhr) {
                                    console.error('GetCities failed:', xhr.responseText);
                                    $('#rvAddress').text(state.name + ', ' + country.name + (pincode ? ', ' + pincode : ''));
                                }
                            });
                        },
                        error: function (xhr) {
                            console.error('GetStates failed:', xhr.responseText);
                            $('#rvAddress').text(country.name + (pincode ? ', ' + pincode : ''));
                        }
                    });
                },
                error: function (xhr) {
                    console.error('GetCountries failed:', xhr.responseText);
                    $('#rvAddress').text(pincode || '-');
                }
            });
        });
    </script>
}

