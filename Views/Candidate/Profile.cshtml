    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                Internship / Fellowship Preference
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="UpdateInternshipPreference"
                  asp-controller="Candidate"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Internship / Fellowship Type
                        </label>

                        <select asp-for="Profile.Internship_FellowshipType"
                                class="form-control"
                                asp-items="@(new SelectList(
                                                                                         Model.InternshipFellowshipType,
                                                                                         "ID",
                                                                                         "Name"
                                                                                     ))">

                            <option value="">
                                -- Select Type --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.Internship_FellowshipType"
                              class="text-danger"></span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Preferred Country
                        </label>

                        <input asp-for="Profile.Preferred_Country"
                               class="form-control" />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Preferred State
                        </label>

                        <input asp-for="Profile.Preferred_State"
                               class="form-control" />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Preferred City
                        </label>

                        <input asp-for="Profile.Preferred_City"
                               class="form-control" />

                    </div>

                </div>


                <div class="text-end">

                    <button type="submit"
                            class="btn btn-primary">

                        Update Preference

                    </button>

                </div>

            </form>

        </div>

    </div>
    <!-- ================================================= -->
    <!-- DOCUMENTS -->
    <!-- ================================================= -->

    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                Documents & Personal Details
            </h5>
        </div>

        <div class="card-body">

            <form asp-controller="Candidate"
                  asp-action="UpdateDocuments"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="row">

                    <!-- Resume -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Resume</label>

                        <input type="file"
                               name="ResumeFile"
                               class="form-control"
                               accept=".pdf,.doc,.docx" />

                        @if (!string.IsNullOrEmpty(Model.Profile?.sResume))
                        {
                            <small class="text-success d-block mt-2">
                                ✓ Resume already uploaded
                            </small>

                            <a href="@Model.Profile.sResume"
                               target="_blank"
                               class="btn btn-sm btn-outline-primary mt-1">
                                View Resume
                            </a>
                        }
                    </div>

                    <!-- Photo -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Photo</label>

                        <input type="file"
                               name="PhotoFile"
                               class="form-control"
                               accept=".jpg,.jpeg,.png" />

                        @if (!string.IsNullOrEmpty(Model.Profile?.sPhoto))
                        {
                            <small class="text-success d-block mt-2">
                                ✓ Photo already uploaded
                            </small>

                            <img src="@Model.Profile.sPhoto"
                                 alt="Photo"
                                 class="mt-1"
                                 style="width:80px;height:80px;object-fit:cover;" />
                        }
                    </div>

                    <!-- Signature -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Signature</label>

                        <input type="file"
                               name="SignatureFile"
                               class="form-control"
                               accept=".jpg,.jpeg,.png" />

                        @if (!string.IsNullOrEmpty(Model.Profile?.sSignature))
                        {
                            <small class="text-success d-block mt-2">
                                ✓ Signature already uploaded
                            </small>

                            <br />

                            <img src="@Model.Profile.sSignature"
                                 alt="Signature"
                                 class="mt-1"
                                 style="width:150px;
                              height:60px;
                              object-fit:contain;
                              border:1px solid #ddd;" />
                        }
                    </div>

                    <!-- Divyang -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Profile.sDivyang"
                               class="form-label">
                            Divyang
                        </label>

                        <select asp-for="Profile.sDivyang"
                                class="form-select">

                            <option value="">-- Select --</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>

                    <!-- Hobbies -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Profile.sHobbies"
                               class="form-label">
                            Hobbies
                        </label>

                        <input asp-for="Profile.sHobbies"
                               class="form-control"
                               placeholder="Enter your hobbies" />

                    </div>

                </div>

                <div class="text-end mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Update Personal Details
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- INTERNSHIP DETAILS -->
    <!-- ================================================= -->
    <!-- =========================================================
     INTERNSHIP DETAILS
     ========================================================= -->

    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                Internship Details
            </h5>
        </div>

        <div class="card-body">

            <form asp-controller="Candidate"
                  asp-action="UpdateInternshipDetails"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Profile.CandidateID" />


                <!-- =====================================================
                 INTERNSHIP 1
                 ===================================================== -->

                <h6 class="mt-2 mb-3">
                    Internship 1
                </h6>

                <div class="row">

                    <!-- Organization -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.sOrgName1"
                               class="form-label">
                            Organization Name
                        </label>

                        <input asp-for="Profile.sOrgName1"
                               class="form-control"
                               placeholder="Organization Name" />

                    </div>


                    <!-- Title -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.sOrgIntTitle1"
                               class="form-label">
                            Internship Title
                        </label>

                        <select asp-for="Profile.sOrgIntTitle1"
                                class="form-select"
                                asp-items="@(new SelectList(Model.InternshipTitles, "ID", "Name"))">

                            <option value="">
                                -- Select Title --
                            </option>

                        </select>

                    </div>


                    <!-- Duration -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.sOrgIntDuration1"
                               class="form-label">
                            Duration
                        </label>

                        <select asp-for="Profile.sOrgIntDuration1"
                                class="form-select"
                                asp-items="@(new SelectList(Model.InternshipDurations, "ID", "Name"))">

                            <option value="">
                                -- Select Duration --
                            </option>

