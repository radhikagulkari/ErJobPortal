@section Scripts {
    <script>

        $('#addressForm').on('submit', function () {

            $('#StateID').prop('disabled', false);

            $('#CityID').prop('disabled', false);

        });

    </script>
    <script>

        $(document).ready(function () {

            var selectedCountryID = '@Model.Profile.CountryID';
            var selectedStateID = '@Model.Profile.StateID';
            var selectedCityID = '@Model.Profile.CityID';


            // ============================================
            // IMPORTANT:
            // Disabled select values are not submitted.
            // Enable them before Address form submit.
            // ============================================

            $('form[action*="UpdateAddress"]').submit(function () {

                $('#StateID').prop('disabled', false);
                $('#CityID').prop('disabled', false);

            });


            $('#addressForm').on('submit', function () {

                console.log("CountryID:", $('#CountryID').val());
                console.log("StateID:", $('#StateID').val());
                console.log("CityID:", $('#CityID').val());
                console.log("Pincode:", $('#Profile_Pincode').val());

                // Disabled controls are NOT submitted.
                $('#StateID').prop('disabled', false);

                $('#CityID').prop('disabled', false);

            });
            // ============================================
            // LOAD COUNTRIES
            // ============================================

            function loadCountries() {

                $.ajax({

                    url: '/Location/GetCountries',

                    type: 'GET',

                    success: function (data) {

                        $('#CountryID').empty();

                        $('#CountryID').append(
                            '<option value="">-- Select Country --</option>'
                        );


                        $.each(data, function (index, item) {

                            $('#CountryID').append(

                                $('<option>', {

                                    value: item.id,
                                    text: item.name

                                }).attr(
                                    'data-code',
                                    item.iso2
                                )

                            );

                        });


                        if (selectedCountryID !== '') {

                            $('#CountryID')
                                .val(selectedCountryID)
                                .trigger('change');

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "Country Error:",
                            xhr.responseText
                        );

                    }

                });

            }


            // ============================================
            // COUNTRY CHANGE
            // ============================================

            $('#CountryID').change(function () {

                var countryID = $(this).val();

                var countryCode =
                    $('#CountryID option:selected')
                        .attr('data-code');


                $('#StateID').empty();

                $('#StateID').append(
                    '<option value="">-- Select State --</option>'
                );


                $('#CityID').empty();

                $('#CityID').append(
                    '<option value="">-- Select City --</option>'
                );

                $('#CityID').prop('disabled', true);


                if (!countryID || !countryCode) {

                    $('#StateID').prop('disabled', true);

                    return;

                }


                $('#StateID').prop('disabled', false);


                $.ajax({

                    url: '/Location/GetStates',

                    type: 'GET',

                    data: {

                        countryCode: countryCode

                    },

                    success: function (data) {

                        $('#StateID').empty();

                        $('#StateID').append(
                            '<option value="">-- Select State --</option>'
                        );

                                $.each(data, function (index, item) {

            var stateCode = item.stateCode;

            if (!stateCode && item.id) {

                var parts = item.id.split(':');

                stateCode =
                    parts.length > 1
                        ? parts[1]
                        : item.id;
            }

            $('#StateID').append(

                $('<option>', {

                    value: item.id,
                    text: item.name

                }).attr(
                    'data-code',
                    stateCode
                )

            );

        });

                        // $.each(data, function (index, item) {

                        //     var stateCode = item.stateCode;

                        //     if (!stateCode && item.id) {

                        //         var parts =
                        //             item.id.split(':');

                        //         stateCode =
                        //             parts.length > 1
                        //                 ? parts[1]
                        //                 : item.id;

                        //     }


                        //     $('#StateID').append(

                        //         $('<option>', {

                        //             value: item.id,
                        //             text: item.name

                        //         }).attr(
                        //             'data-code',
                        //             stateCode
                        //         )

                        //     );

                        // });


                        if (selectedStateID !== '') {

                            $('#StateID')
                                .val(selectedStateID)
                                .trigger('change');

                            selectedStateID = '';

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "State Error:",
                            xhr.responseText
                        );

                    }

                });

            });


            // ============================================
            // STATE CHANGE
            // ============================================

            $('#StateID').change(function () {

                var stateID = $(this).val();

                var stateCode =
                    $('#StateID option:selected')
                        .attr('data-code');

                var countryCode =
                    $('#CountryID option:selected')
                        .attr('data-code');


                $('#CityID').empty();

                $('#CityID').append(
                    '<option value="">-- Select City --</option>'
                );


                if (!stateID ||
                    !stateCode ||
                    !countryCode) {

                    $('#CityID').prop(
                        'disabled',
                        true
                    );

                    return;

                }


                $('#CityID').prop(
                    'disabled',
                    false
                );


                $.ajax({

                    url: '/Location/GetCities',

                    type: 'GET',

                    data: {

                        countryCode: countryCode,
                        stateCode: stateCode

                    },

                    success: function (data) {

                        $('#CityID').empty();

                        $('#CityID').append(
                            '<option value="">-- Select City --</option>'
                        );


                        $.each(data, function (index, item) {

                            $('#CityID').append(

                                $('<option>', {

                                    value: item.id,
                                    text: item.name

                                })

                            );

                        });


                        if (selectedCityID) {

                            $('#CityID')
                                .val(selectedCityID);

                            selectedCityID = '';

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "City Error:",
                            xhr.responseText
                        );

                    }

                });

            });


            // ============================================
            // INITIAL LOAD
            // ============================================

            loadCountries();

        });
        //         $(document).ready(function () {


        // });
    </script>

    <script>

        /* =========================================================
           UPDATE SKILL COUNT + HIDDEN FIELD
           ========================================================= */

        function updateSkillCount(type) {

            let selector = "";
            let countElement = "";
            let hiddenField = "";

            if (type === "medical") {

                selector = ".medical-skill:checked";
                countElement = "medicalCount";
                hiddenField = "sMedicalSkillIDs";

            }
            else if (type === "technical") {

                selector = ".technical-skill:checked";
                countElement = "technicalCount";
                hiddenField = "sTechnicalSkillIDs";

            }
            else if (type === "nonTechnical") {

                selector = ".nontechnical-skill:checked";
                countElement = "nonTechnicalCount";
                hiddenField = "sNonTechnicalSkillIDs";

            }


            const selected =
                document.querySelectorAll(selector);


            /* UPDATE COUNT */

            document.getElementById(countElement).innerText =
                selected.length + " selected";


            /* UPDATE HIDDEN FIELD */

            const values = [];


            selected.forEach(function(checkbox) {

                values.push(checkbox.value);

            });


            document.getElementById(hiddenField).value =
                values.join(",");

        }


        /* =========================================================
           UPDATE ALL SKILLS
           ========================================================= */

        function updateAllSkillCounts() {

            updateSkillCount("medical");

            updateSkillCount("technical");

            updateSkillCount("nonTechnical");

        }


        /* =========================================================
           CHECKBOX CHANGE
           ========================================================= */

        document.addEventListener("change", function(event) {

            if (event.target.classList.contains("medical-skill")) {

                updateSkillCount("medical");

            }


            if (event.target.classList.contains("technical-skill")) {

                updateSkillCount("technical");

            }


            if (event.target.classList.contains("nontechnical-skill")) {

                updateSkillCount("nonTechnical");

            }

        });


        /* =========================================================
           SKILLS FORM SUBMIT
           ========================================================= */

        document.addEventListener("DOMContentLoaded", function() {

            updateAllSkillCounts();


            const skillsForm =
                document.getElementById("skillsForm");


            if (!skillsForm) {
                return;
            }


            skillsForm.addEventListener("submit", function(event) {

                /* Make sure hidden fields contain latest values */

                updateAllSkillCounts();


                const medical =
                    document.querySelectorAll(
                        ".medical-skill:checked"
                    ).length;


                const technical =
                    document.querySelectorAll(
                        ".technical-skill:checked"
                    ).length;


                const nonTechnical =
                    document.querySelectorAll(
                        ".nontechnical-skill:checked"
                    ).length;


                const total =
                    medical +
                    technical +
                    nonTechnical;


                /* =================================================
                   VALIDATION
                   ================================================= */

                if (total === 0) {

                    event.preventDefault();


                    document.getElementById(
                        "skillValidationMessage"
                    ).style.display = "block";


                    document.getElementById(
                        "skillValidationMessage"
                    ).scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });


                    return false;
                }


                /* Hide validation */

                document.getElementById(
                    "skillValidationMessage"
                ).style.display = "none";


                /* =================================================
                   DISABLE BUTTON
                   ================================================= */

                const button =
                    document.getElementById(
                        "btnUpdateSkills"
                    );


                const text =
                    document.getElementById(
                        "updateSkillsText"
                    );


                const loader =
                    document.getElementById(
                        "updateSkillsLoader"
                    );


                button.disabled = true;


                text.innerText =
                    "Updating...";


                loader.style.display =
                    "inline-block";

            });

        });


        /* =========================================================
           ACCORDION ARROW
           ========================================================= */

        document.querySelectorAll(
            ".skill-accordion"
        ).forEach(function(accordion) {

            accordion.addEventListener(
                "toggle",
                function() {

                    const arrow =
                        accordion.querySelector(
                            ".accordion-arrow"
                        );


                    if (!arrow) {
                        return;
                    }


                    if (accordion.open) {

                        arrow.innerHTML = "▴";

                    }
                    else {

                        arrow.innerHTML = "▾";

                    }

                }
            );

        });

    </script>

