                    </div>


                    <div class="col-md-3 mb-3">

                        <label>PG Stream</label>

                        <select asp-for="Profile.PG_Stream"
                                class="form-control"
                                asp-items="@(new SelectList(Model.Streams, "ID", "Name"))">

                            <option value="">
                                -- Select Stream --
                            </option>

