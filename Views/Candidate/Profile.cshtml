@model ErJobPortal.Models.CandidateProfileViewModel

<style>
    /* ========================================================= */
    /* SKILLS SECTION */
    /* ========================================================= */

    .skills-section {
        width: 100%;
        margin-top: 25px;
        margin-bottom: 30px;
    }


    /* ========================================================= */
    /* TITLE */
    /* ========================================================= */

    .skills-title {
        margin-bottom: 15px;
    }

        .skills-title label {
            font-size: 16px;
            font-weight: 600;
            color: #102a43;
        }

        .skills-title .required {
            color: #dc3545;
            font-weight: 700;
        }


    /* ========================================================= */
    /* ACCORDION */
    /* ========================================================= */

    .skills-section .skill-accordion {
        width: 100%;
        margin-bottom: 15px;
        background: #ffffff;
        border: 1px solid #dce3eb;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    }


    /* ========================================================= */
    /* ACCORDION HEADER */
    /* ========================================================= */

    .skills-section .skill-header {
        min-height: 70px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        background: #f8fafc;
        list-style: none;
        transition: background 0.2s ease;
    }


        /* Remove default details arrow */

        .skills-section .skill-header::-webkit-details-marker {
            display: none;
        }

        .skills-section .skill-header::marker {
            display: none;
        }


        /* Header hover */

        .skills-section .skill-header:hover {
            background: #f1f5f9;
        }


    /* ========================================================= */
    /* SKILL HEADING */
    /* ========================================================= */

    .skills-section .skill-heading {
        font-size: 16px;
        font-weight: 600;
        color: #102a43;
    }


    /* ========================================================= */
    /* RIGHT SIDE */
    /* ========================================================= */

    .skills-section .skill-header-right {
        display: flex;
        align-items: center;
        gap: 15px;
    }


    /* ========================================================= */
    /* SELECTED COUNT */
    /* ========================================================= */

    .skills-section .selected-count {
        min-width: 90px;
        padding: 8px 14px;
        text-align: center;
        border-radius: 30px;
        background: #e5f5f3;
        color: #0d9488;
        font-size: 13px;
        font-weight: 600;
    }


    /* ========================================================= */
    /* ARROW */
    /* ========================================================= */

    .skills-section .accordion-arrow {
        width: 20px;
        text-align: center;
        color: #718096;
        font-size: 13px;
        transition: transform 0.2s ease;
    }


    /* ========================================================= */
    /* ACCORDION BODY */
    /* ========================================================= */

    .skills-section .skill-body {
        padding: 20px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        border-top: 1px solid #dce3eb;
        background: #ffffff;
    }


    /* ========================================================= */
    /* SKILL ITEM */
    /* ========================================================= */

    .skills-section .skill-item {
        min-height: 58px;
        padding: 0 14px;
        display: flex;
        align-items: center;
        gap: 9px;
        border: 1px solid #dce3eb;
        border-radius: 9px;
        background: #ffffff;
        cursor: pointer;
        font-size: 15px;
        font-weight: 600;
        color: #172b4d;
        transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }


        /* ========================================================= */
        /* CHECKBOX */
        /* ========================================================= */

        .skills-section .skill-item input[type="checkbox"] {
            width: 19px;
            height: 19px;
            margin: 0;
            flex-shrink: 0;
            cursor: pointer;
            accent-color: #0d9488;
        }


        /* ========================================================= */
        /* SKILL TEXT */
        /* ========================================================= */

        .skills-section .skill-item span {
            line-height: 1.3;
        }


        /* ========================================================= */
        /* HOVER */
        /* ========================================================= */

        .skills-section .skill-item:hover {
            border-color: #0d9488;
            background: #f8fffe;
            box-shadow: 0 3px 8px rgba(13, 148, 136, 0.08);
            transform: translateY(-1px);
        }


        /* ========================================================= */
        /* SELECTED */
        /* ========================================================= */

        .skills-section .skill-item:has(input[type="checkbox"]:checked) {
            border-color: #0d9488;
            background: #f0fdfa;
            box-shadow: 0 2px 6px rgba(13, 148, 136, 0.10);
        }


        /* ========================================================= */
        /* SELECTED CHECKBOX */
        /* ========================================================= */

        .skills-section
        .skill-item
        input[type="checkbox"]:checked {
            accent-color: #0d9488;
        }


    /* ========================================================= */
    /* OPEN ACCORDION */
    /* ========================================================= */

    .skills-section
    .skill-accordion[open]
    .skill-header {
        background: #f8fafc;
    }


    /* ========================================================= */
    /* RESPONSIVE - TABLET */
    /* ========================================================= */

    @@media (max-width: 992px) {

        .skills-section .skill-body {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }


    /* ========================================================= */
    /* RESPONSIVE - SMALL TABLET */
    /* ========================================================= */

    @@media (max-width: 768px) {

        .skills-section .skill-body {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .skills-section .skill-header {
            min-height: 65px;
            padding: 0 16px;
        }

        .skills-section .skill-heading {
            font-size: 15px;
        }
    }


    /* ========================================================= */
    /* RESPONSIVE - MOBILE */
    /* ========================================================= */

    @@media (max-width: 576px) {

        .skills-section {
            margin-top: 20px;
        }

            .skills-section .skill-body {
                grid-template-columns: 1fr;
                padding: 14px;
                gap: 10px;
            }

            .skills-section .skill-header {
                min-height: 62px;
                padding: 0 14px;
            }

            .skills-section .skill-header-right {
                gap: 8px;
            }

            .skills-section .selected-count {
                min-width: 75px;
                padding: 7px 9px;
                font-size: 11px;
            }

            .skills-section .skill-heading {
                font-size: 14px;
            }

            .skills-section .skill-item {
                min-height: 54px;
                font-size: 14px;
            }
    }


    /* ========================================================= */
    /* VERY SMALL MOBILE */
    /* ========================================================= */

    @@media (max-width: 400px) {

        .skills-section .skill-header {
            padding: 0 12px;
        }

        .skills-section .skill-heading {
            font-size: 13px;
        }

        .skills-section .selected-count {
            min-width: 65px;
            font-size: 10px;
        }

        .skills-section .accordion-arrow {
            width: 14px;
        }
    }

    /* ========================================================= */
    /* UPDATE SKILLS BUTTON */
    /* ========================================================= */

    #btnUpdateSkills {
        min-width: 150px;
        min-height: 42px;
        font-weight: 600;
        border-radius: 8px;
    }

        #btnUpdateSkills:disabled {
            cursor: not-allowed;
            opacity: 0.75;
        }


    /* ========================================================= */
    /* VALIDATION */
    /* ========================================================= */

    #skillValidationMessage {
        font-size: 14px;
        font-weight: 500;
    }
</style>
