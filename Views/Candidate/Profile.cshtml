    @* =========================================================
   SKILLS SECTION
   ========================================================= *@

    @{
        var selectedMedicalSkills = new HashSet<string>(
        (Model.Profile?.sMedicalSkillIDs ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim()),
        StringComparer.OrdinalIgnoreCase
        );

        var selectedTechnicalSkills = new HashSet<string>(
        (Model.Profile?.sTechnicalSkillIDs ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim()),
        StringComparer.OrdinalIgnoreCase
        );

        var selectedNonTechnicalSkills = new HashSet<string>(
        (Model.Profile?.sNonTechnicalSkillIDs ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim()),
        StringComparer.OrdinalIgnoreCase
        );
    }

    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                Skills
            </h5>
        </div>

        <div class="card-body">

            <form asp-controller="Candidate"
                  asp-action="UpdateSkills"
                  method="post"
                  id="skillsForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Profile.CandidateID" />

                <section class="skills-section" id="skills">

                    <!-- ================================================= -->
                    <!-- TITLE -->
                    <!-- ================================================= -->

                    <div class="skills-title">

                        <label>
                            Select Skill Type (Any 1)
                            <span class="required">*</span>
                        </label>

                        <small class="text-muted d-block mt-1">
                            Select one or more skills from any category.
                        </small>

                    </div>


                    <!-- ================================================= -->
                    <!-- MEDICAL SKILLS -->
                    <!-- ================================================= -->

                    <details class="skill-accordion" open>

                        <summary class="skill-header">

                            <span class="skill-heading">
                                Medical Skills
                            </span>

                            <span class="skill-header-right">

                                <span class="selected-count"
                                      id="medicalCount">
                                    0 selected
                                </span>

                                <span class="accordion-arrow">
                                    ▴
                                </span>

                            </span>

                        </summary>


                        <div class="skill-body"
                             id="medicalSkills">


                            <!-- 3D Slicer -->

                            <label class="skill-item">

                                <input type="checkbox"
                                       class="medical-skill"
                                       value="3D Slicer"
                                       @(selectedMedicalSkills.Contains("3D Slicer") ? "checked" : "") />

                                <span>
                                    3D Slicer
                                </span>

                            </label>


                            <!-- B.Pharm -->

                            <label class="skill-item">

                                <input type="checkbox"
                                       class="medical-skill"
                                       value="B.Pharm"
                                       @(selectedMedicalSkills.Contains("B.Pharm") ? "checked" : "") />

                                <span>
                                    B.Pharm
                                </span>

                            </label>


                            <!-- Auditory -->

                            <label class="skill-item">

                                <input type="checkbox"
                                       class="medical-skill"
                                       value="Auditory"
                                       @(selectedMedicalSkills.Contains("Auditory") ? "checked" : "") />

                                <span>
                                    Auditory
                                </span>

                            </label>


                            <!-- Clinical Research -->

                            <label class="skill-item">

                                <input type="checkbox"
                                       class="medical-skill"
                                       value="Clinical Research"
                                       @(selectedMedicalSkills.Contains("Clinical Research") ? "checked" : "") />

                                <span>
                                    Clinical Research
                                </span>

                            </label>


                            <!-- Anatomy -->

                            <label class="skill-item">

                                <input type="checkbox"
                                       class="medical-skill"
                                       value="Anatomy"
                                       @(selectedMedicalSkills.Contains("Anatomy") ? "checked" : "") />

                                <span>
                                    Anatomy
                                </span>

                            </label>


                            <!-- Biochemistry -->

                            <label class="skill-item">

                                <input type="checkbox"
                                       class="medical-skill"
                                       value="Biochemistry"
                                       @(selectedMedicalSkills.Contains("Biochemistry") ? "checked" : "") />

                                <span>
                                    Biochemistry
                                </span>

