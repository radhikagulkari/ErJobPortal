@model ErJobPortal.Models.CandidateFeedbackViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Dashboard";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}


<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f7faf9;
        font-family: Arial, Helvetica, sans-serif;
        color: #0f172a;
    }

    /* =========================================================
       1TRAINEE FEEDBACK PAGE
       ========================================================= */

    .feedback-page {
        width: 100%;
        padding: 30px 20px 80px;
    }

    .feedback-container {
        width: 1180px;
        max-width: 100%;
        margin: 0 auto;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .feedback-title {
        position: relative;
        margin: 0 0 28px;
        padding-left: 18px;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.3;
        color: #0f172a;
    }

    .feedback-title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 5px;
        width: 5px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(
            180deg,
            #14b8a6,
            #0f766e
        );
    }

    /* =========================================================
       SUCCESS / ERROR
       ========================================================= */

    .success-message,
    .error-message {
        margin: 0 0 22px;
        padding: 13px 17px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
    }

    .success-message {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #047857;
    }

    .error-message {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
    }

    /* =========================================================
       QUESTION CARD
       ========================================================= */

    .feedback-question-box {
        width: 100%;
        padding: 22px 25px;
        margin-bottom: 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.045);
        transition: border-color 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .feedback-question-box:hover {
        border-color: #99f6e4;
        box-shadow: 0 6px 20px rgba(13, 148, 136, 0.08);
    }

    /* =========================================================
       QUESTION TEXT
       ========================================================= */

    .question-text {
        margin: 0 0 18px;
        font-size: 17px;
        font-weight: 600;
        line-height: 1.55;
        color: #1e293b;
    }

    .question-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        margin-right: 8px;
        border-radius: 8px;
        background: #ccfbf1;
        color: #0f766e;
        font-size: 14px;
        font-weight: 700;
        vertical-align: middle;
    }

    /* =========================================================
       RADIO OPTIONS
       ========================================================= */

    .radio-options {
        margin-left: 0;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .radio-option {
        display: flex;
        align-items: center;
        min-width: 95px;
        padding: 9px 14px;
        border: 1px solid #dbe4e8;
        border-radius: 8px;
        background: #ffffff;
        cursor: pointer;
        font-size: 15px;
        color: #334155;
        transition: all 0.2s ease;
    }

    .radio-option:hover {
        border-color: #14b8a6;
        background: #f0fdfa;
        color: #0f766e;
    }

    .radio-option input[type="radio"] {
        appearance: none;
        -webkit-appearance: none;
        width: 16px;
        height: 16px;
        margin: 0 8px 0 0;
        border: 1.5px solid #94a3b8;
        border-radius: 50%;
        background: #fff;
        position: relative;
        cursor: pointer;
    }

    .radio-option input[type="radio"]:checked {
        border-color: #0d9488;
    }

    .radio-option input[type="radio"]:checked::after {
        content: "";
        position: absolute;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #0d9488;
        top: 2.5px;
        left: 2.5px;
    }

    /* =========================================================
       STAR RATING
       ========================================================= */

    .star-options {
        margin-left: 0;
        display: flex;
        align-items: center;
        gap: 5px;
        height: 35px;
    }

    .star-input {
        display: none;
    }

    .star {
        font-size: 30px;
        font-weight: 400;
        color: #ffc107;
        cursor: pointer;
        line-height: 1;
        display: inline-block;
        transition: color 0.15s ease,
                    transform 0.15s ease;
    }

    .star:hover {
        color: #0d9488;
        transform: scale(1.08);
    }

  /* =========================================================
   EMOJI RATING
   ========================================================= */

.emoji-options {
    margin-left: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 55px;
}

.emoji-option {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 48px;
    padding: 0;
    border: 1px solid #dbe4e8;
    border-radius: 10px;
    background: #ffffff;
    cursor: pointer;
    transition: all 0.2s ease;
}

/* Hide the actual radio button */
.emoji-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
}

/* Emoji */
.emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
}

/* Hover */
.emoji-option:hover {
    border-color: #14b8a6;
    background: #f0fdfa;
    transform: translateY(-2px);
}

/* SELECTED EMOJI */
.emoji-option:has(input[type="radio"]:checked) {
    border: 2px solid #0d9488;
    background: #ccfbf1;
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.12);
}

/* Selected emoji slightly bigger */
.emoji-option:has(input[type="radio"]:checked) .emoji {
    transform: scale(1.12);
}

    /* =========================================================
       TEXTAREA
       ========================================================= */

    .feedback-textarea {
        display: block;
        width: 100%;
        min-height: 110px;
        margin-left: 0;
        padding: 13px 15px;
        border: 1px solid #d8e1e5;
        border-radius: 10px;
        background: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 15px;
        line-height: 1.5;
        color: #334155;
        resize: vertical;
        outline: none;
        transition: border-color 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .feedback-textarea::placeholder {
        color: #94a3b8;
    }

    .feedback-textarea:focus {
        border-color: #14b8a6;
        box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.10);
    }

    /* =========================================================
       VALIDATION
       ========================================================= */

    .field-validation {
        display: block;
        margin-left: 0;
        margin-top: 7px;
        color: #dc2626;
        font-size: 13px;
    }

    /* =========================================================
       SUBMIT
       ========================================================= */

    .submit-area {
        margin-top: 24px;
        margin-left: 0;
        display: flex;
        justify-content: flex-end;
    }

    .submit-button {
        min-width: 125px;
        padding: 11px 24px;
        background: linear-gradient(
            135deg,
            #0d9488,
            #0f766e
        );
        color: #ffffff;
        border: none;
        border-radius: 9px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 5px 14px rgba(13, 148, 136, 0.22);
        transition: all 0.2s ease;
    }

    .submit-button:hover {
        background: linear-gradient(
            135deg,
            #0f766e,
            #115e59
        );
        transform: translateY(-1px);
        box-shadow: 0 7px 18px rgba(13, 148, 136, 0.28);
    }

    .submit-button:active {
        transform: translateY(0);
    }

    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .feedback-page {
            padding: 25px 16px 60px;
        }

        .feedback-container {
            width: 100%;
        }

        .feedback-title {
            font-size: 27px;
        }

        .feedback-question-box {
            padding: 20px;
        }

    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 600px) {

        .feedback-page {
            padding: 20px 12px 50px;
        }

        .feedback-title {
            margin-bottom: 22px;
            padding-left: 14px;
            font-size: 24px;
        }

        .feedback-title::before {
            width: 4px;
            height: 29px;
        }

        .feedback-question-box {
            padding: 17px;
            margin-bottom: 14px;
            border-radius: 12px;
        }

        .question-text {
            font-size: 15px;
        }

        .question-number {
            width: 26px;
            height: 26px;
            margin-right: 6px;
            font-size: 13px;
        }

        .radio-options {
            gap: 8px;
        }

        .radio-option {
            min-width: 85px;
            padding: 8px 11px;
            font-size: 14px;
        }

        .star {
            font-size: 27px;
        }

        .emoji-options {
            gap: 7px;
        }

        .emoji-option {
            width: 43px;
        }

        .feedback-textarea {
            min-height: 100px;
        }

        .submit-button {
            width: 100%;
        }

    }

</style>


<div class="feedback-page">

    <div class="feedback-container">

        <h1 class="feedback-title">
            Add Feedback
        </h1>


        @if (TempData["Success"] != null)
        {
            <div class="success-message">
                @TempData["Success"]
            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="error-message">
                @TempData["Error"]
            </div>
        }


        <form asp-controller="Organization"
              asp-action="CreateFeedback"
              method="post">

            @Html.AntiForgeryToken()

            <!-- QUESTION 1 -->
            <!-- =========================================
                 QUESTION 1
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        1.
                    </span>

                    @Model.Que1

                </div>


                <div class="radio-options">

                    <label class="radio-option">

                        <input type="radio"
                               asp-for="sQue1"
                               value="True" />

                        <span>True</span>

                    </label>


                    <label class="radio-option">

                        <input type="radio"
                               asp-for="sQue1"
                               value="False" />

                        <span>False</span>

                    </label>

                </div>

                <span asp-validation-for="sQue1"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 QUESTION 2 - STAR RATING
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        2.
                    </span>

                    @Model.Que2

                </div>


                <div class="star-options">

                    <input type="radio"
                           asp-for="sQue2"
                           value="1"
                           id="star1"
                           class="star-input" />

                    <label for="star1"
                           class="star"
                           data-value="1">
                        ☆
                    </label>


                    <input type="radio"
                           asp-for="sQue2"
                           value="2"
                           id="star2"
                           class="star-input" />

                    <label for="star2"
                           class="star"
                           data-value="2">
                        ☆
                    </label>


                    <input type="radio"
                           asp-for="sQue2"
                           value="3"
                           id="star3"
                           class="star-input" />

                    <label for="star3"
                           class="star"
                           data-value="3">
                        ☆
                    </label>


                    <input type="radio"
                           asp-for="sQue2"
                           value="4"
                           id="star4"
                           class="star-input" />

                    <label for="star4"
                           class="star"
                           data-value="4">
                        ☆
                    </label>


                    <input type="radio"
                           asp-for="sQue2"
                           value="5"
                           id="star5"
                           class="star-input" />

                    <label for="star5"
                           class="star"
                           data-value="5">
                        ☆
                    </label>

                </div>

                <span asp-validation-for="sQue2"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 QUESTION 3
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        3.
                    </span>

                    @Model.Que3

                </div>


                <div class="radio-options">

                    <label class="radio-option">

                        <input type="radio"
                               asp-for="sQue3"
                               value="Yes" />

                        <span>Yes</span>

                    </label>


                    <label class="radio-option">

                        <input type="radio"
                               asp-for="sQue3"
                               value="No" />

                        <span>No</span>

                    </label>

                </div>

                <span asp-validation-for="sQue3"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 QUESTION 4 - EMOJI
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        4.
                    </span>

                    @Model.Que4

                </div>


                <div class="emoji-options">

                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="1" />

                        <span class="emoji">
                            😡
                        </span>

                    </label>


                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="2" />

                        <span class="emoji">
                            😟
                        </span>

                    </label>


                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="3" />

                        <span class="emoji">
                            😐
                        </span>

                    </label>


                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="4" />

                        <span class="emoji">
                            🙂
                        </span>

                    </label>


                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="5" />

                        <span class="emoji">
                            😍
                        </span>

                    </label>

                </div>

                <span asp-validation-for="sQue4"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 QUESTION 5
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        5.
                    </span>

                    @Model.Que5

                </div>


                <textarea asp-for="sQue5"
                          class="feedback-textarea"
                          placeholder="Enter your feedback..."></textarea>

                <span asp-validation-for="sQue5"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 SUBMIT
                 ========================================= -->

            <div class="submit-area">

                <button type="submit"
                        class="submit-button">
                    Submit
                </button>

            </div>
        </form>


    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const stars =
                    document.querySelectorAll(".star");

                const inputs =
                    document.querySelectorAll(".star-input");


                function updateStars(selectedValue) {

                    stars.forEach(function (star) {

                        const value =
                            parseInt(
                                star.getAttribute("data-value")
                            );

                        if (value <= selectedValue) {
                            star.textContent = "★";
                        }
                        else {
                            star.textContent = "☆";
                        }

                    });
                }


                stars.forEach(function (star) {

                    star.addEventListener(
                        "click",
                        function () {

                            const selectedValue =
                                parseInt(
                                    this.getAttribute(
                                        "data-value"
                                    )
                                );

                            updateStars(selectedValue);
                        }
                    );

                });


                // Restore selected stars
                inputs.forEach(function (input) {

                    if (input.checked) {

                        updateStars(
                            parseInt(input.value)
                        );

                    }

                });

            }
        );

    </script>
}