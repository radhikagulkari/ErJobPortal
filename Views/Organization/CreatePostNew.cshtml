    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // =====================================================
            // DROPDOWNS
            // =====================================================

            const countryDropdown =
                document.getElementById("sCountryCode");

            const stateDropdown =
                document.getElementById("sStateCode");

            const cityDropdown =
                document.getElementById("nCityID");


            // =====================================================
            // CHECK DROPDOWNS
            // =====================================================

            if (!countryDropdown ||
                !stateDropdown ||
                !cityDropdown) {

                console.error(
                    "Country / State / City dropdown not found."
                );

                return;
            }


            // =====================================================
            // LOAD COUNTRIES
            // =====================================================

            fetch('@Url.Action("GetCountries", "Organization")')
                .then(response => {

                    if (!response.ok) {
                        throw new Error(
                            "Country API failed: " +
                            response.status
                        );
                    }

                    return response.json();
                })

                .then(countries => {

                    countryDropdown.innerHTML =
                        '<option value="">-- Select Country --</option>';

                    countries.forEach(country => {

                        const option =
                            document.createElement("option");

                        // IMPORTANT:
                        // Use ISO2 as value
                        // Example: IN, US, GB

                        option.value =
                            country.iso2;

                        option.textContent =
                            country.name;

                        countryDropdown.appendChild(option);
                    });

                })

                .catch(error => {

                    console.error(
                        "Country Error:",
                        error
                    );

                });


            // =====================================================
            // COUNTRY CHANGE
            // =====================================================

            countryDropdown.addEventListener(
                "change",
                function () {

                    const countryCode =
                        this.value;

                    // Reset state

                    stateDropdown.innerHTML =
                        '<option value="">-- Select State --</option>';

                    stateDropdown.disabled = true;


                    // Reset city

                    cityDropdown.innerHTML =
                        '<option value="0">-- Select City --</option>';

                    cityDropdown.disabled = true;


                    // Nothing selected

                    if (!countryCode) {
                        return;
                    }


                    // =================================================
                    // LOAD STATES
                    // =================================================

                    fetch(
                        '@Url.Action("GetStates", "Organization")' +
                        '?countryCode=' +
                        encodeURIComponent(countryCode)
                    )

                    .then(response => {

                        if (!response.ok) {

                            throw new Error(
                                "State API failed: " +
                                response.status
                            );

                        }

                        return response.json();

                    })

                    .then(states => {

                        stateDropdown.innerHTML =
                            '<option value="">-- Select State --</option>';

                        if (!states ||
                            states.length === 0) {

                            stateDropdown.innerHTML =
                                '<option value="">No states found</option>';

                            return;
                        }


                        states.forEach(state => {

                            const option =
                                document.createElement("option");

                            // IMPORTANT:
                            // State value must be StateCode
                            // Example: MH, GJ, DL

                            option.value =
                                state.stateCode;

                            option.textContent =
                                state.name;

                            stateDropdown.appendChild(
                                option
                            );

                        });


                        stateDropdown.disabled =
                            false;

                    })

                    .catch(error => {

                        console.error(
                            "State Error:",
                            error
                        );

                    });

                }
            );


            // =====================================================
            // STATE CHANGE
            // =====================================================

            stateDropdown.addEventListener(
                "change",
                function () {

                    const countryCode =
                        countryDropdown.value;

                    const stateCode =
                        this.value;


                    // Reset city

                    cityDropdown.innerHTML =
                        '<option value="0">-- Select City --</option>';

                    cityDropdown.disabled = true;


                    if (!countryCode ||
                        !stateCode) {

                        return;
                    }


                    // =================================================
                    // LOAD CITIES
                    // =================================================

                    const url =
                        '@Url.Action("GetCities", "Organization")' +
                        '?countryCode=' +
                        encodeURIComponent(countryCode) +
                        '&stateCode=' +
                        encodeURIComponent(stateCode);


                    console.log(
                        "City Request:",
                        url
                    );


                    fetch(url)

                    .then(response => {

                        if (!response.ok) {

                            throw new Error(
                                "City API failed: " +
                                response.status
                            );

                        }

                        return response.json();

                    })

                    .then(cities => {

                        cityDropdown.innerHTML =
                            '<option value="0">-- Select City --</option>';


                        if (!cities ||
                            cities.length === 0) {

                            cityDropdown.innerHTML =
                                '<option value="0">No cities found</option>';

                            return;
                        }


                        cities.forEach(city => {

                            const option =
                                document.createElement("option");

                            // City ID is sent to C#
                            option.value =
                                city.id;

                            // City name displayed to user
                            option.textContent =
                                city.name;

                            cityDropdown.appendChild(
                                option
                            );

                        });


                        cityDropdown.disabled =
                            false;

                    })

                    .catch(error => {

                        console.error(
                            "City Error:",
                            error
                        );

                    });

                }
            );


            // =====================================================
            // IMPORTANT:
            // ENABLE STATE/CITY BEFORE FORM SUBMIT
            // =====================================================

            const form =
                countryDropdown.closest("form");

            if (form) {

                form.addEventListener(
                    "submit",
                    function () {

                        // Disabled fields are NOT submitted
                        // by normal HTML forms.

                        stateDropdown.disabled = false;
                        cityDropdown.disabled = false;

                    }
                );

            }

        });

    </script>

