@*
    View Organization Profile
*@
@{
    ViewData["Title"] = "View Organization Profile";
}
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Organization Profile - IT-NetworkZ Infosystems Pvt Ltd
    </title>


    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <style>

        /* =========================================================
                               ROOT
                            ========================================================= */

        :root {
            --primary: #0d9488;
            --primary-dark: #0f766e;
            --primary-deep: #115e59;
            --primary-light: #14b8a6;
            --primary-soft: #2dd4bf;
            --gradient: linear-gradient( 135deg, #0f766e, #14b8a6 );
            --dark: #0f172a;
            --text: #475569;
            --muted: #64748b;
            --light: #f7faf9;
            --light-teal: #f0fdfa;
            --border: #e6ecef;
            --white: #ffffff;
            --shadow: 0 15px 45px rgba(15, 42, 39, 0.09);
        }


        /* =========================================================
                               RESET
                            ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f7faf9;
            color: var(--text);
            min-height: 100vh;
        }


        /* =========================================================
                               TOP ACTION BAR
                            ========================================================= */

        .profile-toolbar {
            width: 100%;
            height: 62px;
            display: flex;
            align-items: center;
            justify-content: end;
            padding: 0 32px;
            position: sticky;
            top: 0;
            z-index: 100;
        }


        /* =========================================================
                               LEFT
                            ========================================================= */

        .toolbar-brand {
            display: flex;
            align-items: center;
            gap: 11px;
        }


        .toolbar-logo {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            border: 1px solid var(--border);
            background: var(--white);
            padding: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }


            .toolbar-logo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }


        .toolbar-title {
            color: var(--dark);
            font-size: 14px;
            font-weight: 700;
        }


        .toolbar-subtitle {
            display: block;
            color: var(--muted);
            font-size: 10px;
            margin-top: 2px;
        }


        /* =========================================================
                               ACTIONS
                            ========================================================= */

        .toolbar-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }


        .toolbar-btn {
            height: 36px;
            padding: 0 13px;
            border-radius: 9px;
            border: 1px solid var(--border);
            background: var(--white);
            color: var(--text);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: border-color .2s ease, color .2s ease, transform .2s ease, box-shadow .2s ease;
        }


            .toolbar-btn i {
                font-size: 12px;
            }


            .toolbar-btn:hover {
                border-color: rgba(13, 148, 136, .30);
                color: var(--primary-dark);
                transform: translateY(-1px);
                box-shadow: 0 5px 15px rgba(13, 148, 136, .08);
            }


            /* =========================================================
                               DOWNLOAD BUTTON
                            ========================================================= */

            .toolbar-btn.download {
                color: var(--white);
                border: none;
                background: var(--gradient);
                box-shadow: 0 6px 15px rgba(13, 148, 136, .20);
            }


                .toolbar-btn.download:hover {
                    color: var(--white);
                    box-shadow: 0 9px 20px rgba(13, 148, 136, .28);
                }


        /* =========================================================
                               PAGE
                            ========================================================= */

        .profile-wrapper {
            width: 100%;
            max-width: 920px;
            margin: 28px auto;
            padding: 0 16px;
        }


        /* =========================================================
                               PROFILE CARD
                            ========================================================= */

        .organization-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: var(--shadow);
        }


        /* =========================================================
                               CARD HEADER
                            ========================================================= */

        .organization-header {
            min-height: 180px;
            background: var(--gradient);
            padding: 28px 38px;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }


        /* =========================================================
                               SUBTLE DECORATION
                            ========================================================= */

        .header-circle {
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.14);
            right: -100px;
            top: -145px;
        }


        .header-circle-two {
            position: absolute;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.11);
            right: 120px;
            bottom: -100px;
        }


        .organization-header-content {
            display: flex;
            align-items: center;
            gap: 22px;
            position: relative;
            z-index: 2;
        }


        /* =========================================================
                               COMPANY LOGO
                            ========================================================= */

        .company-logo {
            width: 100px;
            height: 100px;
            flex-shrink: 0;
            border-radius: 16px;
            background: var(--white);
            border: 4px solid rgba(255,255,255,.25);
            padding: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 25px rgba(15, 42, 39, .18);
            overflow: hidden;
        }


            .company-logo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }


        /* =========================================================
                               COMPANY INFORMATION
                            ========================================================= */

        .company-information {
            color: var(--white);
            min-width: 0;
        }


        .verified-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
            opacity: .9;
        }


            .verified-label i {
                font-size: 11px;
            }


        .company-information h1 {
            font-size: 27px;
            line-height: 1.2;
            font-weight: 750;
            letter-spacing: -.4px;
            margin-bottom: 6px;
        }


        .company-information p {
            font-size: 12px;
            opacity: .85;
        }


        /* =========================================================
                               BODY
                            ========================================================= */

        .organization-body {
            padding: 25px 38px 28px;
        }


        /* =========================================================
                               SECTION TITLE
                            ========================================================= */

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 17px;
        }


        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
        }


        .section-title-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: var(--light-teal);
            color: var(--primary-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(13,148,136,.08);
        }


            .section-title-icon i {
                font-size: 14px;
            }


        .section-title-text h2 {
            color: var(--dark);
            font-size: 15px;
            font-weight: 700;
        }


        .section-title-text span {
            display: block;
            color: var(--muted);
            font-size: 10px;
            margin-top: 2px;
        }


        /* =========================================================
                               DETAILS BADGE
                            ========================================================= */

        .details-badge {
            background: var(--light-teal);
            color: var(--primary-dark);
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 700;
            border: 1px solid rgba(13,148,136,.08);
        }


        /* =========================================================
                               DETAILS GRID
                            ========================================================= */

        .details-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }


        /* =========================================================
                               DETAIL CARD
                            ========================================================= */

        .detail-card {
            min-width: 0;
            min-height: 82px;
            padding: 13px;
            border: 1px solid var(--border);
            border-radius: 11px;
            background: var(--white);
            display: flex;
            align-items: center;
            gap: 10px;
            transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
        }


            .detail-card:hover {
                border-color: rgba(13,148,136,.28);
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(13,148,136,.08);
            }


        /* =========================================================
                               ICON
                            ========================================================= */

        .detail-icon {
            width: 35px;
            height: 35px;
            flex-shrink: 0;
            border-radius: 9px;
            background: var(--light-teal);
            color: var(--primary-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(13,148,136,.07);
        }


            .detail-icon i {
                font-size: 13px;
            }


        /* =========================================================
                               TEXT
                            ========================================================= */

        .detail-content {
            min-width: 0;
        }


        .detail-label {
            display: block;
            color: #94a3b8;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .55px;
            margin-bottom: 4px;
        }


        .detail-value {
            display: block;
            color: var(--text);
            font-size: 12px;
            line-height: 1.35;
            font-weight: 650;
            word-break: break-word;
        }


        /* =========================================================
                               FOOTER
                            ========================================================= */

        .organization-footer {
            min-height: 48px;
            padding: 10px 38px;
            border-top: 1px solid var(--border);
            background: #fbfdfd;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }


        .powered-text {
            color: #94a3b8;
            font-size: 10px;
        }


            .powered-text strong {
                color: var(--primary-dark);
                font-weight: 700;
            }


        .footer-right {
            color: #a0a9b5;
            font-size: 9px;
            display: flex;
            align-items: center;
            gap: 5px;
        }


            .footer-right i {
                color: var(--primary);
                font-size: 9px;
            }


        /* =========================================================
                               TABLET
                            ========================================================= */

        @@media (max-width: 850px) {

            .profile-toolbar {
                padding: 0 18px;
            }


            .profile-wrapper {
                max-width: 760px;
                margin-top: 20px;
            }


            .organization-header {
                padding: 25px 28px;
            }


            .organization-body {
                padding: 22px 28px 25px;
            }


            .organization-footer {
                padding-left: 28px;
                padding-right: 28px;
            }


            .details-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }


        /* =========================================================
                               MOBILE
                            ========================================================= */

        @@media (max-width: 600px) {

            .profile-toolbar {
                height: 58px;
                padding: 0 12px;
            }


            .toolbar-logo {
                width: 34px;
                height: 34px;
            }


            .toolbar-title {
                font-size: 12px;
            }


            .toolbar-subtitle {
                display: none;
            }


            .toolbar-actions {
                gap: 5px;
            }


            .toolbar-btn {
                width: 36px;
                height: 36px;
                padding: 0;
            }


                .toolbar-btn span {
                    display: none;
                }


                .toolbar-btn i {
                    font-size: 13px;
                }


            .profile-wrapper {
                margin: 12px auto 25px;
                padding: 0 9px;
            }


            .organization-card {
                border-radius: 15px;
            }


            .organization-header {
                padding: 22px 18px;
                min-height: 145px;
            }


            .organization-header-content {
                gap: 15px;
            }


            .company-logo {
                width: 72px;
                height: 72px;
                border-radius: 12px;
                padding: 6px;
                border-width: 3px;
            }


            .verified-label {
                font-size: 7px;
                margin-bottom: 5px;
            }


            .company-information h1 {
                font-size: 18px;
                line-height: 1.2;
            }


            .company-information p {
                font-size: 10px;
            }


            .organization-body {
                padding: 19px 14px 20px;
            }


            .section-header {
                margin-bottom: 12px;
            }


            .section-title-icon {
                width: 31px;
                height: 31px;
            }


            .section-title-text h2 {
                font-size: 13px;
            }


            .section-title-text span {
                font-size: 9px;
            }


            .details-badge {
                display: none;
            }


            .details-grid {
                grid-template-columns: 1fr;
                gap: 8px;
            }


            .detail-card {
                min-height: 64px;
                padding: 10px;
            }


            .detail-icon {
                width: 34px;
                height: 34px;
            }


            .detail-value {
                font-size: 12px;
            }


            .organization-footer {
                min-height: 43px;
                padding: 9px 14px;
                justify-content: center;
            }


            .footer-right {
                display: none;
            }
        }


        /* =========================================================
                               SMALL MOBILE
                            ========================================================= */

        @@media (max-width: 390px) {

            .toolbar-brand {
                gap: 7px;
            }


            .toolbar-title {
                display: none;
            }


            .organization-header-content {
                align-items: flex-start;
            }


            .company-logo {
                width: 62px;
                height: 62px;
            }


            .company-information h1 {
                font-size: 16px;
            }


            .detail-value {
                font-size: 11px;
            }
        }


        /* =========================================================
                               PRINT
                            ========================================================= */

        @@media print {

            body {
                background: var(--white);
            }


            .profile-toolbar {
                display: none !important;
            }


            .profile-wrapper {
                max-width: 100%;
                margin: 0;
                padding: 0;
            }


            .organization-card {
                border-radius: 0;
                box-shadow: none;
                border: 1px solid #d5dbe2;
            }


            .organization-header {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }


            .detail-card {
                break-inside: avoid;
                box-shadow: none;
            }


            .organization-footer {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }

    </style>
</head>


<body>


    <!-- =========================================================
         TOP TOOLBAR
    ========================================================== -->

    <header class="profile-toolbar">




        <!-- ACTIONS -->

        <div class="toolbar-actions">


            <!-- HOME -->

            <a href="/"
               class="toolbar-btn"
               title="Home">

                <i class="fa-solid fa-house"></i>

                <span>
                    Home
                </span>

            </a>


            <!-- PRINT -->

            <button type="button"
                    class="toolbar-btn"
                    title="Print"
                    onclick="window.print();">

                <i class="fa-solid fa-print"></i>

                <span>
                    Print
                </span>

            </button>


            <!-- DOWNLOAD -->

            <button type="button"
                    class="toolbar-btn download"
                    title="Download"
                    onclick="downloadProfile();">

                <i class="fa-solid fa-download"></i>

                <span>
                    Download
                </span>

            </button>


        </div>

    </header>



    <!-- =========================================================
         PROFILE
    ========================================================== -->

    <main class="profile-wrapper">


        <section class="organization-card"
                 id="organizationProfile">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="organization-header">


                <div class="header-circle"></div>

                <div class="header-circle-two"></div>


                <div class="organization-header-content">


                    <!-- COMPANY LOGO -->

                    <div class="company-logo">

                        <img src="~/images/it-networkz-logo.png"
                             alt="IT-NetworkZ Infosystems Pvt Ltd Logo" />

                    </div>



                    <!-- COMPANY NAME -->

                    <div class="company-information">


                        <div class="verified-label">

                            <i class="fa-solid fa-circle-check"></i>

                            Verified Organization

                        </div>


                        <h1>
                            IT-NetworkZ Infosystems Pvt Ltd
                        </h1>


                        <p>
                            Official Organization Profile
                        </p>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 BODY
            ================================================== -->

            <div class="organization-body">


                <!-- SECTION HEADER -->

                <div class="section-header">


                    <div class="section-title">


                        <div class="section-title-icon">

                            <i class="fa-solid fa-building"></i>

                        </div>


                        <div class="section-title-text">

                            <h2>
                                Organization Information
                            </h2>

                            <span>
                                Official organization details
                            </span>

                        </div>

                    </div>


                    <div class="details-badge">
                        8 DETAILS
                    </div>

                </div>



                <!-- =================================================
                     DETAILS
                ================================================== -->

                <div class="details-grid">


                    <!-- CONTACT PERSON -->

                    <div class="detail-card">

                        <div class="detail-icon">

                            <i class="fa-solid fa-user"></i>

                        </div>


                        <div class="detail-content">

                            <span class="detail-label">
                                Contact Person
                            </span>

                            <span class="detail-value">
                                Harshada Girhe
                            </span>

                        </div>

                    </div>



                    <!-- DESIGNATION -->

                    <div class="detail-card">

                        <div class="detail-icon">

                            <i class="fa-solid fa-id-badge"></i>

                        </div>


                        <div class="detail-content">

                            <span class="detail-label">
                                Designation
                            </span>

                            <span class="detail-value">
                                Hrm
                            </span>

                        </div>

                    </div>



                    <!-- ADDRESS -->

                    <div class="detail-card">

                        <div class="detail-icon">

                            <i class="fa-solid fa-location-dot"></i>

                        </div>


                        <div class="detail-content">

                            <span class="detail-label">
                                Company Address
                            </span>

                            <span class="detail-value">
                                Laxmi Nagar Nagpur
                            </span>

                        </div>

                    </div>



                    <!-- ESTABLISHMENT -->

                    <div class="detail-card">

                        <div class="detail-icon">

                            <i class="fa-solid fa-calendar-days"></i>

                        </div>


                        <div class="detail-content">

                            <span class="detail-label">
                                Establishment Year
                            </span>

                            <span class="detail-value">
                                2007
                            </span>

                        </div>

                    </div>



                    <!-- EMAIL -->

                    <div class="detail-card">

                        <div class="detail-icon">

                            <i class="fa-solid fa-envelope"></i>

                        </div>


                        <div class="detail-content">

                            <span class="detail-label">
                                Verification Email
                            </span>

                            <span class="detail-value">
                                contact@it-networkz.com
                            </span>

                        </div>

                    </div>



                    <!-- GST -->

                    <div class="detail-card">

                        <div class="detail-icon">

                            <i class="fa-solid fa-file-invoice"></i>

                        </div>


                        <div class="detail-content">

                            <span class="detail-label">
                                GST No.
                            </span>

                            <span class="detail-value">
                                27AADCI8640L1Z6
                            </span>

                        </div>

                    </div>



                    <!-- CIN -->

                    <div class="detail-card">

                        <div class="detail-icon">

                            <i class="fa-solid fa-file-lines"></i>

                        </div>


                        <div class="detail-content">

                            <span class="detail-label">
                                CIN No.
                            </span>

                            <span class="detail-value">
                                U72200MH2015PTC266007
                            </span>

                        </div>

                    </div>



                    <!-- EMPLOYEE -->

                    <div class="detail-card">

                        <div class="detail-icon">

                            <i class="fa-solid fa-users"></i>

                        </div>


                        <div class="detail-content">

                            <span class="detail-label">
                                Employee Strength
                            </span>

                            <span class="detail-value">
                                11-100
                            </span>

                        </div>

                    </div>


                </div>

            </div>



            <!-- =================================================
                 FOOTER
            ================================================== -->

            <footer class="organization-footer">


                <div class="powered-text">

                    Powered by

                    <strong>
                        www.1trainee.com
                    </strong>

                </div>


                <div class="footer-right">

                    <i class="fa-solid fa-shield-halved"></i>

                    Organization Profile

                </div>


            </footer>


        </section>

    </main>



    <!-- =========================================================
         DOWNLOAD
    ========================================================== -->

    <script>

        function downloadProfile() {

            const printWindow =
                window.open("", "_blank");


            if (!printWindow) {

                alert(
                    "Please allow pop-ups to download the profile."
                );

                return;
            }


            printWindow.document.write(`

                <!DOCTYPE html>

                <html>

                <head>

                    <title>
                        IT-NetworkZ Infosystems Pvt Ltd
                    </title>


                    <style>

                        * {
                            box-sizing: border-box;
                        }


                        body {

                            margin: 0;

                            padding: 30px;

                            font-family:
                                Arial,
                                sans-serif;

                            background: #ffffff;

                            color: #334155;
                        }


                        .profile {

                            max-width: 900px;

                            margin: auto;

                            border:
                                1px solid #e2e8f0;

                            border-radius: 18px;

                            overflow: hidden;
                        }


                        .header {

                            padding: 30px;

                            color: #ffffff;

                            background:
                                linear-gradient(
                                    135deg,
                                    #2563eb,
                                    #4f46e5
                                );
                        }


                        .logo {

                            width: 82px;

                            height: 82px;

                            padding: 8px;

                            border-radius: 14px;

                            background: #ffffff;

                            margin-bottom: 15px;
                        }


                        .logo img {

                            width: 100%;

                            height: 100%;

                            object-fit: contain;
                        }


                        h1 {

                            margin: 0;

                            font-size: 26px;
                        }


                        .subtitle {

                            margin-top: 6px;

                            font-size: 12px;

                            opacity: .9;
                        }


                        .content {

                            padding: 25px;
                        }


                        .grid {

                            display: grid;

                            grid-template-columns:
                                repeat(2, 1fr);

                            gap: 10px;
                        }


                        .item {

                            padding: 15px;

                            border:
                                1px solid #e2e8f0;

                            border-radius: 10px;
                        }


                        .label {

                            display: block;

                            color: #94a3b8;

                            font-size: 9px;

                            font-weight: bold;

                            text-transform:
                                uppercase;

                            margin-bottom: 5px;
                        }


                        .value {

                            font-size: 13px;

                            font-weight: 650;
                        }


                        .footer {

                            padding: 15px;

                            text-align: center;

                            background: #fafbfd;

                            color: #64748b;

                            font-size: 10px;
                        }


                        @@media print {

                            body {

                                padding: 0;
                            }

                        }

                    </style>

                </head>


