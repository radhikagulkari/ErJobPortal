    <script>

        document.addEventListener("DOMContentLoaded", async function () {

            await loadDropdown(
                "nPositionID",
                "/Organization/GetPosition",
                "-- Select Position --",
                "@Model.nPositionID"
            );

            await loadDropdown(
                "nGenderID",
                "/Organization/GetGender",
                "-- Select Gender --",
                "@Model.nGenderID"
            );

            await loadDropdown(
                "nMinimumQualificationID",
                "/Organization/GetMinimumQualification",
                "-- Select Qualification --",
                "@Model.nMinimumQualificationID"
            );

            await loadDropdown(
                "nInternshipTypeID",
                "/Organization/GetInternshipType",
                "-- Select Internship Type --",
                "@Model.nInternshipTypeID"
            );

            await loadDropdown(
                "nInternshipFellowshipTypeID",
                "/Organization/GetInternshipFellowshipType",
                "-- Select Fellowship Type --",
                "@Model.nInternshipFellowshipTypeID"
            );

            await loadDropdown(
                "nTrainingInvolvedID",
                "/Organization/GetTrainingInvolved",
                "-- Select Training Involved --",
                "@Model.nTrainingInvolvedID"
            );

            await loadDropdown(
                "nInternshipDurationID",
                "/Organization/GetInternshipDuration",
                "-- Select Duration --",
                "@Model.nInternshipDurationID"
            );

            await loadDropdown(
                "nInternshipModeID",
                "/Organization/GetInternshipMode",
                "-- Select Internship Mode --",
                "@Model.nInternshipModeID"
            );

        });


        async function loadDropdown(
            dropdownId,
            url,
            defaultText,
            selectedValue) {

            const dropdown =
                document.getElementById(dropdownId);

            if (!dropdown) {
                return;
            }

            try {

                const response =
                    await fetch(url);

                if (!response.ok) {

                    throw new Error(
                        "HTTP Error: " + response.status
                    );

                }

                const data =
                    await response.json();

                dropdown.innerHTML =
                    `<option value="0">
                        ${defaultText}
                     </option>`;

                data.forEach(function (item) {

                    const option =
                        document.createElement("option");

                    option.value =
                        item.nID;

                    option.textContent =
                        item.sName;

                    if (
                        String(item.nID) ===
                        String(selectedValue)
                    ) {

                        option.selected = true;

                    }

                    dropdown.appendChild(option);

                });

            }
            catch (error) {

                console.error(
                    "Error loading " + dropdownId,
                    error
                );

            }

        }

    </script>


    <!-- =============================================================
         COUNTRY / STATE / CITY
    ============================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const countryDropdown =
                    document.getElementById("sCountryCode");

                const stateDropdown =
                    document.getElementById("sStateCode");

                const cityDropdown =
                    document.getElementById("nCityID");


                const existingCountry =
                    "@Model.sCountryCode";

                const existingState =
                    "@Model.sStateCode";

                const existingCity =
                    "@Model.nCityID";


                // =====================================================
                // LOAD COUNTRIES
                // =====================================================

                fetch(
                    '@Url.Action("GetCountries", "Organization")'
                )

                .then(response => {

                    if (!response.ok) {

                        throw new Error(
                            "Country API failed: " +
                            response.status
                        );

                    }

                    return response.json();

                })

                .then(countries => {

                    countryDropdown.innerHTML =
                        '<option value="">-- Select Country --</option>';

                    countries.forEach(country => {

                        const option =
                            document.createElement("option");

                        option.value =
                            country.iso2;

                        option.textContent =
                            country.name;

                        if (
                            country.iso2 ===
                            existingCountry
                        ) {

                            option.selected = true;

                        }

                        countryDropdown.appendChild(
                            option
                        );

                    });


                    // Automatically load existing state

                    if (existingCountry) {

                        loadStates(
                            existingCountry,
                            existingState
                        );

                    }

                })

                .catch(error => {

                    console.error(
                        "Country Error:",
                        error
                    );

                });


                // =====================================================
                // COUNTRY CHANGE
                // =====================================================

                countryDropdown.addEventListener(
                    "change",
                    function () {

                        const countryCode =
                            this.value;

                        stateDropdown.innerHTML =
                            '<option value="">-- Select State --</option>';

                        cityDropdown.innerHTML =
                            '<option value="0">-- Select City --</option>';

                        stateDropdown.disabled =
                            true;

                        cityDropdown.disabled =
                            true;


                        if (!countryCode) {
                            return;
                        }


                        loadStates(
                            countryCode,
                            ""
                        );

                    }
                );


                // =====================================================
                // LOAD STATES
                // =====================================================

                function loadStates(
                    countryCode,
                    selectedState) {

                    fetch(
                        '@Url.Action("GetStates", "Organization")' +
                        '?countryCode=' +
                        encodeURIComponent(countryCode)
                    )

                    .then(response => {

                        if (!response.ok) {

                            throw new Error(
                                "State API failed: " +
                                response.status
                            );

                        }

                        return response.json();

                    })

                    .then(states => {

                        stateDropdown.innerHTML =
                            '<option value="">-- Select State --</option>';

                        if (
                            !states ||
                            states.length === 0
                        ) {

                            stateDropdown.innerHTML =
                                '<option value="">No states found</option>';

                            return;

                        }


                        states.forEach(state => {

                            const option =
                                document.createElement("option");

                            option.value =
                                state.stateCode;

                            option.textContent =
                                state.name;

                            if (
                                state.stateCode ===
                                selectedState
                            ) {

                                option.selected = true;

                            }

                            stateDropdown.appendChild(
                                option
                            );

                        });


                        stateDropdown.disabled =
                            false;


                        // Load existing city

                        if (selectedState) {

                            loadCities(
                                countryCode,
                                selectedState,
                                existingCity
                            );

                        }

                    })

                    .catch(error => {

                        console.error(
                            "State Error:",
                            error
                        );

                    });

                }


                // =====================================================
                // STATE CHANGE
                // =====================================================

                stateDropdown.addEventListener(
                    "change",
                    function () {

                        const countryCode =
                            countryDropdown.value;

                        const stateCode =
                            this.value;

                        cityDropdown.innerHTML =
                            '<option value="0">-- Select City --</option>';

                        cityDropdown.disabled =
                            true;


                        if (
                            !countryCode ||
                            !stateCode
                        ) {

                            return;

                        }


                        loadCities(
                            countryCode,
                            stateCode,
                            0
                        );

                    }
                );


                // =====================================================
                // LOAD CITIES
                // =====================================================

                function loadCities(
                    countryCode,
                    stateCode,
                    selectedCity) {

                    const url =
                        '@Url.Action("GetCities", "Organization")' +
                        '?countryCode=' +
                        encodeURIComponent(countryCode) +
                        '&stateCode=' +
                        encodeURIComponent(stateCode);


                    fetch(url)

                    .then(response => {

                        if (!response.ok) {

                            throw new Error(
                                "City API failed: " +
                                response.status
                            );

                        }

                        return response.json();

                    })

                    .then(cities => {

                        cityDropdown.innerHTML =
                            '<option value="0">-- Select City --</option>';


                        if (
                            !cities ||
                            cities.length === 0
                        ) {

                            cityDropdown.innerHTML =
                                '<option value="0">No cities found</option>';

                            return;

                        }


                        cities.forEach(city => {

                            const option =
                                document.createElement("option");

                            option.value =
                                city.id;

                            option.textContent =
                                city.name;

                            if (
                                String(city.id) ===
                                String(selectedCity)
                            ) {

                                option.selected =
                                    true;

                            }

                            cityDropdown.appendChild(
                                option
                            );

                        });


                        cityDropdown.disabled =
                            false;

                    })

                    .catch(error => {

                        console.error(
                            "City Error:",
                            error
                        );

                    });

                }

            }
        );

    </script>


    <!-- =============================================================
         DATE / DURATION
    ============================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const durationDropdown =
                    document.getElementById(
                        "nInternshipDurationID"
                    );

                const startDate =
                    document.getElementById(
                        "dStartDate"
                    );

                const completionDate =
                    document.getElementById(
                        "dCompletionDate"
                    );


                durationDropdown.addEventListener(
                    "change",
                    function () {

                        calculateCompletionDate();

                    }
                );


                startDate.addEventListener(
                    "change",
                    function () {

                        calculateCompletionDate();

                    }
                );


                function calculateCompletionDate() {

                    const durationId =
                        parseInt(
                            durationDropdown.value
                        );

                    const startValue =
                        startDate.value;


                    if (
                        durationId === 0 ||
                        !startValue
                    ) {

                        return;

                    }


                    const date =
                        new Date(
                            startValue + "T00:00:00"
                        );


                    if (
                        isNaN(date.getTime())
                    ) {

                        return;

                    }


                    switch (durationId) {

                        case 1:

                            date.setDate(
                                date.getDate() + 28
                            );

                            break;

                        case 2:

                            date.setDate(
                                date.getDate() + 42
                            );

                            break;

                        case 3:

                            date.setDate(
                                date.getDate() + 84
                            );

                            break;

                        case 4:

                            date.setDate(
                                date.getDate() + 168
                            );

                            break;

                        case 5:

                            date.setFullYear(
                                date.getFullYear() + 1
                            );

                            break;

                        default:

                            return;

                    }


                    const year =
                        date.getFullYear();

                    const month =
                        String(
                            date.getMonth() + 1
                        ).padStart(2, "0");

                    const day =
                        String(
                            date.getDate()
                        ).padStart(2, "0");


                    completionDate.value =
                        `${year}-${month}-${day}`;

                }

            }
        );

    </script>


