                                            <option value="5">Data Analyst</option>
                                            <option value="6">Fellow Intern</option>
                                            <option value="7">GIS Trainee</option>
                                            <option value="8">Intern</option>
                                            <option value="9">Java Trainee</option>
                                            <option value="10">Mech Trainee</option>
                                            <option value="11">Mgmt Trainee</option>
                                            <option value="12">Project Trainee</option>
                                            <option value="13">QA Trainee</option>
                                            <option value="14">S/W Trainee</option>
                                            <option value="15">Support Engineer</option>
                                            <option value="16">Trainee</option>
                                            <option value="17">Trainee Admin</option>
                                            <option value="18">Trainee Designer</option>
                                            <option value="19">Trainee Engineer</option>
                                            <option value="20">Trainee Full Stack</option>
                                            <option value="21">Python Trainee</option>
                                            <option value="22">Trainee GenAI</option>
                                            <option value="23">Trainee Data Science</option>
                                            <option value="24">SalesForce Trainee</option>
                                            <option value="25">Network Trainee</option>
                                        </select>
                                    </div>
                                </div>
                                <span class="field-validation-valid text-danger" data-valmsg-for="PostPositionId" data-valmsg-replace="true"></span>
