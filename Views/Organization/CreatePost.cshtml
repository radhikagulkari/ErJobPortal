      "9":[{v:"117",t:"Edinburgh"}],
      "10":[{v:"118",t:"Sydney"}],
      "11":[{v:"119",t:"Melbourne"}],
      "12":[{v:"120",t:"Toronto"}],
      "13":[{v:"121",t:"Vancouver"}],
      "14":[{v:"122",t:"Munich"}],
      "15":[{v:"123",t:"Berlin City"}]
    };

    document.getElementById("CountryID").addEventListener("change", function(){
      var stateSel = document.getElementById("StateID");
      var citySel = document.getElementById("CityID");
      stateSel.innerHTML = '<option value=""> -- Select State Name -- </option>';
      citySel.innerHTML = '<option value=""> -- Select City Name -- </option>';
      var list = statesByCountry[this.value] || [];
      list.forEach(function(s){
        var o = document.createElement("option");
        o.value = s.v; o.textContent = s.t;
        stateSel.appendChild(o);
      });
    });

    document.getElementById("StateID").addEventListener("change", function(){
      var citySel = document.getElementById("CityID");
      citySel.innerHTML = '<option value=""> -- Select City Name -- </option>';
      var list = citiesByState[this.value] || [];
      list.forEach(function(c){
        var o = document.createElement("option");
        o.value = c.v; o.textContent = c.t;
        citySel.appendChild(o);
      });
    });

    /* ---------------- build facilities & skills grids ---------------- */
    var facilities = ["Accommodation","Food","Flexible Schedule","Incentives","Medical","Offer & Completion Letter","Pick Up & Drop","Stipend","Training","Travelling","Work From Home","Wifi / Internet Expenses","LOR"];
    var facilitiesGrid = document.getElementById("facilitiesGrid");
    facilities.forEach(function(name, i){
      facilitiesGrid.insertAdjacentHTML("beforeend",
        '<div class="col-xl-2 col-md-4"><div class="card"><div class="card-body">'+
        '<input id="FacilityAvailableList_'+i+'__IsChecked" name="FacilityAvailableList['+i+'].IsChecked" type="checkbox" value="true" /><input name="FacilityAvailableList['+i+'].IsChecked" type="hidden" value="false" />'+
        '<span>'+name+'</span>'+
        '<input id="FacilityAvailableList_'+i+'__FacilityAvailableID" name="FacilityAvailableList['+i+'].FacilityAvailableID" type="hidden" value="'+(i+1)+'" />'+
        '<input id="FacilityAvailableList_'+i+'__FacilityAvailable" name="FacilityAvailableList['+i+'].FacilityAvailable" type="hidden" value="'+name+'" />'+
        '</div></div></div>');
    });

    function buildSkillGrid(containerId, listName, items){
      var el = document.getElementById(containerId);
      items.forEach(function(name, i){
        el.insertAdjacentHTML("beforeend",
          '<div class="col-xl-2 col-md-4"><div class="card"><div class="card-body">'+
          '<input id="'+listName+'List_'+i+'__IsChecked" name="'+listName+'List['+i+'].IsChecked" onclick="SkillSelection()" type="checkbox" value="true" /><input name="'+listName+'List['+i+'].IsChecked" type="hidden" value="false" />'+
          '<span>'+name+'</span>'+
          '<input id="'+listName+'List_'+i+'__'+listName+'ID" name="'+listName+'List['+i+'].'+listName+'ID" type="hidden" value="'+(i+1)+'" />'+
          '<input id="'+listName+'List_'+i+'__'+listName+'" name="'+listName+'List['+i+'].'+listName+'" type="hidden" value="'+name+'" />'+
          '</div></div></div>');
      });
    }

    buildSkillGrid("medicalSkillsGrid","MedicalSkill",
      ["Basic Computer Knowledge","Nursing","Patient Care","Registered Nurse","Phlebotomy","Diagnostic Testing","Medical Coding","Emergency Response","HIPAA Compliance","Telemedicine"]);

    buildSkillGrid("technicalSkillsGrid","TechnicalSkill",
      ["Python 3","JAVA","React JS","Node JS","SQL","AI & ML","Data Analytics","UI/UX Design","Cloud Computing","Cyber Security","DevOps","Web Development"]);

    buildSkillGrid("nonTechnicalSkillsGrid","NonTechnicalSkill",
      ["Communication Skills","Time Mgmt","Teamwork & Collaboration","MS (Excel / Word / PowerPoint)","Sales","Marketing","Customer  Support","Data Entry","Recruitment","Documentation"]);

    /* ---------------- accordion toggling ---------------- */
    document.querySelectorAll(".accordion-button").forEach(function(btn){
      btn.addEventListener("click", function(){
        var target = document.querySelector(this.getAttribute("data-bs-target"));
        var isOpen = target.classList.contains("show");
        // close siblings within same accordion group
        var group = this.closest(".accordion");
        group.querySelectorAll(".accordion-collapse.show").forEach(function(c){ c.classList.remove("show"); });
        group.querySelectorAll(".accordion-button").forEach(function(b){ b.classList.add("collapsed"); });
        if(!isOpen){
          target.classList.add("show");
          this.classList.remove("collapsed");
        }
      });
    });

    /* ---------------- original behaviours (kept) ---------------- */
    function isNumber(evt){
      evt = (evt) ? evt : window.event;
      var charCode = (evt.which) ? evt.which : evt.keyCode;
      if (charCode > 31 && (charCode < 48 || charCode > 57)) return false;
      return true;
    }

    function HandleInternshipType(){
      var InternshipType = document.getElementById("InternshipType");
      var TotalCharges = document.getElementById("TotalCharges");
      if (InternshipType.value == "1" || InternshipType.value == "4") {
        TotalCharges.value = "";
        TotalCharges.setAttribute("disabled", true);
      } else {
        TotalCharges.removeAttribute("disabled");
      }
    }

    function WorkingDaysSelection(){
      var WeeklyWorkingDays = document.querySelectorAll('input[name^="WeeklyWorkingDaysList"]:checked').length;
      if (WeeklyWorkingDays < 1) {
        document.getElementById("WorkingDaysError").innerText = "This field is required";
        return false;
      } else {
        document.getElementById("WorkingDaysError").innerText = "";
        return true;
      }
    }

    function SkillSelection(){
      var MedicalSkillCount = document.querySelectorAll('input[name^="MedicalSkillList"]:checked').length;
      var TechnicalSkillCount = document.querySelectorAll('input[name^="TechnicalSkillList"]:checked').length;
      var NonTechnicalSkillCount = document.querySelectorAll('input[name^="NonTechnicalSkillList"]:checked').length;
      var totalSkillCount = MedicalSkillCount + TechnicalSkillCount + NonTechnicalSkillCount;

      if (totalSkillCount > 15) {
        document.getElementById("SkillError").innerText = "Select up to 15 skills";
        return false;
      }

      var med = document.querySelectorAll('input[name^="MedicalSkillList"][type="checkbox"]');
      var tech = document.querySelectorAll('input[name^="TechnicalSkillList"][type="checkbox"]');
      var non = document.querySelectorAll('input[name^="NonTechnicalSkillList"][type="checkbox"]');

      function setDisabled(list, val){ list.forEach(function(el){ el.disabled = val; }); }

      if (MedicalSkillCount > 0) { setDisabled(tech, true); setDisabled(non, true); }
      else if (TechnicalSkillCount > 0) { setDisabled(med, true); setDisabled(non, true); }
      else if (NonTechnicalSkillCount > 0) { setDisabled(med, true); setDisabled(tech, true); }
      else { setDisabled(med, false); setDisabled(tech, false); setDisabled(non, false); }

      document.getElementById("SkillError").innerText = totalSkillCount === 0 ? "This field is required" : "";
      return true;
    }

    function updateCompletionDate(){
      var durationDropdown = document.getElementById('TrainingDuration');
      var startDateInput = document.getElementById('MyPostStartDate');
      var completionDateInput = document.getElementById('PostEndDate');
      var startDateError = document.getElementById('StartDateErrorMessage');
      var endDateError = document.getElementById('EndDateErrorMessage');
      var trainingDuration = parseInt(durationDropdown.value);
      var startDate = new Date(startDateInput.value);

      startDateError.textContent = "";
      endDateError.textContent = "";
      if (!startDateInput.value) return;

      var completionDate = new Date(startDate);
      switch (trainingDuration) {
        case 1: completionDate.setDate(completionDate.getDate() + 28); break;
        case 2: completionDate.setDate(completionDate.getDate() + 42); break;
        case 3: completionDate.setDate(completionDate.getDate() + 84); break;
        case 4: completionDate.setDate(completionDate.getDate() + 168); break;
        case 5: completionDate.setFullYear(completionDate.getFullYear() + 1); break;
        default: endDateError.textContent = "Please select a valid internship duration."; return;
      }
      completionDateInput.value = completionDate.toISOString().split('T')[0];
      updatePreview();
    }
    document.getElementById('MyPostStartDate').min = new Date().toISOString().split('T')[0];

    function validateForm(){
      var v = document.getElementById('TotalCharges').value;
      if (v.charAt(0) === ' ') document.getElementById('TotalCharges').value = v.slice(1);
    }
    function validateForm1(){
      var v = document.getElementById('compulsaryLanguage').value;
      var sanitized = v.replace(/[^a-zA-Z,\s]/g, '');
      sanitized = sanitized.toLowerCase().replace(/\b\w/g, function(c){ return c.toUpperCase(); });
      if (sanitized.startsWith(' ')) sanitized = sanitized.substring(1);
      sanitized = sanitized.replace(/,\s+/g, ', ');
      document.getElementById('compulsaryLanguage').value = sanitized;
    }
    document.getElementById('compulsaryLanguage').addEventListener('input', function(){ validateForm1(); });

    function validateMyForm(){
      var ok = WorkingDaysSelection() && SkillSelection();
      return ok;
    }

    /* ---------------- live preview panel ---------------- */
    function updatePreview(){
      var pos = document.getElementById("PostPositionId");
      var role = pos.options[pos.selectedIndex] ? pos.options[pos.selectedIndex].text : "";
      var roleEl = document.getElementById("previewRole");
      roleEl.innerHTML = (role && role.indexOf("--") === -1) ? role : '<span class="placeholder">Select a position…</span>';

      var openings = document.getElementById("NoOfRequiredTrainee").value;
      document.getElementById("pfOpenings").textContent = openings ? openings : "—";

      var citySel = document.getElementById("CityID");
      var stateSel = document.getElementById("StateID");
      var city = citySel.options[citySel.selectedIndex] ? citySel.options[citySel.selectedIndex].text : "";
      var state = stateSel.options[stateSel.selectedIndex] ? stateSel.options[stateSel.selectedIndex].text : "";
      var locBits = [city, state].filter(function(x){ return x && x.indexOf("--") === -1; });
      document.getElementById("pfLocation").textContent = locBits.length ? locBits.join(", ") : "—";

      var mode = document.getElementById("InternshipModeId");
      var modeTxt = mode.options[mode.selectedIndex] ? mode.options[mode.selectedIndex].text : "";
      document.getElementById("pfMode").textContent = (modeTxt.indexOf("--") === -1) ? modeTxt : "—";

      var type = document.getElementById("InternshipTimeTypeId");
      var typeTxt = type.options[type.selectedIndex] ? type.options[type.selectedIndex].text : "";
      document.getElementById("pfType").textContent = (typeTxt.indexOf("--") === -1) ? typeTxt : "—";

      var dur = document.getElementById("TrainingDuration");
      var durTxt = dur.options[dur.selectedIndex] ? dur.options[dur.selectedIndex].text : "";
      document.getElementById("pfDuration").textContent = (durTxt.indexOf("--") === -1) ? durTxt : "—";

      var stipend = document.getElementById("InternshipType");
      var stipendTxt = stipend.options[stipend.selectedIndex] ? stipend.options[stipend.selectedIndex].text : "";
      var charges = document.getElementById("TotalCharges").value;
      var stipendOut = (stipendTxt.indexOf("--") === -1) ? stipendTxt : "—";
      if (charges && stipendOut !== "—") stipendOut += " · " + charges;
      document.getElementById("pfStipend").textContent = stipendOut;

      /* completion progress */
      var requiredIds = ["PostPositionId","NoOfRequiredTrainee","GenderRequiredId","MinQualificationId",
        "CountryID","StateID","CityID","ExpectedWorkingHrsPerDayId","InternshipTimeTypeId","WorkingShiftId",
        "InternshipType","TrainingInvolvedId","TrainingDuration","MyPostStartDate","InternshipModeId",
        "DivyangId","compulsaryLanguage"];
      var filled = 0;
      requiredIds.forEach(function(id){
        var el = document.getElementById(id);
        if (el && el.value && el.value.trim() !== "") filled++;
      });
      var pct = Math.round((filled / requiredIds.length) * 100);
      document.getElementById("progressFill").style.width = pct + "%";
      document.getElementById("progressPct").textContent = pct + "% complete";
    }

    document.querySelectorAll("#createPostForm input, #createPostForm select").forEach(function(el){
      el.addEventListener("input", updatePreview);
      el.addEventListener("change", updatePreview);
    });
    updatePreview();
</script>