@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Organization Dashboard";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

<style>
    /* ============================================================
               TOKENS
               ============================================================ */
    :root {
        --ink: #16211c;
        --ink-soft: #46564f;
        --muted: #6c7a73;
        --line: #dbe3de;
        --line-soft: #e9efeb;
        --bg: #eef1ef;
        --surface: #ffffff;
        --primary: #145c4b;
        --primary-dark: #0d3f33;
        --primary-tint: #e5efec;
        --accent: #c98a2b;
        --accent-tint: #f7ecd8;
        --danger: #b3432f;
        --danger-tint: #fbe9e4;
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --shadow-1: 0 1px 2px rgba(15,32,25,.06);
        --shadow-2: 0 10px 30px -12px rgba(13,40,32,.25);
        --font-display: "Fraunces", serif;
        --font-body: "Public Sans", -apple-system, "Segoe UI", sans-serif;
        --font-mono: "IBM Plex Mono", monospace;
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--font-body);
        color: var(--ink);
        background: var(--bg);
        background-image: radial-gradient(circle at 100% 0%, rgba(20,92,75,.06), transparent 40%), radial-gradient(circle at 0% 100%, rgba(201,138,43,.05), transparent 40%);
        line-height: 1.45;
        -webkit-font-smoothing: antialiased;
    }

    a {
        color: inherit;
    }

    ::selection {
        background: var(--primary-tint);
        color: var(--primary-dark);
    }

    /* focus ring, kept visible everywhere */
    :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
    }

    /* ============================================================
               TOPBAR
               ============================================================ */
    .topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        background: var(--primary-dark);
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .topbar-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 14px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .topbar-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: rgba(255,255,255,.75);
    }

        .topbar-brand .mark {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            background: linear-gradient(155deg,var(--accent),#e2b25f);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-dark);
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 14px;
        }

        .topbar-brand strong {
            color: #fff;
            font-family: var(--font-body);
            font-size: 13.5px;
            letter-spacing: .02em;
        }

    .topbar-meta {
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: rgba(255,255,255,.55);
    }

    /* ============================================================
               PAGE HEADER
               ============================================================ */
    .container-fluid {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 28px;
    }

    .page-head {
        padding: 40px 0 28px;
    }

    .breadcrumb {
        list-style: none;
        display: flex;
        gap: 8px;
        margin: 0 0 14px;
        padding: 0;
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .breadcrumb-item {
        position: relative;
        padding-right: 16px;
    }

        .breadcrumb-item::after {
            content: "/";
            position: absolute;
            right: 0;
            color: var(--line);
        }

        .breadcrumb-item:last-child {
            padding-right: 0;
        }

            .breadcrumb-item:last-child::after {
                content: "";
            }

        .breadcrumb-item.active {
            color: var(--primary);
        }

    .page-head h4 {
        margin: 0 0 8px;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 34px;
        letter-spacing: -.01em;
        color: var(--ink);
    }

    .page-head p {
        margin: 0;
        max-width: 560px;
        color: var(--ink-soft);
        font-size: 14.5px;
    }

    /* ============================================================
               LAYOUT: form + sticky preview
               ============================================================ */
    .post-layout {
        display: grid;
        grid-template-columns: minmax(0,1fr) 320px;
        gap: 32px;
        align-items: start;
        padding-bottom: 80px;
    }
    @@media (max-width: 980px) {
        .post-layout {
            grid-template-columns: 1fr;
        }
    }

    /* ============================================================
               SECTIONS (replace bootstrap .row/.card grid)
               ============================================================ */
    .form-section {
        background: var(--surface);
        border: 1px solid var(--line-soft);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-1);
        margin-bottom: 22px;
        overflow: hidden;
    }

    .form-section-head {
        display: flex;
        align-items: baseline;
        gap: 12px;
        padding: 22px 26px 6px;
    }

        .form-section-head .eyebrow {
            font-family: var(--font-mono);
            font-size: 11px;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--primary);
            white-space: nowrap;
        }

        .form-section-head h6 {
            margin: 0;
            font-size: 17px;
            font-weight: 600;
            color: var(--ink);
            padding-bottom: 14px;
            border-bottom: 1px solid var(--line-soft);
            flex: 1;
        }

    .form-section-body {
        padding: 8px 26px 26px;
    }

    /* legacy .row -> responsive field grid */
    .row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
        gap: 18px 20px;
        margin: 0;
    }

        .row + .row {
            margin-top: 18px;
        }

    /* ============================================================
               FIELD "cards" -> clean inputs
               restyle original .card/.card-body/.card-footer classes
               ============================================================ */
    .col-xl-3, .col-md-6 {
        min-width: 0;
    }

    .card {
        background: transparent !important;
        border: none;
        box-shadow: none;
        margin: 0 !important;
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .card-body {
        padding: 0 !important;
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: .02em;
        color: var(--ink-soft);
        text-transform: uppercase;
        font-family: var(--font-mono);
    }

        .card-body span[style] {
            color: var(--danger) !important;
            font-family: var(--font-body);
        }

    .card-footer {
        background: transparent !important;
        border: none !important;
        padding: 0 !important;
    }

    .form-control {
        width: 100%;
        padding: 11px 13px;
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        background: #fbfcfb;
        font-family: var(--font-body);
        font-size: 14.5px;
        color: var(--ink);
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        appearance: none;
    }

    select.form-control {
        background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="14" height="9" viewBox="0 0 14 9"><path d="M1 1l6 6 6-6" stroke="%2346564f" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>');
        background-repeat: no-repeat;
        background-position: right 13px center;
        padding-right: 34px;
    }

    .form-control:hover {
        border-color: #b9c6bf;
    }

    .form-control:focus {
        border-color: var(--primary);
        background: #fff;
        box-shadow: 0 0 0 3px var(--primary-tint);
        outline: none;
    }

    .form-control::placeholder {
        color: #a3aca6;
    }

    .form-control:disabled {
        background: #f1f2f0;
        color: #a3aca6;
        cursor: not-allowed;
    }

    .field-validation-valid {
        display: block;
        min-height: 15px;
        font-size: 12px;
        color: var(--danger);
        font-weight: 500;
    }

    /* ============================================================
               ACCORDIONS (weekly days / facilities / skills)
               ============================================================ */
    .accordion {
        margin: 0;
    }

    .accordion-item {
        border: 1px solid var(--line-soft);
        border-radius: var(--radius-md) !important;
        overflow: hidden;
        margin-bottom: 12px;
        background: #fff;
    }

    .accordion-header {
        margin: 0;
    }

    .accordion-button {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 18px;
        background: #fbfbfa;
        border: none;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
        cursor: pointer;
        text-align: left;
    }

        .accordion-button::after {
            content: "";
            width: 9px;
            height: 9px;
            border-right: 1.6px solid var(--ink-soft);
            border-bottom: 1.6px solid var(--ink-soft);
            transform: rotate(45deg);
            transition: transform .18s ease;
            flex-shrink: 0;
            margin-left: 12px;
        }

        .accordion-button.collapsed::after {
            transform: rotate(-45deg);
        }

        .accordion-button:not(.collapsed) {
            background: var(--primary-tint);
            color: var(--primary-dark);
        }

    .accordion-collapse {
        display: none;
        border-top: 1px solid var(--line-soft);
    }

        .accordion-collapse.show {
            display: block;
        }

    .accordion-body {
        padding: 18px;
    }

        .accordion-body .row {
            grid-template-columns: repeat(auto-fill, minmax(170px,1fr));
            gap: 10px;
        }

        /* pill-style checkbox cards inside accordions */
        .accordion-body .card {
            border: 1px solid var(--line) !important;
            border-radius: 999px;
            padding: 9px 14px !important;
            flex-direction: row;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: border-color .15s ease, background .15s ease;
            background: #fff !important;
        }

            .accordion-body .card:hover {
                border-color: var(--primary);
            }

        .accordion-body .card-body {
            display: flex;
            align-items: center;
            gap: 8px;
            text-transform: none;
            font-family: var(--font-body);
            font-weight: 500;
            font-size: 13.5px;
            color: var(--ink);
            letter-spacing: 0;
        }

        .accordion-body input[type="checkbox"] {
            appearance: none;
            width: 16px;
            height: 16px;
            border: 1.6px solid #b9c6bf;
            border-radius: 4px;
            flex-shrink: 0;
            cursor: pointer;
            position: relative;
            margin: 0;
        }

            .accordion-body input[type="checkbox"]:checked {
                background: var(--primary);
                border-color: var(--primary);
            }

                .accordion-body input[type="checkbox"]:checked::after {
                    content: "";
                    position: absolute;
                    left: 4px;
                    top: 1px;
                    width: 4px;
                    height: 8px;
                    border: solid #fff;
                    border-width: 0 2px 2px 0;
                    transform: rotate(45deg);
                }

                .accordion-body input[type="checkbox"]:checked + * {
                    color: var(--primary-dark);
                }

    /* section title row above each accordion group */
    .skills-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 12px;
    }

        .skills-title h6 {
            margin: 0;
            font-size: 15px;
            font-weight: 600;
            color: var(--ink);
        }

        .skills-title .req {
            color: var(--danger);
            font-size: 13px;
        }

        .skills-title #SkillError, .skills-title #WorkingDaysError {
            font-family: var(--font-mono);
            font-size: 11.5px;
        }

    /* ============================================================
               PREVIEW PANEL — signature element
               ============================================================ */
    .preview-panel {
        position: sticky;
        top: 84px;
    }

    .preview-card {
        background: var(--primary-dark);
        color: #fff;
        border-radius: var(--radius-lg);
        padding: 26px 24px 22px;
        box-shadow: var(--shadow-2);
        position: relative;
        overflow: hidden;
    }

        .preview-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 100% 0%, rgba(201,138,43,.25), transparent 55%);
            pointer-events: none;
        }

    .preview-tag {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 10px;
        display: block;
    }

    .preview-role {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 23px;
        line-height: 1.15;
        margin: 0 0 14px;
        min-height: 29px;
    }

        .preview-role .placeholder {
            color: rgba(255,255,255,.4);
            font-weight: 500;
        }

    .preview-facts {
        list-style: none;
        margin: 0 0 18px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

        .preview-facts li {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            font-size: 13px;
            color: rgba(255,255,255,.85);
            border-bottom: 1px dashed rgba(255,255,255,.15);
            padding-bottom: 9px;
        }

            .preview-facts li span:first-child {
                color: rgba(255,255,255,.55);
                font-family: var(--font-mono);
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .04em;
            }

            .preview-facts li span:last-child {
                text-align: right;
                font-weight: 500;
            }

    .preview-progress {
        margin-top: 6px;
    }

    .preview-progress-bar {
        height: 5px;
        border-radius: 99px;
        background: rgba(255,255,255,.14);
        overflow: hidden;
    }

    .preview-progress-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg,var(--accent),#e7bd75);
        transition: width .3s ease;
    }

    .preview-progress-label {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: .04em;
        color: rgba(255,255,255,.55);
        margin-top: 8px;
    }

    .preview-help {
        margin-top: 16px;
        background: var(--surface);
        border: 1px solid var(--line-soft);
        border-radius: var(--radius-md);
        padding: 16px 16px;
        font-size: 12.5px;
        color: var(--ink-soft);
    }

        .preview-help strong {
            display: block;
            font-size: 13px;
            color: var(--ink);
            margin-bottom: 4px;
        }

    /* ============================================================
               SUBMIT BAR
               ============================================================ */
    .MyButton {
        margin-top: 6px;
    }

    .button {
        padding: 0 !important;
    }

    #submitButton {
        appearance: none;
        border: none;
        cursor: pointer;
        background: var(--primary);
        color: #fff;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 15px;
        letter-spacing: .01em;
        padding: 15px 34px;
        border-radius: var(--radius-sm);
        box-shadow: 0 8px 20px -8px rgba(20,92,75,.55);
        transition: background .15s ease, transform .1s ease;
    }

        #submitButton:hover {
            background: var(--primary-dark);
        }

        #submitButton:active {
            transform: translateY(1px);
        }

    .submit-row {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding-top: 6px;
    }

    .submit-note {
        font-size: 12.5px;
        color: var(--muted);
        max-width: 420px;
    }

    /* required marker consistency */
    .req-mark {
        color: var(--danger);
        margin-left: 2px;
    }
</style>

<div class="topbar">
    <div class="topbar-inner">
        <div class="topbar-brand">
            <span class="mark">it</span>
            <strong>Organization Console</strong>
        </div>
        <div class="topbar-meta">POST&nbsp;ID&nbsp;·&nbsp;it6848070164736</div>
    </div>
</div>

<form action="/OrgCreatePost/OrgCreateNewPost/it6848070164736" enctype="multipart/form-data" method="post" onsubmit="return validateMyForm();" id="createPostForm">
    <div class="container-fluid">

        <div class="page-head">
            <ol class="breadcrumb mb-4">
                <li class="breadcrumb-item">Post details</li>
                <li class="breadcrumb-item active">it6848070164736</li>
            </ol>
            <h4 class="mt-4">Create new post</h4>
            <p>Publish an internship or traineeship opening. Fields marked <span class="req-mark">*</span> are required before this post can go live.</p>
        </div>

        <div class="post-layout">
            <div class="post-main">

                <!-- ROLE BASICS -->
                <section class="form-section">
                    <div class="form-section-head">
