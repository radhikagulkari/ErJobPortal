                                </div>
                                <span class="field-validation-valid text-danger" data-valmsg-for="NoOfRequiredTrainee" data-valmsg-replace="true"></span>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="card">
                                    <div class="card-body">Gender <span style="color:red">&nbsp;*</span></div>
                                    <div class="card-footer d-flex align-items-center justify-content-between">
                                        <select class="form-control" data-val="true" data-val-number="The field GenderRequiredId must be a number." data-val-required="This field is required" id="GenderRequiredId" name="GenderRequiredId" oninput="updatePreview()">
                                            <option value=""> -- Select a Gender -- </option>
                                            <option value="1">Male</option>
                                            <option value="2">Female</option>
                                            <option value="3">Other</option>
                                            <option value="4">Any</option>
                                        </select>
                                    </div>
                                </div>
                                <span class="field-validation-valid text-danger" data-valmsg-for="GenderRequiredId" data-valmsg-replace="true"></span>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="card">
                                    <div class="card-body">Minimum qualification <span style="color:red">&nbsp;*</span></div>
                                    <div class="card-footer d-flex align-items-center justify-content-between">
                                        <select class="form-control" data-val="true" data-val-number="The field MinQualificationId must be a number." data-val-required="This field is required" id="MinQualificationId" name="MinQualificationId">
                                            <option value=""> -- Select Minimum Qualification -- </option>
                                            <option value="1">SSC / 10th</option>
                                            <option value="2">HSC / Diploma</option>
                                            <option value="3">Under Graduate</option>
                                            <option value="4">Graduate</option>
                                            <option value="5">PG Diploma</option>
                                            <option value="6">Post Graduate</option>
                                            <option value="7">PhD</option>
                                        </select>
                                    </div>
                                </div>
                                <span class="field-validation-valid text-danger" data-valmsg-for="MinQualificationId" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- LOCATION -->
                <section class="form-section">
                    <div class="form-section-head">
                        <span class="eyebrow">02 · Location</span>
                        <h6>Where the work happens</h6>
                    </div>
                    <div class="form-section-body">
                        <div class="row">
                            <div class="col-xl-3 col-md-6">
