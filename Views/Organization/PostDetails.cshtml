@model IEnumerable<JobPortalTrainee.Models.OrgPostM>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "All Post Details";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    .page-title {
        margin: 25px 18px 4px;
        font-size: 21px;
        font-weight: 600;
    }

    .page-subtitle {
        margin-left: 18px;
        color: #999;
        margin-bottom: 22px;
    }

    .post-box {
        margin: 0 18px;
        border: 1px solid #ddd;
        border-radius: 5px;
        overflow: hidden;
    }

    .post-header {
        padding: 9px 14px;
        background: #f7f7f7;
        border-bottom: 1px solid #ddd;
    }

        .post-header i {
            margin-right: 8px;
        }

    .table-area {
        padding: 20px 14px;
        overflow-x: auto;
    }

    #postTable {
        width: 100% !important;
        table-layout: auto;
    }

        #postTable th,
        #postTable td {
            text-align: center;
            vertical-align: middle;
            font-size: 13px;
            padding: 10px 8px;
        }

        #postTable th {
            white-space: normal;
            font-weight: 600;
            line-height: 1.4;
        }

        #postTable td {
            white-space: nowrap;
        }

    .action {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

        .action a {
            color: #1677ff;
            text-decoration: none;
            font-size: 15px;
        }

            .action a:hover {
                color: #0056d6;
            }

    .location {
        line-height: 1.5;
        white-space: normal;
    }

    .days {
        line-height: 1.5;
        white-space: normal;
    }

    .trainee {
        color: #1677ff;
        text-decoration: none;
    }

        .trainee:hover {
            text-decoration: underline;
        }

    .wifi {
        font-size: 22px;
        cursor: pointer;
    }

    .status-form {
        margin: 0;
        padding: 0;
        display: inline-block;
    }

    .status {
        color: white;
        padding: 7px 12px;
        border: none;
        border-radius: 6px;
        display: inline-block;
        font-size: 12px;
        cursor: pointer;
        min-width: 75px;
    }

    .enabled {
        background: #198754;
    }

    .disabled {
        background: #dc3545;
    }

    .status:hover {
        opacity: 0.9;
    }

</style>


<h2 class="page-title">
    All Post Details
</h2>

<div class="page-subtitle">
    At73803469839
</div>


<div class="post-box">

    <div class="post-header">

        <i class="fa-solid fa-table"></i>

        Post Details

    </div>


    <div class="table-area">

        <table id="postTable"
               class="display">

            <thead>

                <tr>

                    <th>Sr.<br />No</th>

                    <th>Post<br />Creation<br />Date</th>

                    <th>Position</th>

                    <th>Action</th>

                    <th>No. of<br />Required<br />Trainee</th>

                    <th>Eligible<br />Trainee</th>

                    <th>Gender</th>

                    <th>Minimum<br />Qualification</th>

                    <th>Location</th>

                    <th>Working<br />Hours Per<br />Day</th>

                    <th>Weekly Working<br />Days</th>

                    <th>Internship<br />Type</th>

                    <th>Internship / Fellowship<br />Type</th>

                    <th>Training<br />Involved</th>

                    <th>Internship<br />Duration</th>

                    <th>Facilities<br />Available</th>

                    <th>Internship<br />Mode</th>

                    <th>Divyang<br />Allowed</th>

                    <th>Status</th>

                </tr>

            </thead>


            <tbody>

                @{
                    int srNo = 1;
                }

                @foreach (var item in Model)
                {
                    <tr>

                        <!-- Sr. No -->
                        <td>
                            @srNo
                        </td>


                        <!-- Post Creation Date -->
                        <td>
                            @(item.dRegisterDate.HasValue
                                                    ? item.dRegisterDate.Value.ToString("dd-MM-yyyy")
                                                    : "")
                        </td>


                        <!-- Position -->
                        <td>
                            @item.sPositionName
                        </td>


                     @*    <!-- Action radhika22-09--> *@
                        <td>

                            <div class="action">

                                <a asp-action="ViewOrgPost"
                                   asp-route-id="@item.nID"
                                   title="View">

                                    <i class="fa-solid fa-eye"></i>

                                </a>

                                <a asp-action="EditPost"
                                   asp-route-id="@item.nID"
                                   title="Edit">

                                    <i class="fa-solid fa-pen-to-square"></i>

                                </a>

                            </div>

                        </td>


                        <!-- Required Trainees -->
                        <td>
                            @item.nRequiredTrainees
                        </td>


                        <!-- Eligible Trainee -->
                        <td>

                            <a href="#"
                               class="trainee">

                                @item.nRequiredTrainees

                            </a>

                        </td>


                        <!-- Gender -->
                        <td>
                            @item.sGenderName
                        </td>


                        <!-- Minimum Qualification -->
                        <td>
                            @item.sMinimumQualificationName
                        </td>


                        <!-- Location -->
                        <td>

                            <div class="location">

                                @item.sCountryCode
                                <br />

                                @item.sStateCode
                                <br />

                                @item.sCityName

                            </div>

                        </td>


                        <!-- Working Hours -->
                        <td>
                            @item.sWorkingHours
                        </td>


                        <!-- Working Days -->
                        <td>

                            <div class="days">
                                @item.sWorkingDays
                            </div>

                        </td>


                        <!-- Internship Type -->
                        <td>
                            @item.sInternshipTypeName
                        </td>


                        <!-- Internship Fellowship Type -->
                        <td>
                            @item.sInternshipFellowshipTypeName
                        </td>


                        <!-- Training Involved -->
                        <td>
                            @item.sTrainingInvolvedName
                        </td>


                        <!-- Internship Duration -->
                        <td>
                            @item.sInternshipDurationName
                        </td>


                        <!-- Facilities -->
                        <td>

                            @if (!string.IsNullOrWhiteSpace(item.sFacilities))
                            {
                                <i class="fa-solid fa-wifi wifi"
                                   title="@item.sFacilities">
                                </i>
                            }
                            else
                            {
                                <span>-</span>
                            }

                    </td>


                    <!-- Internship Mode -->
                    <td>
                        @item.sInternshipModeName
                    </td>


                    <!-- Divyang -->
                    <td>

                        @(string.IsNullOrWhiteSpace(item.sDivyang)
                                                ? "No"
                                                : item.sDivyang)

                        </td>


                        <!-- Status -->
                        <td>

                            @if (item.nBit)
                            {
                                <form asp-action="DisablePost"
                                      method="post"
                                      class="status-form">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.nID" />

                                    <button type="submit"
                                            class="status enabled">
                                        Enabled
                                    </button>

                                </form>
                            }
                            else
                            {
                                <form asp-action="EnablePost"
                                      method="post"
                                      class="status-form">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.nID" />

                                    <button type="submit"
                                            class="status disabled">
                                        Disabled
                                    </button>

                                </form>
                            }

                        </td>

                    </tr>

                    srNo++;
                }

            </tbody>

        </table>

    </div>

</div>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>


<script>

    $(document).ready(function () {

    $('#postTable').DataTable({

    pageLength: 25,

    searching: true,

    ordering: true,

    paging: true,

    info: true,

    autoWidth: false,

    scrollX: true

    });

    });

</script>