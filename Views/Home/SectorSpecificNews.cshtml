<!-- =========================================================
     SCROLL REVEAL JAVASCRIPT
     ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const revealElements =
            document.querySelectorAll(
                ".sector-news-page .sector-news-scroll-reveal"
            );

        const rightElement =
            document.querySelector(
                ".sector-news-page .sector-news-scroll-right"
            );


        /* =====================================================
           INTERSECTION OBSERVER
           ===================================================== */

        const observer =
            new IntersectionObserver(
                function (entries) {

                    entries.forEach(function (entry) {

                        if (entry.isIntersecting) {

                            entry.target.classList.add("show");

                        }
                        else {

                            /*
                             * Remove this line if you want the
                             * animation to happen only once.
                             */

                            entry.target.classList.remove("show");

                        }

                    });

                },
                {
                    threshold: 0.15,
                    rootMargin: "0px 0px -50px 0px"
                }
            );


        /* =====================================================
           OBSERVE LEFT SECTIONS
           ===================================================== */

        revealElements.forEach(function (element) {

            observer.observe(element);

        });


        /* =====================================================
           RIGHT SIDE OBSERVER
           ===================================================== */

        if (rightElement) {

            const rightObserver =
                new IntersectionObserver(
                    function (entries) {

                        entries.forEach(function (entry) {

                            if (entry.isIntersecting) {

                                entry.target.classList.add("show");

                            }
                            else {

                                entry.target.classList.remove("show");

                            }

                        });

                    },
                    {
                        threshold: 0.10
                    }
                );


            rightObserver.observe(rightElement);

        }

    });

</script>