                        <p>
                            Design and create software applications,
                            platforms and digital systems.
                        </p>
                    </div>


                    <div class="career-card">
                        <div class="career-card-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <h4>Data Scientist / Analyst</h4>
                        <p>
                            Analyze data and transform information
                            into useful business insights.
                        </p>
                    </div>


                    <div class="career-card">
                        <div class="career-card-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <h4>Cybersecurity Specialist</h4>
                        <p>
                            Protect systems, applications and
                            networks from cyber threats.
                        </p>
                    </div>


                    <div class="career-card">
                        <div class="career-card-icon">
                            <i class="fa-solid fa-network-wired"></i>
                        </div>
                        <h4>IT Consultant</h4>
                        <p>
                            Help organizations use technology
                            to achieve business objectives.
                        </p>
                    </div>


                    <div class="career-card">
                        <div class="career-card-icon">
                            <i class="fa-solid fa-cloud"></i>
                        </div>
                        <h4>Cloud Engineer</h4>
                        <p>
                            Manage cloud infrastructure, services
                            and scalable digital environments.
                        </p>
                    </div>

                </div>

            </div>


            <!-- =================================================
                 ENGINEERING
            ================================================== -->

            <div class="career-category">

                <div class="career-category-header">

                    <div class="career-category-icon">
                        <i class="fa-solid fa-gears"></i>
                    </div>

                    <div>
                        <h3>Engineering</h3>
                        <span>Design, build and solve real-world problems</span>
                    </div>

                </div>


                <div class="career-grid">

                    <div class="career-card">
                        <div class="career-card-icon">
                            <i class="fa-solid fa-gears"></i>
                        </div>
