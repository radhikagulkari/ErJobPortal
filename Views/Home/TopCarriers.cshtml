        .top-careers-container {
            padding: 0 11px;
        }

        .careers-hero {
            padding: 29px 16px;
            border-radius: 15px;
        }

        .careers-badge {
            font-size: 10px;
            padding: 6px 10px;
        }

        .careers-hero h1 {
            font-size: 22px;
        }

        .careers-hero p {
            font-size: 11.5px;
        }

        .career-intro h2 {
            font-size: 19px;
        }

        .career-intro p {
            font-size: 11.5px;
        }

        .career-category-header {
            align-items: flex-start;
        }

        .career-category-icon {
            width: 34px;
            height: 34px;
            flex-basis: 34px;
            font-size: 14px;
        }

        .career-category-header h3 {
