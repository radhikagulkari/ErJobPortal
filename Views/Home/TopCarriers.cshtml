<style>
    /* =========================================================
           1TRAINEE - TOP CAREERS PAGE
           ========================================================= */

    .top-careers-page {
        width: 100%;
        background: #f7faf9;
        color: #172033;
        padding: 55px 0 70px;
        margin-top: 120px;
    }

    .top-careers-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* =========================================================
           HERO
           ========================================================= */

    .careers-hero {
        position: relative;
        overflow: hidden;
        text-align: center;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        border-radius: 22px;
        padding: 48px 30px;
        margin-bottom: 42px;
        box-shadow: 0 15px 35px rgba(13, 148, 136, .14);
    }

        .careers-hero::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            right: -80px;
            top: -100px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }

        .careers-hero::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            left: -60px;
            bottom: -80px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
        }

    .careers-hero-content {
        position: relative;
        z-index: 2;
        max-width: 760px;
        margin: auto;
    }

    .careers-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        margin-bottom: 14px;
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 30px;
        background: rgba(255,255,255,.10);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
    }

        .careers-badge i {
            font-size: 11px;
        }

    .careers-hero h1 {
        margin: 0 0 12px;
        color: #fff;
        font-size: 32px;
        font-weight: 750;
        line-height: 1.25;
    }

    .careers-hero p {
        max-width: 680px;
        margin: auto;
        color: rgba(255,255,255,.86);
        font-size: 14px;
        line-height: 1.7;
    }

    /* =========================================================
           INTRO
           ========================================================= */

    .career-intro {
        max-width: 800px;
        margin: 0 auto 38px;
        text-align: center;
    }

        .career-intro h2 {
            margin: 0 0 8px;
            color: #172033;
            font-size: 24px;
            font-weight: 700;
        }

        .career-intro p {
            margin: 0;
            color: #667085;
            font-size: 13.5px;
            line-height: 1.7;
        }

    /* =========================================================
           CAREER CATEGORY
           ========================================================= */

    .career-category {
        margin-bottom: 28px;
    }

    .career-category-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 14px;
    }

    .career-category-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .career-category-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #e7f6f3;
        color: #0d9488;
        font-size: 16px;
    }

    .career-category-header h3 {
        margin: 0;
        color: #172033;
        font-size: 18px;
        font-weight: 700;
    }

    .career-count {
        padding: 5px 10px;
        border-radius: 20px;
        background: #edf8f6;
        color: #0d9488;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* =========================================================
           CAREER GRID
           ========================================================= */

    .career-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .career-item {
        position: relative;
        min-height: 105px;
        padding: 17px 18px;
        background: #fff;
        border: 1px solid #e7eceb;
        border-radius: 13px;
        box-shadow: 0 4px 16px rgba(15, 42, 39, .045);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        overflow: hidden;
    }

        .career-item::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 3px;
            height: 0;
            background: #0d9488;
            border-radius: 0 0 4px 0;
            transition: height .25s ease;
        }

        .career-item:hover {
            transform: translateY(-3px);
            border-color: #cde8e4;
            box-shadow: 0 10px 25px rgba(13, 148, 136, .10);
        }

            .career-item:hover::before {
                height: 100%;
            }

    .career-item-top {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 7px;
    }

    .career-item-icon {
        width: 29px;
        height: 29px;
        flex: 0 0 29px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #f0f9f7;
        color: #0d9488;
        font-size: 12px;
    }

    .career-item h4 {
        margin: 0;
        color: #263238;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.35;
    }

    .career-item p {
        margin: 0;
        padding-left: 38px;
        color: #727b87;
        font-size: 12px;
        line-height: 1.55;
    }

    /* =========================================================
           BOTTOM NOTE
           ========================================================= */

    .career-note {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-top: 38px;
        padding: 20px 22px;
        border: 1px solid #dcecea;
        border-radius: 15px;
        background: #eef9f7;
    }

    .career-note-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #0d9488;
        color: #fff;
        font-size: 15px;
    }

    .career-note h4 {
        margin: 0 0 4px;
        color: #155e59;
        font-size: 15px;
        font-weight: 700;
    }

    .career-note p {
        margin: 0;
        color: #667c79;
        font-size: 12.5px;
        line-height: 1.6;
    }

    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 991px) {

        .top-careers-page {
            padding: 45px 0 60px;
        }

        .careers-hero {
            padding: 42px 25px;
            margin-bottom: 35px;
        }

            .careers-hero h1 {
                font-size: 29px;
            }

        .career-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 767px) {

        .top-careers-page {
            padding: 30px 0 45px;
        }

        .top-careers-container {
            padding: 0 14px;
        }

        .careers-hero {
            padding: 34px 18px;
            border-radius: 17px;
            margin-bottom: 30px;
        }

            .careers-hero h1 {
                font-size: 25px;
            }

            .careers-hero p {
                font-size: 12.5px;
                line-height: 1.6;
            }

        .career-intro {
            margin-bottom: 28px;
        }

            .career-intro h2 {
                font-size: 21px;
            }

            .career-intro p {
                font-size: 12.5px;
            }

        .career-category-header h3 {
            font-size: 16px;
        }

        .career-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .career-item {
            min-height: auto;
        }

        .career-note {
            padding: 17px;
        }
    }

    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 480px) {

        .top-careers-page {
            padding: 25px 0 40px;
