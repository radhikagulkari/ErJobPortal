<!-- ============================================================= -->
<!-- CAREER TRENDS SCROLL ANIMATION -->
<!-- ============================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const careerElements = document.querySelectorAll(
            ".career-page .career-scroll-reveal, " +
            ".career-page .career-scroll-right"
        );

        const careerObserver = new IntersectionObserver(
            function (entries) {

                entries.forEach(function (entry) {

                    if (entry.isIntersecting) {

                        entry.target.classList.add("show");

                    }
                    else {

                        entry.target.classList.remove("show");

                    }

                });

            },
            {
                threshold: 0.15
            }
        );


        careerElements.forEach(function (element) {

            careerObserver.observe(element);

        });

    });

</script>