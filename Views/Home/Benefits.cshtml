@*
    1Trainee - Benefits for Organizations
    Enhanced visual pass: refined type scale, richer hero, connecting
    process track, scroll-reveal, fluid responsive grids.
*@

@{
    ViewData["Title"] = "Benefits for Organizations";
}

<style>

    /* =========================================================
               TOKENS
            ========================================================= */

    .benefits-page {
        --teal-50: #f7fbfa;
        --teal-100: #e7f7f4;
        --teal-200: #dff4f0;
        --teal-300: #b8ddd8;
        --teal-500: #0d9488;
        --teal-600: #0f766e;
        --teal-700: #115e59;
        --ink: #172033;
        --ink-muted: #667085;
        --line: #e5efed;
        width: 100%;
        background: var(--teal-50);
        color: var(--ink);
        overflow: hidden;
    }

        .benefits-page * {
            box-sizing: border-box;
        }


        /* =========================================================
               SHARED
            ========================================================= */

        .benefits-page .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            color: var(--teal-500);
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.3px;
        }

            .benefits-page .eyebrow::before {
                content: "";
                width: 22px;
                height: 2px;
                border-radius: 2px;
                background: var(--teal-500);
            }

    .benefits-section-heading {
        max-width: 780px;
        margin: 0 auto 48px;
        text-align: center;
    }

        .benefits-section-heading h2 {
            margin: 0;
            color: var(--ink);
            font-size: clamp(24px, 3.4vw, 34px);
            line-height: 1.3;
            font-weight: 800;
            letter-spacing: -.4px;
        }

        .benefits-section-heading p {
            margin: 14px auto 0;
            max-width: 620px;
            color: var(--ink-muted);
            font-size: 15px;
            line-height: 1.8;
        }

    /* scroll reveal */
    .reveal {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity .7s ease, transform .7s ease;
    }

        .reveal.in-view {
            opacity: 1;
            transform: translateY(0);
        }

    @@media (prefers-reduced-motion: reduce) {
        .reveal {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    .benefits-page a:focus-visible,
    .benefits-page button:focus-visible {
        outline: 2px solid var(--teal-600);
        outline-offset: 3px;
    }


    /* =========================================================
               HERO
            ========================================================= */

    .benefits-hero {
        position: relative;
        padding: 100px 20px 110px;
        background: radial-gradient(120% 140% at 15% 0%, #14b8a6 0%, #0d9488 32%, #0f766e 62%, #114e4a 100%);
        overflow: hidden;
        margin-top:160px;
        border-radius:30px
    }

        .benefits-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.14) 1.4px, transparent 1.4px);
            background-size: 26px 26px;
            mask-image: radial-gradient(circle at 50% 30%, rgba(0,0,0,.55), transparent 72%);
            -webkit-mask-image: radial-gradient(circle at 50% 30%, rgba(0,0,0,.55), transparent 72%);
        }

        .benefits-hero::after {
            content: "";
            position: absolute;
            width: 460px;
            height: 460px;
            right: -160px;
            top: -190px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }

    .benefits-hero-glow {
        position: absolute;
        width: 300px;
        height: 300px;
        left: -130px;
        bottom: -160px;
        border-radius: 50%;
        background: rgba(255,255,255,.06);
    }

    .benefits-hero-content {
        position: relative;
        z-index: 2;
        max-width: 860px;
        margin: auto;
        text-align: center;
    }

    .benefits-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        margin-bottom: 22px;
        border: 1px solid rgba(255,255,255,.28);
        border-radius: 30px;
        background: rgba(255,255,255,.12);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: .3px;
        backdrop-filter: blur(8px);
    }

        .benefits-badge i {
            color: #ccfbf1;
        }

    .benefits-hero h1 {
        margin: 0;
        color: #fff;
        font-size: clamp(30px, 5vw, 50px);
        line-height: 1.14;
        font-weight: 800;
        letter-spacing: -1px;
    }

        .benefits-hero h1 span {
            color: #99f6e4;
        }

    .benefits-hero p {
        max-width: 700px;
        margin: 18px auto 0;
        color: rgba(255,255,255,.88);
        font-size: 17px;
        line-height: 1.8;
    }

    .benefits-hero-actions {
        display: flex;
        justify-content: center;
        gap: 14px;
        margin-top: 34px;
        flex-wrap: wrap;
    }

    .benefits-hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 24px;
        border-radius: 10px;
        background: #fff;
        color: var(--teal-600);
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .benefits-hero-btn i {
            transition: transform .25s ease;
        }

        .benefits-hero-btn:hover {
            color: var(--teal-600);
            transform: translateY(-3px);
            box-shadow: 0 14px 30px rgba(0,0,0,.18);
        }

            .benefits-hero-btn:hover i {
                transform: translateX(3px);
            }

        .benefits-hero-btn.ghost {
            background: rgba(255,255,255,.08);
            color: #fff;
            border: 1px solid rgba(255,255,255,.4);
        }

            .benefits-hero-btn.ghost:hover {
                background: rgba(255,255,255,.16);
                box-shadow: none;
            }


    /* =========================================================
               MAIN BENEFITS
            ========================================================= */

    .benefits-intro {
        padding: 90px 20px 30px;
    }

    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 22px;
        max-width: 1150px;
        margin: auto;
    }

    .benefit-card {
        position: relative;
        min-height: 245px;
        padding: 30px 26px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(15,42,39,.055);
        overflow: hidden;
        transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease, border-color .35s ease;
    }

        .benefit-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--teal-500), #5eead4);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .35s ease;
        }

        .benefit-card:hover {
            transform: translateY(-8px);
            border-color: var(--teal-300);
            box-shadow: 0 20px 42px rgba(13,148,136,.14);
        }

            .benefit-card:hover::before {
                transform: scaleX(1);
            }

    .benefit-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border-radius: 14px;
        background: var(--teal-100);
        color: var(--teal-500);
        font-size: 21px;
        transition: .35s ease;
    }

    .benefit-card:hover .benefit-icon {
        background: var(--teal-500);
        color: #fff;
        transform: scale(1.08) rotate(-4deg);
    }

    .benefit-card h3 {
        margin: 0 0 10px;
        color: var(--ink);
        font-size: 18px;
        font-weight: 750;
    }

    .benefit-card p {
        margin: 0;
        color: var(--ink-muted);
        font-size: 14px;
        line-height: 1.75;
    }


    /* =========================================================
               PROGRAM SECTION
            ========================================================= */

    .program-section {
        padding: 100px 20px;
        background: #fff;
    }

    .program-layout {
        max-width: 1150px;
        margin: auto;
        display: grid;
        grid-template-columns: minmax(260px, .85fr) minmax(300px, 1.15fr);
        gap: 60px;
        align-items: center;
    }

    .program-content h2 {
        margin: 0 0 16px;
        color: var(--ink);
        font-size: clamp(24px, 3.4vw, 34px);
        line-height: 1.3;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .program-content > p {
        margin: 0;
        color: var(--ink-muted);
        font-size: 15px;
        line-height: 1.8;
    }

    .program-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
    }

    .program-item {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 18px;
        background: var(--teal-50);
        border: 1px solid #e4efed;
        border-radius: 13px;
        transition: .3s ease;
    }

        .program-item:hover {
            background: var(--teal-200);
            border-color: var(--teal-300);
            transform: translateY(-3px);
        }

    .program-check {
        flex: 0 0 32px;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: var(--teal-500);
        color: #fff;
        font-size: 12px;
    }

    .program-item strong {
        display: block;
        margin-bottom: 4px;
        color: #344054;
        font-size: 14px;
    }

    .program-item p {
        margin: 0;
        color: var(--ink-muted);
        font-size: 12.5px;
        line-height: 1.55;
    }


    /* =========================================================
               PROCESS SECTION (connected track)
            ========================================================= */

    .process-section {
        padding: 95px 20px;
        background: var(--teal-50);
    }

    .process-track {
        position: relative;
        max-width: 1150px;
        margin: auto;
    }

        .process-track::before {
            content: "";
            position: absolute;
            top: 19px;
            left: 10%;
            right: 10%;
            height: 2px;
            background: repeating-linear-gradient(90deg, var(--teal-300) 0 10px, transparent 10px 18px);
        }

    .process-grid {
        position: relative;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 18px;
    }

    .process-card {
        position: relative;
        padding: 26px 18px;
        text-align: center;
        background: #fff;
        border: 1px solid #e3ecea;
        border-radius: 16px;
        box-shadow: 0 7px 22px rgba(15,42,39,.045);
        transition: .3s ease;
    }

        .process-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 18px 34px rgba(13,148,136,.13);
            border-color: var(--teal-300);
        }

    .process-number {
        width: 38px;
        height: 38px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--teal-500);
        color: #fff;
        font-size: 13px;
        font-weight: 800;
        box-shadow: 0 0 0 5px var(--teal-50);
    }

    .process-card h3 {
        margin: 0 0 8px;
        color: var(--ink);
        font-size: 15px;
        font-weight: 700;
    }

    .process-card p {
        margin: 0;
        color: var(--ink-muted);
        font-size: 12px;
        line-height: 1.6;
    }


    /* =========================================================
               ATTRACT TALENT
            ========================================================= */

    .talent-section {
        padding: 100px 20px;
        background: #fff;
    }

    .talent-grid {
        max-width: 1150px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 18px;
    }

    .talent-card {
        padding: 26px 22px;
        border-radius: 15px;
        background: var(--teal-50);
        border: 1px solid var(--line);
        transition: .3s ease;
    }

        .talent-card:hover {
            background: var(--teal-200);
            border-color: var(--teal-300);
            transform: translateY(-5px);
        }

        .talent-card i {
            display: inline-flex;
            width: 44px;
            height: 44px;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            border-radius: 11px;
            background: var(--teal-200);
            color: var(--teal-500);
            transition: .3s ease;
        }

        .talent-card:hover i {
            background: var(--teal-500);
            color: #fff;
        }

        .talent-card h3 {
            margin: 0 0 8px;
            color: var(--ink);
            font-size: 15px;
            font-weight: 700;
        }

        .talent-card p {
            margin: 0;
            color: var(--ink-muted);
            font-size: 12.5px;
            line-height: 1.65;
        }


    /* =========================================================
               MEASUREMENT
            ========================================================= */

    .measurement-section {
        padding: 100px 20px;
        background: var(--teal-50);
    }

    .measurement-grid {
        max-width: 1150px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 18px;
    }

    .measurement-card {
        padding: 28px 20px;
        background: #fff;
        border: 1px solid #e4eeec;
        border-radius: 15px;
        text-align: center;
        transition: .3s ease;
    }

        .measurement-card:hover {
            transform: translateY(-6px);
            border-color: var(--teal-300);
            box-shadow: 0 14px 30px rgba(13,148,136,.1);
        }

        .measurement-card i {
            display: flex;
            width: 46px;
            height: 46px;
            margin: 0 auto 14px;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background: var(--teal-100);
            color: var(--teal-500);
            font-size: 17px;
        }

        .measurement-card h3 {
            margin: 0;
            color: var(--ink);
            font-size: 14px;
            font-weight: 700;
        }


    /* =========================================================
               FINAL CTA
            ========================================================= */

    .benefits-cta {
        position: relative;
        padding: 85px 20px;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        overflow: hidden;
    }

        .benefits-cta::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.12) 1.4px, transparent 1.4px);
            background-size: 24px 24px;
            mask-image: radial-gradient(circle at 50% 30%, rgba(0,0,0,.5), transparent 75%);
            -webkit-mask-image: radial-gradient(circle at 50% 30%, rgba(0,0,0,.5), transparent 75%);
        }

    .benefits-cta-inner {
        position: relative;
        z-index: 2;
        max-width: 850px;
        margin: auto;
        text-align: center;
    }

    .benefits-cta h2 {
        margin: 0;
        color: #fff;
        font-size: clamp(24px, 3.6vw, 34px);
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .benefits-cta p {
        max-width: 650px;
        margin: 14px auto 28px;
        color: rgba(255,255,255,.85);
        font-size: 15px;
        line-height: 1.7;
    }

    .benefits-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 26px;
        border-radius: 10px;
        background: #fff;
        color: var(--teal-500);
        font-size: 14.5px;
        font-weight: 700;
        text-decoration: none;
        transition: .3s ease;
    }

        .benefits-cta-btn i {
            transition: transform .25s ease;
        }

        .benefits-cta-btn:hover {
            color: var(--teal-500);
            transform: translateY(-3px);
            box-shadow: 0 14px 30px rgba(0,0,0,.18);
        }

            .benefits-cta-btn:hover i {
                transform: translateX(3px);
            }


    /* =========================================================
               TABLET
            ========================================================= */

    @@media (max-width: 991px) {

        .benefits-hero {
            padding: 78px 20px 90px;
        }

        .program-layout {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .process-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .process-track::before {
            display: none;
        }

        .measurement-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }


    /* =========================================================
               MOBILE
            ========================================================= */

    @@media (max-width: 767px) {

        .benefits-hero {
            padding: 60px 16px 72px;
        }

            .benefits-hero p {
                font-size: 14px;
            }

        .benefits-intro,
        .program-section,
        .process-section,
        .talent-section,
        .measurement-section {
            padding: 64px 16px;
        }

        .benefit-card {
            min-height: auto;
            padding: 24px;
        }

        .process-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .measurement-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .benefits-hero-actions {
            flex-direction: column;
            align-items: center;
        }

        .benefits-hero-btn {
            width: 100%;
            max-width: 320px;
            justify-content: center;
        }
    }


    /* =========================================================
               SMALL MOBILE
            ========================================================= */

    @@media (max-width: 450px) {

        .process-grid {
            grid-template-columns: 1fr;
        }

        .measurement-grid {
            grid-template-columns: 1fr;
        }

        .benefits-badge {
            font-size: 11px;
        }
    }

</style>


<div class="benefits-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="benefits-hero">

        <div class="benefits-hero-glow"></div>

        <div class="benefits-hero-content">

            <div class="benefits-badge">
                <i class="fa-solid fa-building"></i>
                Benefits for Organizations
            </div>

            <h1>
                Unlock the Potential of <span>Your Organization</span>
            </h1>

            <p>
                Discover how hosting trainees and interns through
                1Trainee can help  organization build talent,
                improve productivity, encourage innovation and
                create a stronger future workforce.
            </p>

            <div class="benefits-hero-actions">

                <a asp-controller="Account"
                   asp-action="OrganizationRegister"
                   class="benefits-hero-btn">
                    Register Your Organization
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <a href="#benefits-grid" class="benefits-hero-btn ghost">
                    See the Benefits
                </a>

            </div>

        </div>

    </section>


    <!-- =====================================================
         MAIN BENEFITS
    ====================================================== -->

    <section class="benefits-intro" id="benefits-grid">

        <div class="benefits-section-heading reveal">

            <span class="eyebrow">Why Host Trainees?</span>

            <h2>
                Turn Fresh Talent Into Organizational Growth
            </h2>

            <p>
                Hosting interns is more than providing an opportunity
                to students. A structured internship program can become
                a valuable talent and business strategy for  organization.
            </p>

        </div>


        <div class="benefits-grid reveal">

            <div class="benefit-card">

                <div class="benefit-icon">
                    <i class="fa-solid fa-lightbulb"></i>
                </div>

                <h3>Fresh Perspectives & Innovation</h3>

                <p>
                    Trainees bring new ideas, academic knowledge and
                    different perspectives that can encourage creativity
                    and help  team approach challenges differently.
                </p>

            </div>


            <div class="benefit-card">

                <div class="benefit-icon">
                    <i class="fa-solid fa-users"></i>
                </div>

                <h3>Build Your Talent Pipeline</h3>

                <p>
                    Evaluate potential future employees in a real
                    working environment and identify candidates who
                    fit  organization and culture.
                </p>

            </div>


            <div class="benefit-card">

                <div class="benefit-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

                <h3>Cost-Effective Support</h3>

                <p>
                    Trainees can support suitable projects and
                    operational activities while allowing experienced
                    employees to focus on higher-priority initiatives.
                </p>

            </div>


            <div class="benefit-card">

                <div class="benefit-icon">
                    <i class="fa-solid fa-face-smile"></i>
                </div>

                <h3>Enhance Company Culture</h3>

                <p>
                    New trainees can bring enthusiasm, curiosity and
                    fresh energy that can contribute positively to
                    team collaboration and workplace morale.
                </p>

            </div>


            <div class="benefit-card">

                <div class="benefit-icon">
                    <i class="fa-solid fa-award"></i>
                </div>

                <h3>Strengthen Your Employer Brand</h3>

                <p>
                    A well-designed internship experience can position
                     organization as a company that values learning,
                    development and emerging talent.
                </p>

            </div>


            <div class="benefit-card">

                <div class="benefit-icon">
                    <i class="fa-solid fa-rocket"></i>
                </div>

                <h3>Increase Team Productivity</h3>

                <p>
                    With appropriate supervision and clearly defined
                    responsibilities, trainees can contribute to projects
                    and help teams accomplish more.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PROGRAM DESIGN
    ====================================================== -->

    <section class="program-section">

        <div class="program-layout">

            <div class="program-content reveal">

                <span class="eyebrow">Build Better Programs</span>

                <h2>
                    Create an Internship Program That Delivers Results
                </h2>

                <p>
                    A successful internship requires more than assigning
                    tasks. Define clear objectives, provide mentorship
                    and create meaningful learning opportunities that
                    align trainee development with organizational goals.
                </p>

            </div>


            <div class="program-list reveal">

                <div class="program-item">

                    <div class="program-check">
                        <i class="fa-solid fa-bullseye"></i>
                    </div>

                    <div>
                        <strong>Set Clear Objectives</strong>
                        <p>
                            Define the skills, projects and outcomes
                            expected from the internship.
                        </p>
                    </div>

                </div>


                <div class="program-item">

                    <div class="program-check">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <div>
                        <strong>Develop a Structured Plan</strong>
                        <p>
                            Create a clear timeline, responsibilities
                            and project assignments.
                        </p>
                    </div>

                </div>


                <div class="program-item">

                    <div class="program-check">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>

                    <div>
                        <strong>Provide Mentorship</strong>
                        <p>
                            Give trainees access to guidance, training
                            and experienced professionals.
                        </p>
                    </div>

                </div>


                <div class="program-item">

                    <div class="program-check">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>

