@{
	ViewData["Title"] = "Why Use 1Trainee";
}

<link rel="stylesheet"
	  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link rel="stylesheet"
	  href="~/css/Org_blog.css"
	  asp-append-version="true">


<div class="why-page">

	<!-- =====================================================
		 HERO SECTION
	====================================================== -->

	<section class="why-hero">

		<div class="why-hero-shape shape-one"></div>
		<div class="why-hero-shape shape-two"></div>

		<div class="container">



			<div class="why-hero-content">

				<div class="why-hero-text">

					<div class="why-label">
						<i class="bi bi-stars"></i>
						For Organizations
					</div>

					<h1>
						Why Use Free
						<span>1Trainee.com</span>
						Internship Portal?
					</h1>

					<p>
						Connect with talented trainees, simplify 
						recruitment process and build a strong future
						talent pipeline — completely free.
					</p>

					<div class="why-hero-actions">

						<a href="/Account/Register"
						   class="why-primary-btn">

							Get Started
							<i class="bi bi-arrow-right"></i>

						</a>

						<a href="#benefits"
						   class="why-secondary-btn">

							Explore Benefits
							<i class="bi bi-arrow-down"></i>

						</a>

					</div>

				</div>


				<div class="why-hero-visual">

					<div class="hero-main-card">

						<div class="hero-card-icon">
							<i class="bi bi-people"></i>
						</div>

						<div>

							<strong>
								Talented Trainees
							</strong>

							<span>
								Ready to learn & grow
							</span>

						</div>

					</div>


					<div class="hero-floating-card floating-one">

						<div class="floating-icon">
							<i class="bi bi-briefcase"></i>
						</div>

						<div>
							<strong>
								Easy Hiring
							</strong>

							<small>
								Simplified recruitment
							</small>
						</div>

					</div>


					<div class="hero-floating-card floating-two">

						<div class="floating-icon">
							<i class="bi bi-currency-rupee"></i>
						</div>

						<div>
							<strong>
								100% Free
							</strong>

							<small>
								No hidden charges
							</small>
						</div>

					</div>


					<div class="hero-circle">

						<i class="bi bi-person-workspace"></i>

					</div>

				</div>

			</div>

		</div>

	</section>



	<!-- =====================================================
		 INTRO
	====================================================== -->

	<section class="why-intro">

		<div class="container">

			<div class="why-section-heading">

				<span class="section-label">
					<i class="bi bi-lightbulb"></i>
					Why 1Trainee?
				</span>

				<h2>
					Everything You Need to
					<span>Find Great Talent</span>
				</h2>

				<p>
					Our internship portal helps organizations discover
					motivated trainees while making the entire recruitment
					journey simpler, faster and more efficient.
				</p>

			</div>

		</div>

	</section>



	<!-- =====================================================
		 BENEFITS
	====================================================== -->

	<section class="why-benefits"
			 id="benefits">

		<div class="container">

			<div class="benefits-grid">


				<!-- CARD 1 -->

				<article class="benefit-card">

					<div class="benefit-top">

						<span class="benefit-number">
							01
						</span>

						<div class="benefit-icon">
							<i class="bi bi-people"></i>
						</div>

					</div>

					<h3>
						Access to a Pool of Talented Trainees
					</h3>

					<p>
						Connect with a diverse group of enthusiastic and
						skilled students and recent graduates eager to gain
						real-world experience.
					</p>

					<div class="benefit-footer">
						<span>
							Discover Talent
						</span>

						<i class="bi bi-arrow-up-right"></i>
					</div>

				</article>



				<!-- CARD 2 -->

				<article class="benefit-card">

					<div class="benefit-top">

						<span class="benefit-number">
							02
						</span>

						<div class="benefit-icon">
							<i class="bi bi-lightning-charge"></i>
						</div>

					</div>

					<h3>
						Streamlined Recruitment Process
					</h3>

					<p>
						Post opportunities, review applications and manage
						trainees from one simple platform without spending
						countless hours sorting through resumes.
					</p>

					<div class="benefit-footer">
						<span>
							Hire Smarter
						</span>

						<i class="bi bi-arrow-up-right"></i>
					</div>

				</article>



				<!-- CARD 3 -->

				<article class="benefit-card">

					<div class="benefit-top">

						<span class="benefit-number">
							03
						</span>

						<div class="benefit-icon">
							<i class="bi bi-sliders"></i>
						</div>

					</div>

					<h3>
						Customizable Internship Listings
					</h3>

					<p>
						Specify job roles, required skills, project details
						and other important criteria to attract trainees
						who are genuinely suited to  opportunities.
					</p>

					<div class="benefit-footer">
						<span>
							Create Better Listings
						</span>

						<i class="bi bi-arrow-up-right"></i>
					</div>

				</article>



				<!-- CARD 4 -->

				<article class="benefit-card">

					<div class="benefit-top">

						<span class="benefit-number">
							04
						</span>

						<div class="benefit-icon">
							<i class="bi bi-megaphone"></i>
						</div>

					</div>

					<h3>
						Promote Your Company's Brand
					</h3>

					<p>
						Showcase  company culture, values and mission
						while giving potential interns a better understanding
						of  organization.
					</p>

					<div class="benefit-footer">
						<span>
							Build Your Brand
						</span>

						<i class="bi bi-arrow-up-right"></i>
					</div>

				</article>



				<!-- CARD 5 -->

				<article class="benefit-card">

					<div class="benefit-top">

						<span class="benefit-number">
							05
						</span>

						<div class="benefit-icon">
							<i class="bi bi-diagram-3"></i>
						</div>

					</div>

					<h3>
						Build Long-Term Relationships
					</h3>

					<p>
						Meaningful internships help organizations build
						relationships with young talent who may become
						future employees and brand ambassadors.
					</p>

					<div class="benefit-footer">
						<span>
							Build Your Pipeline
						</span>

						<i class="bi bi-arrow-up-right"></i>
					</div>

				</article>



				<!-- CARD 6 -->

				<article class="benefit-card benefit-featured">

					<div class="benefit-top">

						<span class="benefit-number">
							06
						</span>

						<div class="benefit-icon">
							<i class="bi bi-gift"></i>
						</div>

					</div>

					<h3>
						Free and Easy to Use
					</h3>

					<p>
						1Trainee is completely free to use. Post and manage
						internship opportunities through an intuitive platform
						with no complex setup or hidden fees.
					</p>

					<div class="benefit-footer">

						<span>
							100% Free
						</span>

						<i class="bi bi-check-circle-fill"></i>

					</div>

				</article>

			</div>

		</div>

	</section>



	<!-- =====================================================
		 ADVERTISEMENT
	====================================================== -->

	<section class="why-ad-section">

		<div class="container">

			<div class="why-ad-box">

				<div class="ad-title">
					Advertisement
				</div>

				<div class="ad-content">

					<i class="bi bi-megaphone"></i>

					<span>
						Advertisement Space
					</span>

					<small>
						970 × 250
					</small>

				</div>

			</div>

		</div>

	</section>



	<!-- =====================================================
		 HOW TO GET STARTED
	====================================================== -->

	<section class="getting-started">

		<div class="container">

			<div class="why-section-heading">

				<span class="section-label">
					<i class="bi bi-rocket-takeoff"></i>
					Getting Started
				</span>

				<h2>
					Start Hiring in
					<span>Four Simple Steps</span>
				</h2>

				<p>
					Getting started with the 1Trainee internship portal
					is simple and takes only a few steps.
				</p>

			</div>


			<div class="steps-wrapper">

				<div class="step-line"></div>


				<!-- STEP 1 -->

				<div class="step-item">

					<div class="step-number">
						01
					</div>

					<div class="step-icon">
						<i class="bi bi-person-plus"></i>
					</div>

					<div class="step-content">

						<span>
							Step One
						</span>

						<h3>
							Sign Up
						</h3>

						<p>
							Register  company on our portal
							with a few simple details.
						</p>

					</div>

				</div>



				<!-- STEP 2 -->

				<div class="step-item">

					<div class="step-number">
						02
					</div>

					<div class="step-icon">
						<i class="bi bi-file-earmark-plus"></i>
					</div>

					<div class="step-content">

						<span>
							Step Two
						</span>

						<h3>
							Post Opportunities
						</h3>

						<p>
							Create and publish internship listings
							tailored to  organization's needs.
						</p>

					</div>

				</div>



				<!-- STEP 3 -->

				<div class="step-item">

					<div class="step-number">
						03
					</div>

					<div class="step-icon">
						<i class="bi bi-search"></i>
					</div>

					<div class="step-content">

						<span>
							Step Three
						</span>

						<h3>
							Review Applications
						</h3>

						<p>
							Browse applications and identify trainees
							who match  requirements.
						</p>

					</div>

				</div>



				<!-- STEP 4 -->

				<div class="step-item">

					<div class="step-number">
						04
					</div>

					<div class="step-icon">
						<i class="bi bi-person-check"></i>
					</div>

					<div class="step-content">

						<span>
							Step Four
						</span>

						<h3>
							Select & Onboard
						</h3>

						<p>
							Choose the best trainees and begin
							 onboarding journey.
						</p>

					</div>

				</div>

			</div>

		</div>

	</section>



	<!-- =====================================================
		 SUCCESS STORIES
	====================================================== -->

	<section class="success-section">

		<div class="container">

			<div class="success-box">

				<div class="success-decoration"></div>

				<div class="success-icon">
					<i class="bi bi-trophy"></i>
				</div>

				<div class="success-content">

					<span>
						Success Stories
					</span>

					<h2>
						Discover Your Next
						<strong>Great Hire</strong>
					</h2>

					<p>
						Our portal has already helped numerous companies
						discover exceptional interns who have gone on to
						become valuable team members. From growing startups
						to established organizations, companies are building
						stronger talent pipelines through meaningful
						internships.
					</p>

				</div>

				<div class="success-stats">

					<div>
						<strong>
							100%
						</strong>

						<span>
							Free Platform
						</span>
					</div>

					<div>
						<strong>
							Easy
						</strong>

						<span>
							Recruitment
						</span>
					</div>

					<div>
						<strong>
							Future
						</strong>

						<span>
							Talent
						</span>
					</div>

				</div>

			</div>

		</div>

	</section>



	<!-- =====================================================
		 FINAL CTA
	====================================================== -->

	<section class="why-cta">

		<div class="container">

			<div class="cta-inner">

				<div class="cta-icon">
					<i class="bi bi-rocket-takeoff"></i>
				</div>

				<div class="cta-content">

					<span>
						Ready to connect with top talent?
					</span>

					<h2>
						Build Your Future Team
						With <strong>1Trainee</strong>
					</h2>

					<p>
						Start posting  internship opportunities today
						and discover talented trainees ready to grow with
						 organization.
					</p>

				</div>

				<a href="/Account/Register"
				   class="cta-button">

					Start Posting

					<i class="bi bi-arrow-right"></i>

				</a>

			</div>

		</div>

