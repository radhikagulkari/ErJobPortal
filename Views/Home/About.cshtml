@{
    ViewData["Title"] = "About Us - 1trainee & IT-NetworkZ";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        /* Custom Teal Theme Utilities */
        .text-teal {
            color: #0d9488 !important;
        }

        .bg-teal-subtle-custom {
            background-color: #f0fdfa !important;
        }

        .border-teal-subtle-custom {
            border-color: #ccfbf1 !important;
        }

        .badge-teal {
            background-color: #f0fdfa;
            color: #0f766e;
            border: 1px solid #99f6e4;
        }

        .stat-badge {
            background-color: #0d9488;
            color: #ffffff;
            font-size: 0.65rem;
            letter-spacing: 0.1em;
        }

        .icon-box-sm {
            width: 40px;
            height: 40px;
        }

        .card-hover {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .card-hover:hover {
                transform: translateY(-2px);
                border-color: #0d9488 !important;
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important;
            }
    </style>
</head>
<body class="bg-white text-dark">

    <!-- Hero Section -->
    <section class="position-relative overflow-hidden bg-white text-dark py-5 border-bottom border-light">
        <div class="container py-3">
            <div class="row gy-4 align-items-center">
                <div class="col-lg-7">
                    <div class="badge badge-teal rounded-pill px-3 py-2 text-uppercase mb-3 fw-semibold">
                        <i class="fa-solid fa-layer-group me-1"></i> 1trainee.com Ecosystem
                    </div>
                    <h1 class="display-6 fw-bold tracking-tight mb-3 text-dark">
                        Bridging the Gap Between <span class="text-teal">Talent & Opportunity</span>
                    </h1>
                    <p class="fs-6 text-secondary mb-3 leading-relaxed">
                        In today’s rapidly evolving job market, securing the right internship is a crucial step for students and professionals looking to gain valuable experience. Likewise, organizations seek efficient ways to connect with and assess potential future talent.
                    </p>
                    <p class="small text-secondary mb-0 leading-relaxed">
                        <strong class="text-dark fw-semibold">www.1trainee.com</strong> is designed to foster a more efficient, user-friendly experience for both internship seekers and organizations, creating a dynamic ecosystem built for career acceleration.
                    </p>
                </div>
                <!-- Stat Card -->
                <div class="col-lg-5">
                    <div class="position-relative bg-white text-dark rounded-4 p-4 shadow-lg border border-teal-subtle-custom text-center">
                        <div class="position-absolute top-0 start-50 translate-middle badge stat-badge rounded-pill px-3 py-1 fw-bold">
                            PROVEN EXCELLENCE
                        </div>
                        <span class="d-block display-3 fw-extrabold text-teal mt-2">
                            18+
                        </span>
                        <span class="d-block h5 fw-bold text-dark mt-1">Years of Experience</span>
                        <p class="small text-muted mt-2 mb-0">
                            Empowering thousands of careers and optimizing recruitment pipelines globally through innovation.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Platform Audiences Section -->
    <section class="py-5 bg-white">
        <div class="container py-2">
            <div class="text-center mx-auto mb-5" style="max-width: 600px;">
                <h2 class="h3 fw-bold text-dark mb-2">Tailored Solutions for Every User</h2>
                <div class="bg-teal rounded-pill mx-auto mb-3" style="width: 48px; height: 4px;"></div>
                <p class="small text-secondary mb-0">Designed specifically to address the unique needs of job seekers and hiring companies.</p>
            </div>

            <div class="row g-4">
                <!-- Internship Seekers -->
                <div class="col-lg-6">
                    <div class="bg-white rounded-4 p-4 border border-teal-subtle-custom shadow-sm h-100 card-hover">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="icon-box-sm rounded-3 bg-teal-subtle-custom border border-teal-subtle-custom d-flex align-items-center justify-center text-teal shadow-sm">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>
                            <h3 class="h5 fw-bold text-dark mb-0">Internship Seekers</h3>
                        </div>
                        <ul class="list-unstyled space-y-3 small mb-0">
                            <li class="d-flex align-items-start gap-2 mb-3 text-secondary">
                                <i class="fa-solid fa-circle-check text-teal mt-1"></i>
                                <div><strong class="text-dark">Streamlined Application Process:</strong> Easily browse opportunities, submit applications, and track progress with a user-friendly interface.</div>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-3 text-secondary">
                                <i class="fa-solid fa-circle-check text-teal mt-1"></i>
                                <div><strong class="text-dark">Enhanced Search Features:</strong> Utilize advanced search filters and personalized recommendations tailored to  goals.</div>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-3 text-secondary">
                                <i class="fa-solid fa-circle-check text-teal mt-1"></i>
                                <div><strong class="text-dark">Resource Hub:</strong> Access 35+ resume styles, interview preparation guides, and career advice articles.</div>
                            </li>
                            <li class="d-flex align-items-start gap-2 text-secondary">
                                <i class="fa-solid fa-circle-check text-teal mt-1"></i>
                                <div><strong class="text-dark">Networking Opportunities:</strong> Connect directly with mentors, industry professionals, and peers.</div>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Organizations / Companies -->
                <div class="col-lg-6">
                    <div class="bg-white rounded-4 p-4 border border-teal-subtle-custom shadow-sm h-100 card-hover">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="icon-box-sm rounded-3 bg-teal-subtle-custom border border-teal-subtle-custom d-flex align-items-center justify-center text-teal shadow-sm">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <h3 class="h5 fw-bold text-dark mb-0">Organizations & Companies</h3>
                        </div>
                        <ul class="list-unstyled space-y-3 small mb-0">
                            <li class="d-flex align-items-start gap-2 mb-3 text-secondary">
                                <i class="fa-solid fa-circle-check text-teal mt-1"></i>
                                <div><strong class="text-dark">Efficient Talent Acquisition:</strong> Post roles, review candidates, and manage recruitment processes efficiently.</div>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-3 text-secondary">
                                <i class="fa-solid fa-circle-check text-teal mt-1"></i>
                                <div><strong class="text-dark">Customizable Listings:</strong> Create detailed listings with custom fields while showcasing  company's culture.</div>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-3 text-secondary">
                                <i class="fa-solid fa-circle-check text-teal mt-1"></i>
                                <div><strong class="text-dark">Analytics and Reporting:</strong> Monitor engagement metrics, application trends, and trainee performance.</div>
                            </li>
                            <li class="d-flex align-items-start gap-2 text-secondary">
                                <i class="fa-solid fa-circle-check text-teal mt-1"></i>
                                <div><strong class="text-dark">Enhanced Communication Tools:</strong> Integrated messaging and scheduling streamline candidate interactions in one place.</div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Parent Company Services -->
    <section class="py-5 bg-white border-top border-bottom border-light">
        <div class="container py-2">
            <div class="text-center mx-auto mb-5" style="max-width: 600px;">
                <span class="text-uppercase tracking-widest fw-bold text-teal extra-small d-block mb-1">Parent Organization</span>
                <h2 class="h3 fw-bold text-dark mb-1">IT-NetworkZ Infosystems Pvt Ltd</h2>
                <p class="text-muted fw-medium extra-small mb-3">(Kavin India Pvt.Ltd)</p>
                <p class="small text-secondary mb-0">
                    Empowering businesses and individuals to excel in a digital-first world through innovation, technology, and continuous learning.
                </p>
            </div>

            <div class="row g-4">
                <!-- Service 1 -->
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-sm border border-light h-100 card-hover">
                        <div class="icon-box-sm rounded-3 bg-teal-subtle-custom border border-teal-subtle-custom text-teal d-flex align-items-center justify-center mb-3 shadow-sm">
                            <i class="fa-solid fa-code"></i>
                        </div>
                        <h3 class="h6 fw-bold text-dark mb-2">Software Development</h3>
                        <p class="text-secondary extra-small mb-0 leading-relaxed">
                            Custom enterprise software solutions, user-friendly mobile apps, and innovative web applications crafted using agile methodologies to meet  business needs.
                        </p>
                    </div>
                </div>

                <!-- Service 2 -->
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-sm border border-light h-100 card-hover">
                        <div class="icon-box-sm rounded-3 bg-teal-subtle-custom border border-teal-subtle-custom text-teal d-flex align-items-center justify-center mb-3 shadow-sm">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <h3 class="h6 fw-bold text-dark mb-2">Training & Online Exams</h3>
                        <p class="text-secondary extra-small mb-0 leading-relaxed">
                            Industry-standard practical training led by experts, coupled with a seamless online exam platform for convenient skill validation and certification.
                        </p>
                    </div>
                </div>

                <!-- Service 3 -->
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-sm border border-light h-100 card-hover">
                        <div class="icon-box-sm rounded-3 bg-teal-subtle-custom border border-teal-subtle-custom text-teal d-flex align-items-center justify-center mb-3 shadow-sm">
                            <i class="fa-solid fa-server"></i>
                        </div>
                        <h3 class="h6 fw-bold text-dark mb-2">Infrastructure Management</h3>
                        <p class="text-secondary extra-small mb-0 leading-relaxed">
                            Proactive IT system maintenance, server management, network optimization, and robust data security ensuring efficient and reliable business operations.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Mission & Vision -->
    <section class="py-5 bg-white">
        <div class="container py-2">
            <div class="row g-4">
                <!-- Mission Card -->
                <div class="col-md-6">
                    <div class="bg-white text-dark p-4 p-md-5 rounded-4 border border-teal-subtle-custom shadow-sm h-100">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="icon-box-sm rounded-circle bg-teal-subtle-custom border border-teal-subtle-custom d-flex align-items-center justify-center text-teal">
                                <i class="fa-solid fa-bullseye"></i>
                            </div>
                            <h3 class="h5 fw-bold text-dark mb-0">Our Mission</h3>
                        </div>
                        <p class="text-secondary small mb-0 leading-relaxed">
                            To drive technological advancement and support our clients in achieving their goals through exceptional IT services. We are dedicated to delivering innovative solutions, fostering continuous learning, and building lasting partnerships based on trust and excellence.
                        </p>
                    </div>
                </div>

                <!-- Vision Card -->
                <div class="col-md-6">
                    <div class="bg-white text-dark p-4 p-md-5 rounded-4 border border-teal-subtle-custom shadow-sm h-100">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="icon-box-sm rounded-circle bg-teal-subtle-custom border border-teal-subtle-custom d-flex align-items-center justify-center text-teal">
                                <i class="fa-solid fa-eye"></i>
                            </div>
                            <h3 class="h5 fw-bold text-dark mb-0">Our Vision</h3>
                        </div>
                        <p class="text-secondary small mb-0 leading-relaxed">
                            To be a leading IT services provider recognized for our commitment to quality, expertise in infrastructure management, dedication to professional development, and innovative software solutions that drive progress and add value to our communities.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>