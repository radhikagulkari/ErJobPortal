@model ErJobPortal.Models.OrganizationForgotPassword

@{
    ViewData["Title"] = "Organization Forgot Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">
                <div class="card-body">

                    <h3 class="text-center mb-4">
                        Organization Forgot Password
                    </h3>

                    <p class="text-center text-muted">
                        Enter your registered organization email address.
                    </p>

                    <form asp-action="OrganizationForgotPassword"
                          asp-controller="Account"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="sEmail"
                                   class="form-label">
                                Email ID
                            </label>

                            <input asp-for="sEmail"
                                   class="form-control"
                                   placeholder="Enter registered email address"
                                   autocomplete="email" />

                            <span asp-validation-for="sEmail"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Send Login Details
                        </button>

                    </form>

                    <div class="text-center mt-3">

                        <a asp-controller="Account"
                           asp-action="OrganizationLogin">
                            Back to Organization Login
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}