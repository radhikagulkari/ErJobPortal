@model ErJobPortal.Models.CandidateRegister

@{
    ViewData["Title"] = "Candidate Registration";
}

<link rel="stylesheet" href="~/css/CandidateRegister.css" />

<div class="candidate-register-page">

    <div class="candidate-register-card">

        <!-- =====================================================
             REGISTRATION SWITCH
        ====================================================== -->

        <div class="registration-switch">

            <a asp-controller="Account"
               asp-action="CandidateRegister"
               class="switch-btn active">
                Trainee
            </a>

            <a asp-controller="Account"
               asp-action="OrganizationRegister"
               class="switch-btn">
                Organization
            </a>

        </div>


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="register-icon">
            <i class="fa-solid fa-user"></i>
        </div>

        <div class="register-heading">

            <h2>Create Account</h2>

            <p>
                Register as a student and start your journey
            </p>

        </div>


        <!-- =====================================================
             SUCCESS / ERROR MESSAGE
        ====================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success register-alert">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger register-alert">
                @TempData["Error"]
            </div>
        }


        <!-- =====================================================
             FORM
        ====================================================== -->

        <form asp-controller="Account"
              asp-action="CandidateRegister"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <!-- =================================================
                 VALIDATION SUMMARY
            ================================================== -->

            <div asp-validation-summary="All"
                 class="text-danger register-summary">
            </div>


            <!-- =================================================
                 FIRST NAME + LAST NAME
            ================================================== -->

            <div class="register-form-row">

                <!-- First Name -->

                <div class="register-form-group">

                    <label asp-for="sFName"
                           class="register-label">
                        First Name
                    </label>

                    <input asp-for="sFName"
                           type="text"
                           class="register-input"
                           placeholder="Enter first name"
                           autocomplete="given-name" />

                    <span asp-validation-for="sFName"
                          class="text-danger register-validation">
                    </span>

                </div>


                <!-- Last Name -->

                <div class="register-form-group">

                    <label asp-for="sLName"
                           class="register-label">
                        Last Name
                    </label>

                    <input asp-for="sLName"
                           type="text"
                           class="register-input"
                           placeholder="Enter last name"
                           autocomplete="family-name" />

                    <span asp-validation-for="sLName"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>


            <!-- =================================================
                 GENDER + DATE OF BIRTH
            ================================================== -->

            <div class="register-form-row">

                <!-- Gender -->

                <div class="register-form-group">

                    <label asp-for="nGender"
                           class="register-label">
                        Gender
                    </label>

                    <select asp-for="nGender"
                            class="register-select">

                        <option value="0">
                            -- Select Gender --
                        </option>

                        <option value="1">
                            Female
                        </option>

                        <option value="2">
                            Male
                        </option>

                        <option value="3">
                            Other
                        </option>

                    </select>

                    <span asp-validation-for="nGender"
                          class="text-danger register-validation">
                    </span>

                </div>


                <!-- Date of Birth -->

                <div class="register-form-group">

                    <label asp-for="DOB"
                           class="register-label">
                        Date of Birth
                    </label>

                    <input asp-for="DOB"
                           type="date"
                           class="register-input" />

                    <span asp-validation-for="DOB"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>


            <!-- =================================================
                 MOBILE + EMAIL
            ================================================== -->

            <div class="register-form-row">

                <!-- Mobile -->

                <div class="register-form-group">

                    <label asp-for="sMobile"
                           class="register-label">
                        Mobile Number
                    </label>

                    <input asp-for="sMobile"
                           type="tel"
                           class="register-input"
                           placeholder="Enter mobile number"
                           maxlength="10"
                           autocomplete="tel" />

                    <span asp-validation-for="sMobile"
                          class="text-danger register-validation">
                    </span>

                </div>


                <!-- Email -->

                <div class="register-form-group">

                    <label asp-for="sEmail"
                           class="register-label">
                        Email
                    </label>

                    <input asp-for="sEmail"
                           type="email"
                           class="register-input"
                           placeholder="Enter email"
                           autocomplete="email" />

                    <span asp-validation-for="sEmail"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>


            <!-- =================================================
                 OTP VERIFICATION
            ================================================== -->

            <div class="otp-section">

                <label class="otp-label">
                    OTP Verification
                </label>

                <div class="otp-content">

                    <!-- OTP Options -->

                    <div class="otp-options">

                        <label class="radio-option">

                            <input type="radio"
                                   name="OTPType"
                                   value="Mobile"
                                   checked />

                            <span>
                                Mobile No.
                            </span>

                        </label>


                        <label class="radio-option">

                            <input type="radio"
                                   name="OTPType"
                                   value="Email" />

                            <span>
                                Email
                            </span>

                        </label>


                        <button type="button"
                                class="send-otp-btn"
                                id="btnSendOTP">

                            Send OTP

                        </button>

                    </div>


                    <!-- OTP Input -->

                    <div class="otp-input-container">

                        <input asp-for="sOTP"
                               type="text"
                               class="otp-input"
                               placeholder="Enter OTP"
                               maxlength="6"
                               autocomplete="one-time-code" />

                        <span asp-validation-for="sOTP"
                              class="text-danger register-validation">
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 COLLEGE NAME + COLLEGE CODE
            ================================================== -->

            <div class="register-form-row">

                <!-- College Name -->

                <div class="register-form-group">

                    <label asp-for="sCollegeName"
                           class="register-label">
                        College Name
                    </label>

                    <div class="register-input-box">

                        <select asp-for="sCollegeName"
                                id="sCollegeName"
                                class="register-select">

                            <option value="0">
                                -- Select College Name --
                            </option>

                        </select>

                        @*  <i class="fa-solid fa-building register-input-icon"></i> *@

                    </div>

                    <span asp-validation-for="sCollegeName"
                          class="text-danger register-validation">
                    </span>

                </div>


                <!-- College Code -->

                <div class="register-form-group">

                    <label asp-for="nCollegeCode"
                           class="register-label">
                        College Code
                    </label>

                    <div class="register-input-box">

                        <select asp-for="nCollegeCode"
                                id="nCollegeCode"
                                class="register-select">

                            <option value="0">
                                -- Select College Code --
                            </option>

                        </select>

                        @* <i class="fa-solid fa-hashtag register-input-icon"></i> *@

                    </div>

                    <span asp-validation-for="nCollegeCode"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>


            <!-- =================================================
                 DEPARTMENT + BRANCH
            ================================================== -->

            <div class="register-form-row">

                <!-- Department -->

                <div class="register-form-group">

                    <label asp-for="nDepartment"
                           class="register-label">
                        Department
                    </label>

                    <div class="register-input-box">

                        <select asp-for="nDepartment"
                                id="departmentSelect"
                                class="register-select">

                            <option value="0">
                                -- Select Department --
                            </option>

                        </select>

                        @*  <i class="fa-solid fa-building-columns register-input-icon"></i> *@

                    </div>

                    <span asp-validation-for="nDepartment"
                          class="text-danger register-validation">
                    </span>

                </div>


                <!-- Branch -->

                <div class="register-form-group">

                    <label asp-for="nBranch"
                           class="register-label">
                        Branch
                    </label>

                    <div class="register-input-box">

                        <select asp-for="nBranch"
                                id="branchSelect"
                                class="register-select">

                            <option value="0">
                                -- Select Branch --
                            </option>

                        </select>

                        @*   <i class="fa-solid fa-code-branch register-input-icon"></i> *@

                    </div>

                    <span asp-validation-for="nBranch"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>


            <!-- =================================================
                 PASSOUT YEAR
            ================================================== -->

            <div class="register-form-row">

                <div class="register-form-group">

                    <label asp-for="nPassoutYear"
                           class="register-label">
                        Passout Year
                    </label>

                    <select asp-for="nPassoutYear"
                            class="register-select">

                        <option value="0">
                            -- Select Passout Year --
                        </option>

                        <option value="2020">2020</option>
                        <option value="2021">2021</option>
                        <option value="2022">2022</option>
                        <option value="2023">2023</option>
                        <option value="2024">2024</option>
                        <option value="2025">2025</option>
                        <option value="2026">2026</option>
                        <option value="2027">2027</option>
                        <option value="2028">2028</option>
                        <option value="2029">2029</option>
                        <option value="2030">2030</option>

                    </select>

                    <span asp-validation-for="nPassoutYear"
                          class="text-danger register-validation">
                    </span>

                </div>



                <!-- =================================================
                     PROFILE IMAGE
                ================================================== -->

                <div class="register-form-group">

                    <label asp-for="ProfileImageFile"
                           class="register-label">
                        Profile Image
                    </label>

                    <input asp-for="ProfileImageFile"
                           type="file"
                           accept=".jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="ProfileImageFile"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>



            <!-- =================================================
                 PASSWORD + CONFIRM PASSWORD
            ================================================== -->

            <div class="register-form-row">

                <!-- Password -->

                <div class="register-form-group">

                    <label asp-for="sPassword"
                           class="register-label">
                        Password
                    </label>

                    <input asp-for="sPassword"
                           type="password"
                           class="register-input"
                           placeholder="Create password" />

                    <span asp-validation-for="sPassword"
                          class="text-danger register-validation">
                    </span>

                </div>


                <!-- Confirm Password -->
                @*  <div class="register-form-group">

                    <label asp-for="sConfirmPassword"
                           class="register-label">
                        Confirm Password
                    </label>

                    <input asp-for="sConfirmPassword"
                           type="password"
                           class="register-input"
                           placeholder="Confirm password" />

                    <span asp-validation-for="sConfirmPassword"
                          class="text-danger register-validation">
                    </span>

                </div> *@

            </div>


            <!-- =================================================
                 REGISTER BUTTON
            ================================================== -->

            <button type="submit"
                    class="register-main-btn">

                <i class="fa-solid fa-user-plus"></i>

                Register

            </button>


            <!-- =================================================
                 LOGIN LINK
            ================================================== -->

            <div class="register-bottom-text">

                Already have an account?

                <a asp-controller="Account"
                   asp-action="CandidateLogin">
                    Sign In
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(document).ready(function () {

            // =====================================================
            // BASIC INPUT SPACE HANDLING
            // =====================================================

            $('input[type="text"], input[type="email"], input[type="tel"], input[type="password"]')
                .on('keydown', function (e) {

                    if (e.key === " " && this.value.length === 0) {
                        e.preventDefault();
                    }

                })
                .on('input', function () {

                    this.value = this.value.replace(/^\s+/, '');

                })
                .on('blur', function () {

                    this.value = this.value.trim();

                });


            // =====================================================
            // ELEMENTS
            // =====================================================

            const collegeNameSelect =
                $('#sCollegeName');

            const collegeCodeSelect =
                $('#nCollegeCode');

            const departmentSelect =
                $('#departmentSelect');

            const branchSelect =
                $('#branchSelect');


            // =====================================================
            // LOAD COLLEGES
            // =====================================================

            $.ajax({

                url: '@Url.Action("GetColleges", "Account")',

                type: 'GET',

                success: function (data) {

                    console.log("Colleges:", data);

                    collegeNameSelect.empty();

                    collegeNameSelect.append(
                        $('<option>', {
                            value: '0',
                            text: '-- Select College Name --'
                        })
                    );

                    $.each(data, function (index, college) {

                        collegeNameSelect.append(
                            $('<option>', {

                                value: college.nID,

                                text: college.sCollegeName

                            })
                        );

                    });

                },

                error: function (xhr, status, error) {

                    console.error(
                        "College loading failed:",
                        error
                    );

                }

            });


            // =====================================================
            // COLLEGE NAME CHANGE
            // LOAD COLLEGE CODE
            // =====================================================

            collegeNameSelect.on('change', function () {

                const collegeId = $(this).val();

                collegeCodeSelect.empty();

                collegeCodeSelect.append(
                    $('<option>', {

                        value: '0',

                        text: '-- Select College Code --'

                    })
                );


                if (!collegeId ||
                    collegeId === '0') {

                    return;

                }


                $.ajax({

                    url: '@Url.Action("GetCollegeCodes", "Account")',

                    type: 'GET',

                    data: {

                        collegeId: collegeId

                    },

                    success: function (data) {

                        console.log(
                            "College Codes:",
                            data
                        );

                        if (!data ||
                            data.length === 0) {

                            collegeCodeSelect.append(
                                $('<option>', {

                                    value: '0',

                                    text: 'No College Code Available'

                                })
                            );

                            return;

                        }


                        $.each(data, function (index, code) {

                            collegeCodeSelect.append(
                                $('<option>', {

                                    value: code.nCode,

                                    text: code.nCode

                                })
                            );

                        });

                    },

                    error: function (xhr, status, error) {

                        console.error(
                            "College code loading failed:",
                            error
                        );

                    }

                });

            });


            // =====================================================
            // LOAD DEPARTMENTS
            // =====================================================

            $.ajax({

                url: '@Url.Action("GetDepartments", "Account")',

                type: 'GET',

                success: function (data) {

                    console.log(
                        "Departments:",
                        data
                    );

                    departmentSelect.empty();

                    departmentSelect.append(
                        $('<option>', {

                            value: '0',

                            text: '-- Select Department --'

                        })
                    );


                    $.each(data, function (index, item) {

                        departmentSelect.append(
                            $('<option>', {

                                value: item.nID,

                                text: item.sDepartment

                            })
                        );

                    });

                },

                error: function (xhr, status, error) {

                    console.error(
                        "Department loading failed:",
                        error
                    );

                }

            });


            // =====================================================
            // DEPARTMENT CHANGE
            // LOAD BRANCHES
            // =====================================================

            departmentSelect.on('change', function () {

                const departmentId = $(this).val();

                console.log(
                    "Selected Department ID:",
                    departmentId
                );


                branchSelect.empty();

                branchSelect.append(
                    $('<option>', {

                        value: '0',

                        text: '-- Select Branch --'

                    })
                );


                if (!departmentId ||
                    departmentId === '0') {

                    return;

                }


                $.ajax({

                    url: '@Url.Action("GetBranches", "Account")',

                    type: 'GET',

                    data: {

                        departmentId: departmentId

                    },

                    success: function (data) {

                        console.log(
                            "Branches:",
                            data
                        );


                        if (!data ||
                            data.length === 0) {

                            branchSelect.append(
                                $('<option>', {

                                    value: '0',

                                    text: 'No Branch Available'

                                })
                            );

                            return;

                        }


                        $.each(data, function (index, item) {

                            branchSelect.append(
                                $('<option>', {

                                    value: item.nID,

                                    text: item.sBranch

                                })
                            );

                        });

                    },

                    error: function (xhr, status, error) {

                        console.error(
                            "Branch loading failed:",
                            error
                        );

                        branchSelect.empty();

                        branchSelect.append(
                            $('<option>', {

                                value: '0',

                                text: 'Unable to load branches'

                            })
                        );

                    }

                });

            });


        });

    </script>
}