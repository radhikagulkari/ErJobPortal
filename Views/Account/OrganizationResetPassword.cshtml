
@model ErJobPortal.Models.OrganizationResetPassword

@{
    ViewData["Title"] = "Reset Organization Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reset Organization Password - Er Job Portal</title>


    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <!-- Font Awesome -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />


    <!-- Google Font -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />


    <!-- Existing Organization Login CSS -->

    <link rel="stylesheet"
          href="~/css/OrganizationLogin.css" />


    <style>

            body {
                font-family: 'Inter', sans-serif;
            }

            .reset-page {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 30px 15px;
            }

            .reset-card {
                width: 100%;
                max-width: 500px;
                background: #ffffff;
                border-radius: 20px;
                padding: 40px;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.10);
            }

            .reset-icon {
                width: 75px;
                height: 75px;
                margin: 0 auto 20px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f0f4ff;
                color: #0d6efd;
                font-size: 30px;
            }

            .reset-title {
                font-weight: 700;
                margin-bottom: 8px;
            }

            .reset-subtitle {
                color: #6c757d;
                margin-bottom: 30px;
            }

            .reset-label {
                font-weight: 600;
                margin-bottom: 8px;
            }

            .reset-input-wrapper {
                position: relative;
            }

            .reset-input {
                width: 100%;
                padding: 12px 45px 12px 45px;
                border: 1px solid #dee2e6;
                border-radius: 10px;
                outline: none;
            }

                .reset-input:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.15);
                }

            .reset-input-icon {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #6c757d;
            }

            .reset-password-toggle {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                color: #6c757d;
                cursor: pointer;
            }

            .reset-button {
                width: 100%;
                border: none;
                padding: 13px;
                border-radius: 10px;
                background: #0d6efd;
                color: #ffffff;
                font-weight: 600;
                margin-top: 10px;
            }

                .reset-button:hover {
                    background: #0b5ed7;
                }

            .back-login {
                text-align: center;
                margin-top: 25px;
            }

                .back-login a {
                    text-decoration: none;
                    font-weight: 600;
                }

            .reset-validation {
                color: #dc3545;
                font-size: 14px;
                margin-top: 5px;
            }

    </style>

</head>


<body>


    <div class="reset-page">


        <div class="reset-card">


            <!-- ==========================================
             HEADER
        =========================================== -->

            <div class="text-center">

                <div class="reset-icon">

                    <i class="fas fa-building"></i>

                </div>


                <h3 class="reset-title">

                    Reset Organization Password

                </h3>


                <p class="reset-subtitle">

                    Enter your registered email and create a new password.

                </p>

            </div>


            <!-- ==========================================
             SUCCESS
        =========================================== -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">

                    <i class="fas fa-circle-check me-2"></i>

                    @TempData["Success"]

                </div>
            }


            <!-- ==========================================
             ERROR
        =========================================== -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">

                    <i class="fas fa-circle-exclamation me-2"></i>

                    @TempData["Error"]

                </div>
            }


            <!-- ==========================================
             VALIDATION SUMMARY
        =========================================== -->

            <div asp-validation-summary="ModelOnly"
                 class="reset-validation mb-3">
            </div>


            <!-- ==========================================
             FORM
        =========================================== -->

            <form asp-controller="Account"
                  asp-action="OrganizationResetPassword"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- ======================================
                 EMAIL
            ======================================= -->

                <div class="mb-3">

                    <label asp-for="sEmail"
                           class="reset-label">

                        Registered Email Address

                    </label>


                    <div class="reset-input-wrapper">

                        <i class="fas fa-envelope reset-input-icon"></i>


                        <input asp-for="sEmail"
                               type="email"
                               class="reset-input"
                               placeholder="Enter registered email"
                               autocomplete="email" />

                    </div>


                    <span asp-validation-for="sEmail"
                          class="reset-validation">
                    </span>

                </div>


                <!-- ======================================
                 NEW PASSWORD
            ======================================= -->

                <div class="mb-3">

                    <label asp-for="NewPassword"
                           class="reset-label">

                        New Password

                    </label>


                    <div class="reset-input-wrapper">

                        <i class="fas fa-lock reset-input-icon"></i>


                        <input asp-for="NewPassword"
                               id="organizationNewPassword"
                               type="password"
                               class="reset-input"
                               placeholder="Enter new password"
                               autocomplete="new-password" />


                        <button type="button"
                                class="reset-password-toggle"
                                id="toggleOrganizationNewPassword"
                                aria-label="Show password">

                            <i class="fas fa-eye"></i>

                        </button>

                    </div>


                    <span asp-validation-for="NewPassword"
                          class="reset-validation">
                    </span>

                </div>


                <!-- ======================================
                 CONFIRM PASSWORD
            ======================================= -->

                <div class="mb-4">

                    <label asp-for="ConfirmPassword"
                           class="reset-label">

                        Confirm Password

                    </label>


                    <div class="reset-input-wrapper">

                        <i class="fas fa-lock reset-input-icon"></i>


                        <input asp-for="ConfirmPassword"
                               id="organizationConfirmPassword"
                               type="password"
                               class="reset-input"
                               placeholder="Confirm new password"
                               autocomplete="new-password" />


                        <button type="button"
                                class="reset-password-toggle"
                                id="toggleOrganizationConfirmPassword"
                                aria-label="Show password">

                            <i class="fas fa-eye"></i>

                        </button>

                    </div>


                    <span asp-validation-for="ConfirmPassword"
                          class="reset-validation">
                    </span>

                </div>


                <!-- ======================================
                 RESET BUTTON
            ======================================= -->

                <button type="submit"
                        class="reset-button">

                    <i class="fas fa-key me-2"></i>

                    Reset Password

                </button>


            </form>


            <!-- ==========================================
             BACK TO LOGIN
        =========================================== -->

            <div class="back-login">

                <a asp-controller="Account"
                   asp-action="OrganizationLogin">

                    <i class="fas fa-arrow-left me-1"></i>

                    Back to Organization Login

                </a>

            </div>


        </div>

    </div>


    <!-- Validation -->

    <partial name="_ValidationScriptsPartial" />


    <!-- Password Toggle -->

    <script>

            document.addEventListener(
                "DOMContentLoaded",
                function() {


                    // ==========================================
                    // NEW PASSWORD
                    // ==========================================

                    const newPassword =
                        document.getElementById(
                            "organizationNewPassword"
                        );

                    const toggleNewPassword =
                        document.getElementById(
                            "toggleOrganizationNewPassword"
                        );


                    if (newPassword && toggleNewPassword) {

                        toggleNewPassword.addEventListener(
                            "click",
                            function() {

                                const icon =
                                    this.querySelector("i");


                                if (newPassword.type === "password") {

                                    newPassword.type = "text";

                                    icon.classList.remove(
                                        "fa-eye"
                                    );

                                    icon.classList.add(
                                        "fa-eye-slash"
                                    );

                                    this.setAttribute(
                                        "aria-label",
                                        "Hide password"
                                    );

                                }
                                else {

                                    newPassword.type = "password";

                                    icon.classList.remove(
                                        "fa-eye-slash"
                                    );

                                    icon.classList.add(
                                        "fa-eye"
                                    );

                                    this.setAttribute(
                                        "aria-label",
                                        "Show password"
                                    );

                                }

                            }
                        );

                    }


                    // ==========================================
                    // CONFIRM PASSWORD
                    // ==========================================

                    const confirmPassword =
                        document.getElementById(
                            "organizationConfirmPassword"
                        );

                    const toggleConfirmPassword =
                        document.getElementById(
                            "toggleOrganizationConfirmPassword"
                        );


                    if (confirmPassword && toggleConfirmPassword) {

                        toggleConfirmPassword.addEventListener(
                            "click",
                            function() {

                                const icon =
                                    this.querySelector("i");


                                if (confirmPassword.type === "password") {

                                    confirmPassword.type = "text";

                                    icon.classList.remove(
                                        "fa-eye"
                                    );

                                    icon.classList.add(
                                        "fa-eye-slash"
                                    );

                                    this.setAttribute(
                                        "aria-label",
                                        "Hide password"
                                    );

                                }
                                else {

                                    confirmPassword.type = "password";

                                    icon.classList.remove(
                                        "fa-eye-slash"
                                    );

                                    icon.classList.add(
                                        "fa-eye"
                                    );

                                    this.setAttribute(
                                        "aria-label",
                                        "Show password"
                                    );

                                }

                            }
                        );

                    }

                }
            );

    </script>


</body>

</html>

