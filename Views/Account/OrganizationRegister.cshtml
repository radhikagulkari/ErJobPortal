    success: function (data) {

    $.each(data, function (index, code) {

    collegeCodeDropdown.append(
    $('<option></option>')
    .val(code.nCode)
    .text(code.nCode)
    );

    });

    },
    error: function () {

    console.log('Error loading college codes.');

    }
    });

    });

    });
