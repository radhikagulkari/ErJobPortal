{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           VALIDATION SUMMARY
           ===================================================== */

        const validationSummary =
            document.querySelector(".org-summary");

        function updateValidationSummary() {

            if (!validationSummary) {
                return;
            }

            const listItems =
                validationSummary.querySelectorAll("li");

            let hasErrors = false;

            listItems.forEach(function (item) {

                if (item.textContent.trim().length > 0) {
                    hasErrors = true;
                }

            });

            if (!hasErrors) {

                const summaryText =
                    validationSummary.textContent.trim();

                if (summaryText.length > 0) {
                    hasErrors = true;
                }

            }

            if (hasErrors) {

                validationSummary.classList.add(
                    "org-summary-visible"
                );

            }
            else {

                validationSummary.classList.remove(
                    "org-summary-visible"
                );

            }

        }

        updateValidationSummary();


        if (validationSummary) {

            const validationObserver =
                new MutationObserver(function () {

                    updateValidationSummary();

                });

            validationObserver.observe(
                validationSummary,
                {
                    childList: true,
                    subtree: true,
                    characterData: true
                }
            );

        }


        /* =====================================================
           FORM SUBMIT
           ===================================================== */

        const orgForm =
            document.querySelector(".org-form-content");

        if (orgForm) {

            orgForm.addEventListener("submit", function () {

                setTimeout(function () {

                    updateValidationSummary();

                }, 100);

            });

        }


        /* =====================================================
           ALLOW SPACE FIELDS
           ===================================================== */

        const allowSpaceFields = [
            'input[name="sOrgName"]',
            'input[name="sName"]',
            'input[name="sDesignation"]'
        ];

        document
            .querySelectorAll(allowSpaceFields.join(","))
            .forEach(function (input) {

                input.addEventListener("keydown", function (e) {

                    if (e.key === " " && this.value.length === 0) {
                        e.preventDefault();
                    }

                });

                input.addEventListener("input", function () {

                    this.value =
                        this.value.replace(/^\s+/, "");

                });

                input.addEventListener("blur", function () {

                    this.value =
                        this.value.trim();

                });

            });


        /* =====================================================
           NO SPACE FIELDS
           ===================================================== */

        const noSpaceFields = [
            'input[name="sOrgUrl"]',
            'input[name="sMobile"]',
            'input[name="sEmail"]',
            'input[name="sPassword"]'
        ];

        document
            .querySelectorAll(noSpaceFields.join(","))
            .forEach(function (input) {

                input.addEventListener("keydown", function (e) {

                    if (e.key === " ") {
                        e.preventDefault();
                    }

                });

                input.addEventListener("input", function () {

                    this.value =
                        this.value.replace(/\s/g, "");

                });

            });


        /* =====================================================
           MOBILE NUMBER
           ===================================================== */

        const mobileInput =
            document.querySelector('input[name="sMobile"]');

        if (mobileInput) {

            mobileInput.addEventListener("input", function () {

                this.value =
                    this.value
                        .replace(/\D/g, "")
                        .substring(0, 10);

            });

        }


                /* =====================================================
           OTP
           ===================================================== */

        const otpInputs =
            document.querySelectorAll(".org-otp-input");

        const otpHidden =
            document.getElementById("sOTP");

        const verifyButton =
            document.querySelector(".org-otp-verify");

        const otpStatus =
            document.querySelector(".org-otp-status");

        let otpVerified = false;


        /* ==========================================
           OTP INPUT
           ========================================== */

        otpInputs.forEach(function (input, index) {

            input.addEventListener("input", function () {

                this.value = this.value
                    .replace(/\D/g, "")
                    .substring(0, 1);

                otpVerified = false;

                if (otpHidden) {
                    otpHidden.value = "";
                }

                if (
                    this.value.length === 1 &&
                    index < otpInputs.length - 1
                ) {
                    otpInputs[index + 1].focus();
                }

            });


            /* ==========================================
               BACKSPACE
               ========================================== */

            input.addEventListener("keydown", function (e) {

                if (
                    e.key === "Backspace" &&
                    this.value === "" &&
                    index > 0
                ) {
                    otpInputs[index - 1].focus();
                }

            });


            /* ==========================================
               PASTE OTP
               ========================================== */

            input.addEventListener("paste", function (e) {

                e.preventDefault();

                const pasted =
                    (e.clipboardData || window.clipboardData)
                        .getData("text")
                        .replace(/\D/g, "")
                        .substring(0, 6);

                pasted.split("").forEach(function (digit, i) {

                    if (otpInputs[i]) {
                        otpInputs[i].value = digit;
                    }

                });

                if (pasted.length > 0) {

                    const focusIndex =
                        Math.min(
                            pasted.length - 1,
                            otpInputs.length - 1
                        );

                    otpInputs[focusIndex].focus();
                }

            });

        });


        /* ==========================================
           VERIFY OTP
           ========================================== */

        if (verifyButton) {

            verifyButton.addEventListener("click", function () {

                let otp = "";

                otpInputs.forEach(function (input) {
                    otp += input.value;
                });


                /* Empty / incomplete OTP */

                if (otp.length !== 6) {

                    otpVerified = false;

                    if (otpHidden) {
                        otpHidden.value = "";
                    }

                    otpStatus.textContent =
                        "Please enter the complete 6-digit OTP.";

                    otpStatus.classList.remove("success");
                    otpStatus.classList.add("error");

                    return;
                }


                /* ==========================================
                   DUMMY OTP VALIDATION
                   ONLY 123456 IS VALID
                   ========================================== */

                if (otp === "123456") {

                    otpVerified = true;

                    if (otpHidden) {
                        otpHidden.value = otp;
                    }

                    otpStatus.textContent =
                        "OTP verified successfully.";

                    otpStatus.classList.remove("error");
                    otpStatus.classList.add("success");

                }
                else {

                    otpVerified = false;

                    if (otpHidden) {
                        otpHidden.value = "";
                    }

                    otpStatus.textContent =
                        "Invalid OTP. Please enter 123456.";

                    otpStatus.classList.remove("success");
                    otpStatus.classList.add("error");

                }

            });

        }


        /* ==========================================
           FORM SUBMIT
           ========================================== */

        const orgForm =
            document.querySelector(".org-form-content");

        if (orgForm) {

            orgForm.addEventListener("submit", function (e) {

                let otp = "";

                otpInputs.forEach(function (input) {
                    otp += input.value;
                });


                /* Make sure hidden field contains OTP */

                if (otp === "123456") {

                    otpHidden.value = "123456";

                    otpVerified = true;

                }
                else {

                    e.preventDefault();

                    otpVerified = false;

                    otpHidden.value = "";

                    otpStatus.textContent =
                        "Invalid OTP. Please enter 123456.";

                    otpStatus.classList.remove("success");
                    otpStatus.classList.add("error");

                    otpInputs[0].focus();

                    return false;
                }

            });

        }

    });

</script>

