<script>
    $(document).ready(function () {

    // ==========================================
    // DEPARTMENT SELECTOR
    // ==========================================

    const departmentSelect = $("#departmentSelect");
    const branchSelect = $("#branchSelect");


    // ==========================================
    // LOAD DEPARTMENTS
    // ==========================================

    $.ajax({
    url: '@Url.Action("GetDepartments", "Account")',
    type: 'GET',

    success: function (data) {

    console.log("Departments:", data);

    departmentSelect.empty();

    departmentSelect.append(
    $('<option>', {
    value: '0',
    text: 'Select Department'
    })
    );

    $.each(data, function (index, item) {

    departmentSelect.append(
    $('<option>', {
    value: item.nID,
    text: item.sDepartment
    })
    );

    });
    },

    error: function (xhr, status, error) {

    console.error(
    "Department loading failed:",
    error
    );

    }
    });


    // ==========================================
    // DEPARTMENT CHANGE
    // LOAD RELATED BRANCHES
    // ==========================================

    departmentSelect.on("change", function () {

    const departmentId = $(this).val();

    console.log("Selected Department ID:", departmentId);


    // Clear existing branches
    branchSelect.empty();

    branchSelect.append(
    $('<option>', {
    value: '0',
    text: 'Select Branch'
    })
    );


    // No department selected
    if (!departmentId || departmentId === "0") {
    return;
    }


    // ==========================================
    // LOAD BRANCHES
    // ==========================================

    $.ajax({

    url: '@Url.Action("GetBranches", "Account")',

    type: 'GET',

    data: {
    departmentId: departmentId
    },

    success: function (data) {

    console.log(
    "Branches for Department " +
    departmentId + ":",
    data
    );

    if (!data || data.length === 0) {

    branchSelect.append(
    $('<option>', {
    value: '0',
    text: 'No Branch Available'
    })
    );

    return;
    }


    // Add branches
    $.each(data, function (index, item) {

    branchSelect.append(
    $('<option>', {
    value: item.nID,
    text: item.sBranch
    })
    );

    });

    },

    error: function (xhr, status, error) {

    console.error(
    "Branch loading failed:",
    error
    );

    branchSelect.empty();

    branchSelect.append(
    $('<option>', {
    value: '0',
    text: 'Unable to load branches'
    })
    );
    }

    });

    });

    });
</script>
