@model ErJobPortal.Models.OrganizationRegister

@{
    ViewData["Title"] = "Organization Registration";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
@if (TempData["Success"] != null)
{
    <div class="org-alert org-alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="org-alert org-alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}
<style>

    /* =========================================================
                   ORGANIZATION REGISTRATION
                   FULL WIDTH PREMIUM RESPONSIVE UI
                   ========================================================= */
    /* ==========================================
           SUCCESS / ERROR MESSAGE
           ========================================== */

    .org-alert {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        padding: 12px 15px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .org-alert-success {
        background: #eff9f5;
        border: 1px solid #b9dfd1;
        color: #1e7b67;
    }

    .org-alert-error {
        background: #fff5f5;
        border: 1px solid #f0c7c7;
        color: #d92d20;
    }

    .org-alert i {
        font-size: 15px;
    }

    .org-register-page {
        width: 100%;
        min-height: calc(100vh - 60px);
        padding: 30px 20px 50px;
        margin-top: 100px;
        background: #f6faf8;
        color: #344054;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
        box-sizing: border-box;
    }

        .org-register-page *,
        .org-register-page *::before,
        .org-register-page *::after {
            box-sizing: border-box;
        }

    .org-register-container {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
    }

    /* =========================================================
                   TOP BAR
                   ========================================================= */

    .org-register-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .org-page-label {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .org-page-label-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #1e7b67;
        color: #ffffff;
        font-size: 17px;
        box-shadow: 0 5px 15px rgba(30,123,103,.15);
    }

    .org-page-label-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .org-page-label-title {
        color: #1f2937;
        font-size: 17px;
        font-weight: 750;
        line-height: 1.2;
    }

    .org-page-label-subtitle {
        margin-top: 3px;
        color: #98a2b3;
        font-size: 13px;
    }

    /* =========================================================
                   ACCOUNT SWITCH
                   ========================================================= */

    .org-account-switch {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        padding: 3px;
        background: #ffffff;
        border: 1px solid #e1ebe7;
        border-radius: 9px;
    }

    .org-switch-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 110px;
        padding: 8px 13px;
        border-radius: 7px;
        color: #667085;
        text-decoration: none;
        font-size: 13px;
        font-weight: 650;
        transition: all .2s ease;
    }

        .org-switch-link:hover {
            color: #1e7b67;
            background: #f0f8f5;
        }

        .org-switch-link.active {
            color: #ffffff;
            background: #1e7b67;
        }

    /* =========================================================
                   MAIN CARD
                   ========================================================= */

    .org-register-layout {
        width: 100%;
        min-width: 0;
        background: #ffffff;
        border: 1px solid #e1ebe7;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(31,77,66,.07);
    }

    .org-register-main {
        width: 100%;
        min-width: 0;
        background: #ffffff;
    }

    /* =========================================================
                   FORM HEADER
                   ========================================================= */

    .org-form-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 25px 32px 21px;
        border-bottom: 1px solid #edf2f0;
    }

    .org-form-title {
        margin: 0;
        color: #1f2937;
        font-size: 22px;
        font-weight: 750;
        letter-spacing: -.25px;
    }

    .org-form-subtitle {
        margin: 5px 0 0;
        color: #98a2b3;
        font-size: 13px;
        line-height: 1.5;
    }

    .org-secure-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 7px;
        background: #eff9f5;
        color: #1e7b67;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* =========================================================
                   FORM CONTENT
                   ========================================================= */

    .org-form-content {
        width: 100%;
        padding: 27px 32px 30px;
    }

    /* =========================================================
                   VALIDATION
                   ========================================================= */

    .org-validation {
        display: block;
        margin-top: 4px;
        color: #d92d20 !important;
        font-size: 11px;
        line-height: 1.4;
    }

    .org-summary {
        display: none !important;
        width: 100%;
        margin: 0 0 16px 0;
        padding: 10px 12px;
        border-radius: 8px;
        background: #fff5f5;
        border: 1px solid #f4d3d3;
        color: #d92d20;
        font-size: 12px;
        line-height: 1.5;
    }

        .org-summary.org-summary-visible {
            display: block !important;
        }

        .org-summary ul {
            margin: 0;
            padding-left: 18px;
        }

        .org-summary li {
            margin: 2px 0;
        }

        .org-summary a {
            color: #d92d20;
        }

    /* =========================================================
                   FORM SECTION
                   ========================================================= */

    .org-form-section {
        width: 100%;
        margin-bottom: 25px;
    }

        .org-form-section:last-child {
            margin-bottom: 0;
        }

    /* =========================================================
                   SECTION HEADING
                   ========================================================= */

    .org-section-heading {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 14px;
    }

    .org-section-icon {
        width: 30px;
        height: 30px;
        min-width: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #eaf6f2;
        color: #1e7b67;
        font-size: 13px;
    }

    .org-section-heading-content {
        min-width: 0;
    }

    .org-section-title {
        margin: 0;
        color: #344054;
        font-size: 15px;
        font-weight: 750;
    }

    .org-section-description {
        margin: 2px 0 0;
        color: #98a2b3;
        font-size: 11px;
        line-height: 1.4;
    }

    /* =========================================================
                   FORM GRID
                   ========================================================= */

    .org-form-grid {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px 18px;
    }

    .org-form-field {
        min-width: 0;
        width: 100%;
    }

        .org-form-field.full {
            grid-column: 1 / -1;
        }

    /* =========================================================
                   LABEL
                   ========================================================= */

    .org-form-label {
        display: block;
        margin-bottom: 6px;
        color: #475467;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.4;
    }

    .org-required {
        color: #d92d20;
    }

    /* =========================================================
                   INPUT BOX
                   ========================================================= */

    .org-input-box {
        position: relative;
        width: 100%;
        min-width: 0;
    }

    .org-input-icon {
        position: absolute;
        z-index: 2;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #98a2b3;
        font-size: 13px;
        pointer-events: none;
        transition: color .2s ease;
    }

    /* =========================================================
                   INPUT / SELECT
                   ========================================================= */

    .org-form-input,
    .org-form-select {
        display: block;
        width: 100%;
        max-width: 100%;
        height: 42px;
        padding: 0 11px 0 35px;
        border: 1px solid #dfe7e4;
        border-radius: 7px;
        outline: none;
        background: #ffffff;
        color: #344054;
        font-family: inherit;
        font-size: 13px;
        line-height: 1.2;
        transition: all .2s ease;
    }

        .org-form-input::placeholder {
            color: #a4adb8;
        }

        .org-form-input:hover,
        .org-form-select:hover {
            border-color: #bfd8d0;
        }

        .org-form-input:focus,
        .org-form-select:focus {
            border-color: #1e7b67;
            box-shadow: 0 0 0 3px rgba(30,123,103,.06);
        }

    .org-input-box:focus-within .org-input-icon {
        color: #1e7b67;
    }

    .org-form-select {
        cursor: pointer;
        appearance: auto;
    }

        /* =========================================================
                   INVALID INPUT
                   ========================================================= */

        .org-form-input.input-validation-error,
        .org-form-select.input-validation-error {
            border-color: #d92d20 !important;
            box-shadow: 0 0 0 2px rgba(217,45,32,.05);
        }

            .org-form-input.input-validation-error:focus,
            .org-form-select.input-validation-error:focus {
                border-color: #d92d20 !important;
                box-shadow: 0 0 0 3px rgba(217,45,32,.07);
            }

    /* =========================================================
                   OTP SECTION
                   ========================================================= */

    .org-otp-section {
        width: 100%;
        margin-top: 8px;
        padding: 16px;
        border: 1px solid #dcebe5;
        border-radius: 10px;
        background: #f8fcfa;
    }

    .org-otp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 12px;
    }

    .org-otp-title-area {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .org-otp-icon {
        width: 29px;
        height: 29px;
        min-width: 29px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #e3f3ed;
        color: #1e7b67;
        font-size: 13px;
    }

    .org-otp-title {
        margin: 0;
        color: #344054;
        font-size: 13px;
        font-weight: 750;
    }

    .org-otp-description {
        margin: 2px 0 0;
        color: #98a2b3;
        font-size: 11px;
        line-height: 1.4;
    }

    .org-otp-timer {
        color: #1e7b67;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .org-otp-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .org-otp-input {
        width: 40px;
        height: 40px;
        padding: 0;
        border: 1px solid #d8e5e0;
        border-radius: 7px;
        outline: none;
        background: #ffffff;
        color: #1e7b67;
        text-align: center;
        font-family: inherit;
        font-size: 16px;
        font-weight: 750;
        transition: all .2s ease;
    }

        .org-otp-input:hover {
            border-color: #bfd8d0;
        }

        .org-otp-input:focus {
            border-color: #1e7b67;
            box-shadow: 0 0 0 3px rgba(30,123,103,.07);
        }

    .org-otp-verify {
        height: 40px;
        margin-left: 5px;
        padding: 0 16px;
        border: 1px solid #1e7b67;
        border-radius: 7px;
        background: #1e7b67;
        color: #ffffff;
        font-family: inherit;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s ease;
        white-space: nowrap;
    }

        .org-otp-verify:hover {
            background: #176553;
            border-color: #176553;
        }

    .org-otp-status {
        margin-top: 8px;
        color: #98a2b3;
        font-size: 11px;
        line-height: 1.5;
    }

        .org-otp-status.success {
            color: #1e7b67;
            font-weight: 650;
        }

        .org-otp-status.error {
            color: #d92d20;
            font-weight: 650;
        }

    /* =========================================================
                   FORM FOOTER
                   ========================================================= */

    .org-form-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid #edf2f0;
    }

    .org-login-text {
        color: #98a2b3;
        font-size: 12px;
    }

    .org-login-link {
        color: #1e7b67;
        text-decoration: none;
        font-weight: 750;
    }

        .org-login-link:hover {
            color: #176553;
            text-decoration: underline;
        }

    .org-submit-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 190px;
        height: 42px;
        padding: 0 18px;
        border: 0;
        border-radius: 7px;
        background: #1e7b67;
        color: #ffffff;
        font-family: inherit;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
        box-shadow: 0 6px 16px rgba(30,123,103,.16);
        transition: all .25s ease;
    }

        .org-submit-button:hover {
            background: #176553;
            transform: translateY(-1px);
            box-shadow: 0 9px 20px rgba(30,123,103,.21);
        }

        .org-submit-button:active {
            transform: translateY(0);
        }

    /* =========================================================
                   SECURITY LINE
                   ========================================================= */

    .org-security-line {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        margin-top: 11px;
        color: #98a2b3;
        font-size: 10px;
        line-height: 1.5;
    }

        .org-security-line i {
            margin-top: 2px;
            color: #1e7b67;
            font-size: 10px;
        }

    /* =========================================================
                   LARGE TABLET / SMALL LAPTOP
                   ========================================================= */

    @@media (max-width: 900px) {

        .org-register-page {
            padding: 25px 16px 40px;
        }

        .org-register-container {
            max-width: 100%;
        }

        .org-form-header {
            padding: 22px 24px 19px;
        }

        .org-form-content {
            padding: 23px 24px 27px;
        }

        .org-form-grid {
            gap: 13px 15px;
        }

        .org-form-title {
            font-size: 21px;
        }
    }

    /* =========================================================
                   MOBILE / TABLET
                   ========================================================= */

    @@media (max-width: 700px) {

        .org-register-page {
            padding: 18px 12px 35px;
            margin-top: 85px;
        }

        .org-register-topbar {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .org-account-switch {
            width: 100%;
        }

        .org-switch-link {
            flex: 1;
        }

        .org-register-layout {
            border-radius: 14px;
        }

        .org-form-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
            padding: 20px;
        }

        .org-form-content {
            padding: 20px;
        }

        .org-form-grid {
            grid-template-columns: 1fr;
            gap: 13px;
        }

        .org-form-field.full {
            grid-column: auto;
        }

        .org-form-title {
            font-size: 20px;
        }

        .org-form-subtitle {
            font-size: 12px;
        }

        .org-form-footer {
            align-items: stretch;
            flex-direction: column-reverse;
            gap: 12px;
        }

        .org-submit-button {
            width: 100%;
        }

        .org-login-text {
            text-align: center;
        }
    }

    /* =========================================================
                   SMALL MOBILE
                   ========================================================= */

    @@media (max-width: 520px) {

        .org-register-page {
            padding: 15px 8px 30px;
            margin-top: 75px;
        }

        .org-page-label {
            gap: 8px;
        }

        .org-page-label-icon {
            width: 36px;
            height: 36px;
            min-width: 36px;
            font-size: 15px;
        }

        .org-page-label-title {
            font-size: 15px;
        }

        .org-page-label-subtitle {
            font-size: 11px;
        }

        .org-account-switch {
            padding: 2px;
        }

        .org-switch-link {
            min-width: 0;
            padding: 8px 7px;
            font-size: 11px;
        }

        .org-register-layout {
            border-radius: 12px;
        }

        .org-form-header {
            padding: 18px 15px;
        }

        .org-form-content {
            padding: 18px 15px 22px;
        }

        .org-form-title {
            font-size: 18px;
        }

        .org-form-subtitle {
            font-size: 11px;
        }

        .org-secure-label {
            font-size: 10px;
        }

        .org-section-heading {
            gap: 8px;
        }

        .org-section-icon {
            width: 28px;
            height: 28px;
            min-width: 28px;
        }

        .org-section-title {
            font-size: 14px;
        }

        .org-section-description {
            font-size: 10px;
        }

        .org-form-label {
            font-size: 11px;
        }

        .org-form-input,
        .org-form-select {
            height: 40px;
            font-size: 12px;
        }

        .org-input-icon {
            left: 11px;
            font-size: 12px;
        }

        .org-form-input,
        .org-form-select {
            padding-left: 33px;
        }

        .org-otp-section {
            padding: 13px;
        }

        .org-otp-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 7px;
        }

        .org-otp-row {
            width: 100%;
            gap: 6px;
        }

        .org-otp-input {
            width: 37px;
            height: 37px;
        }

        .org-otp-verify {
            height: 37px;
            margin-left: 2px;
            padding: 0 12px;
        }

        .org-otp-status {
            font-size: 10px;
        }

        .org-login-text {
            font-size: 11px;
        }

        .org-security-line {
            font-size: 9px;
        }
    }

    /* =========================================================
                   VERY SMALL MOBILE
                   ========================================================= */

    @@media (max-width: 380px) {

        .org-register-page {
            padding: 12px 6px 25px;
        }

        .org-page-label-title {
            font-size: 14px;
        }

        .org-page-label-subtitle {
            font-size: 10px;
        }

        .org-form-header {
            padding: 16px 12px;
        }

        .org-form-content {
            padding: 16px 12px 20px;
        }

        .org-switch-link {
            padding: 7px 5px;
            font-size: 10px;
        }

        .org-form-grid {
            gap: 11px;
        }

        .org-section-title {
            font-size: 13px;
        }

        .org-section-description {
            font-size: 9px;
        }

        .org-otp-section {
            padding: 11px;
        }

        .org-otp-row {
            gap: 4px;
        }

        .org-otp-input {
            width: 34px;
            height: 34px;
            font-size: 14px;
        }

        .org-otp-verify {
            height: 34px;
            padding: 0 9px;
            font-size: 11px;
        }

        .org-submit-button {
            min-width: 0;
            width: 100%;
            height: 40px;
            font-size: 11px;
            padding: 0 12px;
        }
    }
</style>


<!-- =========================================================
     ORGANIZATION REGISTRATION PAGE
     ========================================================= -->
<input asp-for="sOTP" type="hidden" id="sOTP" />
<div class="org-register-page">

    <div class="org-register-container">

        <!-- =====================================================
             TOP BAR
        ====================================================== -->

        <div class="org-register-topbar">

            <div class="org-page-label">

                <div class="org-page-label-icon">
                    <i class="fa-solid fa-building"></i>
                </div>

                <div class="org-page-label-content">

                    <div class="org-page-label-title">
                        Organization Registration
                    </div>

                    <div class="org-page-label-subtitle">
                        Create your organization account
                    </div>

                </div>

            </div>

            <!-- ACCOUNT SWITCH -->

            <div class="org-account-switch">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="org-switch-link">

                    <i class="fa-solid fa-user-graduate"></i>

                    <span>Trainee</span>

                </a>

                <a asp-controller="Account"
                   asp-action="OrganizationRegister"
                   class="org-switch-link active">

                    <i class="fa-solid fa-building"></i>

                    <span>Organization</span>

                </a>

            </div>

        </div>


        <!-- =====================================================
             MAIN REGISTRATION CARD
        ====================================================== -->

        <div class="org-register-layout">

            <main class="org-register-main">

                <!-- =================================================
                     FORM HEADER
                ================================================== -->

                <div class="org-form-header">

                    <div>

                        <h1 class="org-form-title">
                            Create Organization Account
                        </h1>

                        <p class="org-form-subtitle">
                            Provide your organization details to get started.
                        </p>

                    </div>

                </div>


                <!-- =================================================
                     FORM
                ================================================== -->

                <form asp-controller="Account"
                      asp-action="OrganizationRegister"
                      method="post"
                      class="org-form-content">

                    @Html.AntiForgeryToken()


                    <!-- =================================================
                         VALIDATION SUMMARY
                    ================================================== -->

                    <div asp-validation-summary="All"
                         class="org-summary">
                    </div>


                    <!-- =================================================
                         01 ORGANIZATION INFORMATION
                    ================================================== -->

                    <section class="org-form-section">

                        <div class="org-section-heading">

                            <div class="org-section-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>

                            <div class="org-section-heading-content">

                                <h3 class="org-section-title">
                                    Organization Information
                                </h3>

                                <p class="org-section-description">
                                    Basic information about your organization
                                </p>

                            </div>

                        </div>


                        <div class="org-form-grid">

                            <!-- Organization Name -->

