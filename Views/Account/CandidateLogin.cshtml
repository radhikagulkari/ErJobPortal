@model ErJobPortal.Models.CandidateLogin

@{
    ViewData["Title"] = "Candidate Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Candidate Login</title>


    <!-- =========================================================
         BOOTSTRAP
    ========================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />


    <!-- =========================================================
         GOOGLE FONT
    ========================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />


    <!-- =========================================================
         CANDIDATE LOGIN CSS
    ========================================================== -->

    <link rel="stylesheet"
          href="~/css/CandidateLogin.css" />

</head>


<body>

    <!-- =========================================================
         MAIN LOGIN PAGE
    ========================================================== -->

    <div class="candidate-login-page">


        <!-- =====================================================
             BACKGROUND DECORATION
        ====================================================== -->

        <div class="candidate-bg-circle candidate-bg-circle-one"></div>

        <div class="candidate-bg-circle candidate-bg-circle-two"></div>


        <!-- =====================================================
             LOGIN WRAPPER
        ====================================================== -->

        <div class="candidate-login-wrapper">


            <!-- =================================================
                 LOGIN CARD
            ================================================== -->

            <div class="candidate-login-card">


                <!-- =================================================
                     BRAND
                ================================================== -->

                <div class="candidate-login-brand">

                    <div class="candidate-login-icon">

                        <i class="fas fa-user"></i>

                    </div>


                    <h2>
                        Candidate Login
                    </h2>


                    <p>
                        Sign in to access candidate account
                    </p>

                </div>

                <!-- =================================================
                     ACCOUNT TYPE SWITCH
                ================================================== -->

                <div class="candidate-account-switch">


                    <!-- =================================================
                         CANDIDATE
                    ================================================== -->

                    <a asp-controller="Account"
                       asp-action="CandidateLogin"
                       class="candidate-switch-link active">

                        <i class="fa-solid fa-user-graduate"></i>

                        <span>
                            Candidate
                        </span>

                    </a>


                    <!-- =================================================
                         ORGANIZATION
                    ================================================== -->

                    <a asp-controller="Account"
                       asp-action="OrganizationLogin"
                       class="candidate-switch-link">

                        <i class="fa-solid fa-building"></i>

                        <span>
                            Organization
                        </span>

                    </a>


                </div>



                <!-- =================================================
                     SECURITY BADGE
                ================================================== -->

                <div class="candidate-security-badge">

                    <i class="fas fa-lock"></i>

                    Secure Candidate Access

                </div>


                <!-- =================================================
                     ERROR MESSAGE
                ================================================== -->
                @if (TempData["Error"] != null)
                {
                    <div class="candidate-login-error">

                        <i class="fas fa-circle-exclamation"></i>

                        <span>
                            @TempData["Error"]
                        </span>

                    </div>
                }


                <!-- =================================================
                     SUCCESS MESSAGE
                ================================================== -->
                @if (TempData["Success"] != null)
                {
                    <div class="candidate-login-success">

                        <i class="fas fa-circle-check"></i>

                        <span>
                            @TempData["Success"]
                        </span>

                    </div>
                }


                <!-- =================================================
                     LOGIN FORM
                ================================================== -->

                <form asp-controller="Account"
                      asp-action="CandidateLogin"
                      method="post">


                    <!-- =================================================
                         VALIDATION SUMMARY
                    ================================================== -->

                    <div asp-validation-summary="All"
                         class="text-danger candidate-validation-summary">
                    </div>


                    <!-- =================================================
                         EMAIL
                    ================================================== -->

                    <div class="candidate-form-group">

                        <label asp-for="sEmail"
                               class="candidate-form-label">

                            Email Address

                        </label>


                        <div class="candidate-input-wrapper">


                            <i class="fas fa-envelope candidate-input-icon"></i>


                            <input asp-for="sEmail"
                                   class="candidate-input"
                                   type="email"
                                   placeholder="Email address"
                                   autocomplete="username" />


                        </div>


                        <span asp-validation-for="sEmail"
                              class="candidate-field-validation">
                        </span>

                    </div>


                    <!-- =================================================
                         PASSWORD
                    ================================================== -->

                    <div class="candidate-form-group">

                        <label asp-for="sPassword"
                               class="candidate-form-label">

                            Password

                        </label>


                        <div class="candidate-input-wrapper">


                            <i class="fas fa-lock candidate-input-icon"></i>


                            <input asp-for="sPassword"
                                   id="candidatePassword"
                                   class="candidate-input"
                                   type="password"
                                   placeholder="Password"
                                   autocomplete="current-password" />


                            <!-- PASSWORD TOGGLE -->

                            <button type="button"
                                    class="candidate-password-toggle"
                                    id="candidateTogglePassword"
                                    aria-label="Show password">

                                <i class="fas fa-eye"></i>

                            </button>


                        </div>


                        <span asp-validation-for="sPassword"
                              class="candidate-field-validation">
                        </span>

                    </div>

                    <div class="text-end mb-3">
                        <a asp-controller="Account"
                           asp-action="CandidateResetPassword"
                           class="text-primary text-decoration-none fw-semibold">
                            <i class="fas fa-key me-1"></i>
                            Reset Password
                        </a>
                    </div>

                    <div class="text-end mb-3">

                        <a asp-controller="Account"
                           asp-action="CandidateForgotPassword"
                           class="text-primary text-decoration-none fw-semibold">

                            <i class="fas fa-key me-1"></i>

                            Forgot Password?

                        </a>

                    </div>


                    <!-- =================================================
                         LOGIN BUTTON
                    ================================================== -->

                    <button type="submit"
                            class="candidate-login-button">

                        <i class="fas fa-right-to-bracket"></i>

                        <span>
                            Login
                        </span>

                    </button>


                </form>


                <!-- =================================================
                     FOOTER
                ================================================== -->

                <div class="candidate-login-footer">


                    <div>

                        <i class="fas fa-user-check"></i>

                        Don't have an Candidate account?


                        <a asp-controller="Account"
                           asp-action="CandidateRegister"
                           class="candidate-register-link">

                            Register

                        </a>

                    </div>


                </div>


            </div>

        </div>

    </div>


    <!-- =========================================================
         PASSWORD TOGGLE SCRIPT
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            const passwordInput =
                document.getElementById("candidatePassword");


            const toggleButton =
                document.getElementById("candidateTogglePassword");


            if (!passwordInput || !toggleButton) {
                return;
            }


            toggleButton.addEventListener("click", function () {


                const icon =
                    this.querySelector("i");


                if (passwordInput.type === "password") {


                    passwordInput.type = "text";


                    icon.classList.remove("fa-eye");

                    icon.classList.add("fa-eye-slash");


                    this.setAttribute(
                        "aria-label",
                        "Hide password"
                    );


                }
                else {


                    passwordInput.type = "password";


                    icon.classList.remove("fa-eye-slash");

                    icon.classList.add("fa-eye");


                    this.setAttribute(
                        "aria-label",
                        "Show password"
                    );

                }

            });

        });

    </script>


    <!-- =========================================================
         VALIDATION
    ========================================================== -->

    <partial name="_ValidationScriptsPartial" />

</body>

</html>