
@model ErJobPortal.Models.SAFeedbackM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Super Admin Dashboard";

    ViewData["Panel"] = "SuperAdmin";

    ViewData["UserName"] = "Super Admin";
}
@section Styles {

    <link rel="stylesheet"
          href="~/css/EditSAFeedback.css"
          asp-append-version="true" />

}
@{

    ViewData["Title"] = "Edit Trainee Feedback";
}
 
 

<div class="feedback-edit-container">

    <div class="feedback-edit-card">

        <h1 class="feedback-edit-title">
            Edit Trainee Feedback
        </h1>


        <!-- ONLY ONE FORM -->
        <form asp-controller="SuperAdmin"
              asp-action="EditSAFeedback"
              method="post">

            @Html.AntiForgeryToken()

            <!-- IMPORTANT -->
            <input type="hidden" asp-for="nID" />

            <input type="hidden" asp-for="nSAID" />


            <!-- ================= QUESTION 1 ================= -->

            <div class="feedback-question">

                <label class="question-label">
                    Question 1.
                </label>

                <textarea asp-for="Que1"
                          class="question-textarea"></textarea>

                <span asp-validation-for="Que1"
                      class="validation-message"></span>


                <div class="answer-area">

                    <div class="radio-options">

                        <label>

                            <input type="radio"
                                   name="Ans1"
                                   value="True"
                                   @(Model.Ans1 == "True" ? "checked" : "") />

                            <span>True</span>

                        </label>


                        <label>

                            <input type="radio"
                                   name="Ans1"
                                   value="False"
                                   @(Model.Ans1 == "False" ? "checked" : "") />

                            <span>False</span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- ================= QUESTION 2 ================= -->

            <div class="feedback-question">

                <label class="question-label">
                    Question 2.
                </label>

                <textarea asp-for="Que2"
                          class="question-textarea"></textarea>

                <span asp-validation-for="Que2"
                      class="validation-message"></span>


                <div class="answer-area">

                    <div class="star-options"
                         id="starRating">

                        <label>

                            <input type="radio"
                                   name="Ans2"
                                   value="1"
                                   @(Model.Ans2 == "1" ? "checked" : "") />

                            <span class="star">★</span>

                        </label>


                        <label>

                            <input type="radio"
                                   name="Ans2"
                                   value="2"
                                   @(Model.Ans2 == "2" ? "checked" : "") />

                            <span class="star">★</span>

                        </label>


                        <label>

                            <input type="radio"
                                   name="Ans2"
                                   value="3"
                                   @(Model.Ans2 == "3" ? "checked" : "") />

                            <span class="star">★</span>

                        </label>


                        <label>

                            <input type="radio"
                                   name="Ans2"
                                   value="4"
                                   @(Model.Ans2 == "4" ? "checked" : "") />

                            <span class="star">★</span>

                        </label>


                        <label>

                            <input type="radio"
                                   name="Ans2"
                                   value="5"
                                   @(Model.Ans2 == "5" ? "checked" : "") />

                            <span class="star">★</span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- ================= QUESTION 3 ================= -->

            <div class="feedback-question">

                <label class="question-label">
                    Question 3.
                </label>

                <textarea asp-for="Que3"
                          class="question-textarea"></textarea>

                <span asp-validation-for="Que3"
                      class="validation-message"></span>


                <div class="answer-area">

                    <div class="radio-options">

                        <label>

                            <input type="radio"
                                   name="Ans3"
                                   value="Yes"
                                   @(Model.Ans3 == "Yes" ? "checked" : "") />

                            <span>Yes</span>

                        </label>


                        <label>

                            <input type="radio"
                                   name="Ans3"
                                   value="No"
                                   @(Model.Ans3 == "No" ? "checked" : "") />

                            <span>No</span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- ================= QUESTION 4 ================= -->

            <div class="feedback-question">

                <label class="question-label">
                    Question 4.
                </label>

                <textarea asp-for="Que4"
                          class="question-textarea"></textarea>

                <span asp-validation-for="Que4"
                      class="validation-message"></span>


                <div class="answer-area">

                    <div class="emoji-options"
                         id="emojiRating">


                        <!-- VERY BAD -->

                        <label title="Very Bad">

                            <input type="radio"
                                   name="Ans4"
                                   value="😞"
                                   @(Model.Ans4 == "😞" ? "checked" : "") />

                            <span class="emoji">😞</span>

                        </label>


                        <!-- BAD -->

                        <label title="Bad">

                            <input type="radio"
                                   name="Ans4"
                                   value="😟"
                                   @(Model.Ans4 == "😟" ? "checked" : "") />

                            <span class="emoji">😟</span>

                        </label>


                        <!-- NEUTRAL -->

                        <label title="Neutral">

                            <input type="radio"
                                   name="Ans4"
                                   value="😐"
                                   @(Model.Ans4 == "😐" ? "checked" : "") />

                            <span class="emoji">😐</span>

                        </label>


                        <!-- GOOD -->

                        <label title="Good">

                            <input type="radio"
                                   name="Ans4"
                                   value="🙂"
                                   @(Model.Ans4 == "🙂" ? "checked" : "") />

                            <span class="emoji">🙂</span>

                        </label>


                        <!-- EXCELLENT -->

                        <label title="Excellent">

                            <input type="radio"
                                   name="Ans4"
                                   value="😍"
                                   @(Model.Ans4 == "😍" ? "checked" : "") />

                            <span class="emoji">😍</span>

                        </label>


                    </div>

                </div>

            </div>


            <!-- ================= QUESTION 5 ================= -->

            <div class="feedback-question">

                <label class="question-label">
                    Question 5.
                </label>


                <textarea asp-for="Que5"
                          class="question-textarea"></textarea>

                <span asp-validation-for="Que5"
                      class="validation-message"></span>


                <label class="description-label">
                    Description
                </label>


                <textarea asp-for="Ans5"
                          class="description-textarea"></textarea>

                <span asp-validation-for="Ans5"
                      class="validation-message"></span>

            </div>


            <!-- ================= SAVE ================= -->

            <div class="save-area">

                <button type="submit"
                        class="save-button">

                    Save

                </button>

            </div>


        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            // =====================================================
            // STAR RATING
            // =====================================================

            const starRating =
                document.getElementById("starRating");


            if (starRating) {

                const starLabels =
                    starRating.querySelectorAll("label");

                const starInputs =
                    starRating.querySelectorAll(
                        "input[type='radio']"
                    );


                function updateStars(rating) {

                    starLabels.forEach(function (label, index) {

                        const star =
                            label.querySelector(".star");

                        if (index < rating) {

                            star.classList.add("active");

                        }
                        else {

                            star.classList.remove("active");

                        }

                    });

                }


                // Load existing value

                const checkedStar =
                    starRating.querySelector(
                        "input[type='radio']:checked"
                    );


                if (checkedStar) {

                    updateStars(
                        parseInt(checkedStar.value)
                    );

                }


                // Change rating

                starInputs.forEach(function (input) {

                    input.addEventListener(
                        "change",
                        function () {

                            updateStars(
                                parseInt(this.value)
                            );

                        }
                    );

                });


                // Hover

                starLabels.forEach(function (label, index) {

                    label.addEventListener(
                        "mouseenter",
                        function () {

                            updateStars(index + 1);

                        }
                    );


                    label.addEventListener(
                        "mouseleave",
                        function () {

                            const selected =
                                starRating.querySelector(
                                    "input[type='radio']:checked"
                                );


                            if (selected) {

                                updateStars(
                                    parseInt(selected.value)
                                );

                            }
                            else {

                                updateStars(0);

                            }

                        }
                    );

                });

            }


            // =====================================================
            // EMOJI RATING
            // =====================================================

            const emojiRating =
                document.getElementById("emojiRating");


            if (emojiRating) {

                const emojiLabels =
                    emojiRating.querySelectorAll("label");

                const emojiInputs =
                    emojiRating.querySelectorAll(
                        "input[type='radio']"
                    );


                function updateEmoji() {

                    emojiLabels.forEach(function (label) {

                        const input =
                            label.querySelector(
                                "input[type='radio']"
                            );


                        if (input.checked) {

                            label.classList.add("selected");

                        }
                        else {

                            label.classList.remove("selected");

                        }

                    });

                }


                // Load existing emoji

                updateEmoji();


                // Change emoji

                emojiInputs.forEach(function (input) {

                    input.addEventListener(
                        "change",
                        function () {

                            updateEmoji();

                        }
                    );

                });

            }

        });

    </script>

}

@{

    ViewData["Title"] = "Edit Trainee Feedback";
}

  