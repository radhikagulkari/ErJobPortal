@model IEnumerable<ErJobPortal.Models.SAFeedbackM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Super Admin Dashboard";

    ViewData["Panel"] = "SuperAdmin";

    ViewData["UserName"] = "Super Admin";
}
@section Styles {

    <link rel="stylesheet"
          href="~/css/SAFeedback.css"
          asp-append-version="true" />

}

@{

    ViewData["Title"] = "Trainee Feedback Details";

}

  

<div class="feedback-container">

    <!-- =====================================================
         PAGE TITLE
         ===================================================== -->



    <!-- =====================================================
         FEEDBACK CARD
         ===================================================== -->

    <div class="feedback-card">


     


        <!-- =================================================
             CARD BODY
             ================================================= -->

        <div class="feedback-card-body">

   
            <!-- =================================================
                 TABLE
                 ================================================= -->

       <div class="master-table-container">
                    
    <h1 class="feedback-title">
        Trainee Feedback Details
    </h1>

    <table id="feedbackTable"
           class="master-data-table"
           data-mobile-scroll="true">


                <!-- =================================================
                     HEADER
                     ================================================= -->

                <thead>

                    <tr>

                        <th>
                            Que 1
                        </th>

                        <th>
                            Ans 1
                        </th>


                        <th>
                            Que 2
                        </th>

                        <th>
                            Ans 2
                        </th>


                        <th>
                            Que 3
                        </th>

                        <th>
                            Ans 3
                        </th>


                        <th>
                            Que 4
                        </th>

                        <th>
                            Ans 4
                        </th>


                        <th>
                            Que 5
                        </th>

                        <th>
                            Ans 5
                        </th>


                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <!-- =================================================
                     BODY
                     ================================================= -->

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>


                                <!-- =====================================
                                     QUESTION 1
                                     ===================================== -->

                                <td>

                                    <div class="question-text">

                                        @item.Que1

                                    </div>

                                </td>


                                <!-- =====================================
                                     ANSWER 1
                                     ===================================== -->

                                <td>

                                    <div class="answer-text">

                                        @item.Ans1

                                    </div>

                                </td>


                                <!-- =====================================
                                     QUESTION 2
                                     ===================================== -->

                                <td>

                                    <div class="question-text">

                                        @item.Que2

                                    </div>

                                </td>


                                <!-- =====================================
                                     ANSWER 2
                                     ===================================== -->

                                <td>

                                    <div class="answer-text">

                                        @item.Ans2

                                    </div>

                                </td>


                                <!-- =====================================
                                     QUESTION 3
                                     ===================================== -->

                                <td>

                                    <div class="question-text">

                                        @item.Que3

                                    </div>

                                </td>


                                <!-- =====================================
                                     ANSWER 3
                                     ===================================== -->

                                <td>

                                    <div class="answer-text">

                                        @item.Ans3

                                    </div>

                                </td>


                                <!-- =====================================
                                     QUESTION 4
                                     ===================================== -->

                                <td>

                                    <div class="question-text">

                                        @item.Que4

                                    </div>

                                </td>


                                <!-- =====================================
                                     ANSWER 4
                                     ===================================== -->

                                <td>

                                    <div class="answer-text">

                                        @item.Ans4

                                    </div>

                                </td>


                                <!-- =====================================
                                     QUESTION 5
                                     ===================================== -->

                                <td>

                                    <div class="question-text">

                                        @item.Que5

                                    </div>

                                </td>


                                <!-- =====================================
                                     ANSWER 5
                                     ===================================== -->

                                <td>

                                    <div class="answer-text">

                                        @item.Ans5

                                    </div>

                                </td>


                                <!-- =====================================
                                     ACTION
                                     ===================================== -->

                                <td>

                                    <div class="action-buttons">


                                        <!-- VIEW -->

                                        <a asp-controller="SuperAdmin"
                                           asp-action="DetailsSAFeedback"
                                           asp-route-id="@item.nID"
                                           class="view-icon"
                                           title="View">

                                            <i class="fas fa-eye"></i>

                                        </a>


                                        <!-- EDIT -->

                                        <a asp-controller="SuperAdmin"
                                           asp-action="EditSAFeedback"
                                           asp-route-id="@item.nID"
                                           class="edit-icon"
                                           title="Edit">

                                            <i class="fas fa-edit"></i>

                                        </a>


                                    </div>

                                </td>


                            </tr>
                        }
                    }

                </tbody>

            </table>

                <div id="feedbackPageInfo"
         class="master-page-info text-center d-none">
    </div>
        </div>

    </div>

</div>

 