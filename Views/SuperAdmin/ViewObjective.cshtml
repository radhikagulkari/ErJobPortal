@model List<ErJobPortal.Models.SAObjectiveM>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Super Admin Dashboard";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}
@{
    ViewData["Title"] = "Objectives";

    var genderNames = ViewBag.GenderNames as Dictionary<int, string>
                      ?? new Dictionary<int, string>();
}

<style>
    .objective-container {
        width: 100%;
        padding: 0;
    }

    /* Add Objective Button */
    .btn-add-objective {
        background-color: #6c757d;
        color: #ffffff;
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-size: 21px;
        margin-bottom: 32px;
        cursor: pointer;
    }

        .btn-add-objective:hover {
            background-color: #5c636a;
            color: #ffffff;
        }

    /* Main Card */
    .objective-card {
        width: 100%;
        border: 1px solid #d9d9d9;
        border-radius: 9px;
        background-color: #ffffff;
        overflow: hidden;
    }

    /* Card Header */
    .objective-card-header {
        height: 58px;
        display: flex;
        align-items: center;
        padding: 0 20px;
        background-color: #f7f7f7;
        border-bottom: 1px solid #d9d9d9;
        font-size: 22px;
        color: #292d32;
    }

        .objective-card-header i {
            font-size: 21px;
            margin-right: 12px;
        }

    /* Card Body */
    .objective-card-body {
        padding: 22px;
    }

    /* Top Controls */
    .objective-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

    /* Entries */
    .entries-container {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 20px;
        color: #333;
    }

        .entries-container select {
            width: 141px;
            height: 50px;
            border: 1px solid #aaa;
            border-radius: 4px;
            background-color: #fff;
            padding: 5px 12px;
            font-size: 20px;
            cursor: pointer;
        }

    /* Search */
    .search-container input {
        width: 292px;
        height: 53px;
        border: 1px solid #d4dbe2;
        border-radius: 9px;
        padding: 0 17px;
        font-size: 20px;
        outline: none;
    }

        .search-container input:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.08);
        }

    /* Table */
    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .objective-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .objective-table th,
        .objective-table td {
            border: 1px solid #d8d8d8;
            vertical-align: middle;
        }

        .objective-table th {
            height: 72px;
            padding: 10px;
            background-color: #ffffff;
            color: #111111;
            font-size: 19px;
            font-weight: 700;
            text-align: center;
        }

        .objective-table td {
            min-height: 76px;
            padding: 13px 11px;
            font-size: 18px;
            color: #333333;
        }

    /* Column Widths */
    .col-sr {
        width: 90px;
        text-align: center;
    }

    .col-gender {
        width: 163px;
        text-align: center;
    }

    .col-objective {
        width: auto;
        text-align: center;
    }

    .col-status {
        width: 138px;
        text-align: center;
    }

    .col-action {
        width: 92px;
        text-align: center;
    }

    /* Objective text */
    .objective-text {
        text-align: center;
        line-height: 1.5;
    }

    /* Status */
    .status-button {
        border: none;
        border-radius: 9px;
        color: #ffffff;
        padding: 9px 17px;
        font-size: 18px;
        cursor: pointer;
        min-width: 105px;
    }

    .status-enabled {
        background-color: #198754;
    }

    .status-disabled {
        background-color: #dc3545;
    }

    /* Edit */
    .edit-button {
        color: #0d6efd;
        font-size: 24px;
        text-decoration: none;
        cursor: pointer;
    }

        .edit-button:hover {
            color: #084298;
        }

    /* No Data */
    .no-data {
        text-align: center !important;
        padding: 25px !important;
        color: #777 !important;
    }

    /* Mobile */
    @@media (max-width: 768px) {

        .objective-controls {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
        }

        .search-container input {
            width: 100%;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .objective-table {
            min-width: 900px;
        }
    }
</style>


<div class="objective-container">

    <!-- Add Objective -->
    <button type="button" class="btn-add-objective" onclick="window.location.href='@Url.Action("AddObjective", "SuperAdmin")'">
        Add Objective
    </button>


    <!-- Objective Card -->
    <div class="objective-card">
        <!-- Header -->
        <div class="objective-card-header">
            <i class="bi bi-table"></i>
            <span>Objectives</span>
        </div>

        <!-- Body -->
        <div class="objective-card-body">
            <!-- Controls -->
            <div class="objective-controls">
                <!-- Entries -->
                <div class="entries-container">
                    <select id="entriesPerPage">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="all">All</option>
                    </select>
                    <span>Entries per page</span>
                </div>
                <!-- Search -->
                <div class="search-container">
                    <input type="text" id="objectiveSearch" placeholder="Search..." />
                </div>
            </div>

            <!-- Table -->
            <div class="table-wrapper">

                <table class="objective-table" id="objectiveTable">

                    <thead>
                        <tr>

                            <th class="col-sr">
                                Sr.<br />
                                No.
                            </th>

                            <th class="col-gender">
                                GenderName
                            </th>

                            <th class="col-objective">
                                Objective
                            </th>

                            <th class="col-status">
                                Status
                            </th>

                            <th class="col-action">
                                Action
                            </th>

                        </tr>
                    </thead>


                    <tbody>

                        @if (Model != null && Model.Count > 0)
                        {
                            int srNo = 1;

                            foreach (var item in Model)
                            {
                                string genderName = "N/A";

                                if (genderNames.ContainsKey(item.nGenderID))
                                {
                                    genderName = genderNames[item.nGenderID];
                                }

                                <tr>

                                    <!-- Sr No -->
                                    <td class="col-sr">
                                        @srNo
                                    </td>


                                    <!-- Gender -->
                                    <td class="col-gender">
                                        @genderName
                                    </td>


                                    <!-- Objective -->
                                    <td class="col-objective objective-text">
                                        @item.sObjective
                                    </td>


                                    <!-- Status -->
                                    <td class="col-status">

                                        @if (item.nBit)
                                        {
                                            <button type="button"
                                                    class="status-button status-enabled"
                                                    onclick="changeStatus(@item.nID, false)">
                                                Enabled
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="status-button status-disabled"
                                                    onclick="changeStatus(@item.nID, true)">
                                                Disabled
                                            </button>
                                        }

                                    </td>


                                    <!-- Action -->
                                    <td class="col-action">

                                        <a href="@Url.Action("Edit", "SAobjective", new { id = item.nID })"
                                           class="edit-button"
                                           title="Edit">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                    </td>

                                </tr>

                                srNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="no-data">
                                    No objectives found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
<script>

    document.addEventListener("DOMContentLoaded", function () {
        debugger;
        const searchBox = document.getElementById("objectiveSearch");
        const entriesSelect = document.getElementById("entriesPerPage");
        const table = document.getElementById("objectiveTable");
        const rows = Array.from(
            table.querySelectorAll("tbody tr")
        );

        let currentPageSize = 25;


        /* -------------------------------
           SEARCH
        -------------------------------- */

        searchBox.addEventListener("keyup", function () {

            const searchValue =
                this.value.toLowerCase().trim();

            rows.forEach(function (row) {

                const rowText =
                    row.innerText.toLowerCase();

                if (rowText.includes(searchValue)) {
                    row.style.display = "";
                }
                else {
                    row.style.display = "none";
                }

            });

        });


        /* -------------------------------
           ENTRIES PER PAGE
        -------------------------------- */

        entriesSelect.addEventListener("change", function () {

            const value = this.value;

            if (value === "all") {

                rows.forEach(function (row) {
                    row.style.display = "";
                });

                return;
            }

            currentPageSize = parseInt(value);

            rows.forEach(function (row, index) {

                if (index < currentPageSize) {
                    row.style.display = "";
                }
                else {
                    row.style.display = "none";
                }

            });

        });

    });


    /* -------------------------------
       CHANGE STATUS
    -------------------------------- */

    function changeStatus(id, status) {

        $.ajax({

            url: '@Url.Action("ChangeStatus", "SuperAdmin")',

            type: "POST",

            data: {
                id: id,
                status: status
            },

            success: function (response) {

                if (response.success) {

                    location.reload();

                }
                else {

                    alert(response.message);

                }

            },

            error: function (xhr) {

                console.log(xhr.responseText);

                alert("Unable to change status.");

            }

        });

    }

</script>