@model IEnumerable<ErJobPortal.Models.SAOrgFeedbackM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Feedback Details";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/SAOrgFeedback.css"
          asp-append-version="true" />

}


<div class="feedback-page">

    <!-- PAGE TITLE -->

 


    <!-- ORGANIZATION NAME -->

    <div class="organization-name">
        @ViewBag.OrganizationName
    </div>


    <!-- MASTER TABLE -->

    <div class="master-table-container">
           <h1 class="feedback-title">
        Organization Feedback Details
    </h1>
        <table id="feedbackTable"
               class="master-data-table"
               data-mobile-scroll="true">

            <thead>

                <tr>

                    <th>Que 1</th>

                    <th>Ans 1</th>

                    <th>Que 2</th>

                    <th>Ans 2</th>

                    <th>Que 3</th>

                    <th>Ans 3</th>

                    <th>Que 4</th>

                    <th>Ans 4</th>

                    <th>Que 5</th>

                    <th>Ans 5</th>

                    <th>Action</th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Que1
                            </td>

                            <td>
                                @item.Ans1
                            </td>

                            <td>
                                @item.Que2
                            </td>

                            <td>
                                @item.Ans2
                            </td>

                            <td>
                                @item.Que3
                            </td>

                            <td>
                                @item.Ans3
                            </td>

                            <td>
                                @item.Que4
                            </td>

                            <td>
                                @item.Ans4
                            </td>

                            <td>
                                @item.Que5
                            </td>

                            <td>
                                @item.Ans5
                            </td>

                            <td>

                                <div class="action-icons">

                                    <!-- VIEW -->

                                    <a asp-controller="SuperAdmin"
                                       asp-action="DetailsSAOrgFeedback"
                                       asp-route-id="@item.nID"
                                       class="view-icon"
                                       title="View">

                                        <i class="fas fa-eye"></i>

                                    </a>


                                    <!-- EDIT -->

                                    <a asp-controller="SuperAdmin"
                                       asp-action="EditSAOrgFeedback"
                                       asp-route-id="@item.nID"
                                       class="edit-icon"
                                       title="Edit">

                                        <i class="fas fa-edit"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="11"
                            class="text-center">

                            No feedback found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>


        <!-- MASTER PAGE INFO -->

        <div id="feedbackPageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>