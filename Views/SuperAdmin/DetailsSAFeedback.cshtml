<div class="feedback-page">

    <div class="feedback-main-card">

        <!-- TITLE -->

        <h1 class="feedback-heading">
            Trainee Feedback
        </h1>


        <!-- ================================================= -->
        <!-- QUESTION 1 -->
        <!-- ================================================= -->

        <div class="feedback-question">

            <div class="question-number">
                  1.
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que1
                </div>

                <div class="answer-area">

                    <div class="radio-answer">

                        <span class="radio-circle"></span>

                        <span class="radio-text">
                            True
                        </span>

                        <span class="radio-circle"></span>

                        <span class="radio-text">
                            False
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- QUESTION 2 -->
        <!-- ================================================= -->

        <div class="feedback-question">

            <div class="question-number">
                  2.
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que2
                </div>

                <div class="answer-area">

                    <div class="star-answer">

                        ★★★★★

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- QUESTION 3 -->
        <!-- ================================================= -->

        <div class="feedback-question">

            <div class="question-number">
                  3.
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que3
                </div>

                <div class="answer-area">

                    <div class="radio-answer">

                        <span class="radio-circle"></span>

                        <span class="radio-text">
                            Yes
                        </span>

                        <span class="radio-circle"></span>

                        <span class="radio-text">
                            No
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- QUESTION 4 -->
        <!-- ================================================= -->

        <div class="feedback-question">

            <div class="question-number">
                  4.
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que4
                </div>

                <div class="answer-area">

                    <div class="emoji-answer">
                        😞 😟 😐 🙂 😍
                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- QUESTION 5 -->
        <!-- ================================================= -->

        <div class="feedback-question">

            <div class="question-number">
                  5.
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que5
                </div>

                <div class="description-answer">
                    @Model.Ans5
                </div>

            </div>

        </div>

    </div>

</div>