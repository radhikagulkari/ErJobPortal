@model IEnumerable<ErJobPortal.Models.SACandidateFeedbackM>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Trainee Feedback";

    ViewData["Panel"] = "SuperAdmin";

    ViewData["UserName"] = "Super Admin";
}

<style>

    .feedback-page {
        width: 100%;
        padding: 15px;
        box-sizing: border-box;
    }

    .feedback-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .feedback-title {
        margin: 0;
        font-size: 30px;
        font-weight: 600;
        color: #142238;
    }

    .feedback-subtitle {
        margin-top: 8px;
        font-size: 16px;
        color: #888;
    }

    .back-button {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: #1e7b67;
        color: #ffffff;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        font-size: 16px;
        transition: 0.2s ease;
    }

    .back-button:hover {
        background: #155d4e;
        color: #ffffff;
        text-decoration: none;
    }

    .status-button {
        border: none;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        cursor: pointer;
        min-width: 75px;
    }

    .status-enabled {
        background: #198754;
    }

    .status-disabled {
        background: #dc3545;
    }

    .status-button:hover {
        opacity: 0.9;
    }

    @@media (max-width: 768px) {

        .feedback-page {
            padding: 10px;
        }

      

        .feedback-title {
            font-size: 24px;
        }

        .feedback-subtitle {
            font-size: 14px;
        }

        .back-button {
            width: 40px;
            height: 40px;
        }

    }
    .feedback-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    width: 100%;
}

.feedback-title {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    color: #142238;
}

.feedback-subtitle {
    margin-top: 8px;
    font-size: 16px;
    color: #888;
}

.back-button {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: #1e7b67;
    color: #ffffff;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
    font-size: 16px;
    flex-shrink: 0;
}

.back-button:hover {
    background: #155d4e;
    color: #ffffff;
    text-decoration: none;
}



</style>

<div class="feedback-page">

    <!-- TITLE -->

   


    <!-- MASTER TABLE -->

    <div class="master-table-container">
       <div class="feedback-title-row">

    <!-- LEFT SIDE -->
    <div>

        <h1 class="feedback-title">
            Trainee Feedback Details
        </h1>

        <div class="feedback-subtitle">
            ItNetworkZ
        </div>

    </div>


    <!-- RIGHT SIDE -->
    <a href="javascript:history.back();"
       class="back-button"
       title="Back">

        <i class="fas fa-arrow-left"></i>

    </a>

</div>
        <table id="feedbackTable"
               class="master-data-table"
               data-mobile-scroll="true">

            <thead>

                <tr>

                    <th>
                        Sr. No
                    </th>

                    <th>
                        Trainee ID
                    </th>

                    <th>
                        Trainee Name
                    </th>

                    <th>
                        Status
                    </th>

                    <th>
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @{
                    int srNo = 1;
                }

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <!-- SR NO -->

                            <td>
                                @srNo
                            </td>


                            <!-- TRAINEE ID -->

                            <td>
                                @item.nID
                            </td>


                            <!-- TRAINEE NAME -->

                            <td>
                                @item.sFName @item.sLName
                            </td>


                            <!-- STATUS -->

                            <td>

                                <form asp-controller="SuperAdmin"
                                      asp-action="ToggleCandidateFeedback"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.nID" />

                                    @if (item.nSABit == 1)
                                    {
                                        <button type="submit"
                                                class="status-button status-enabled"
                                                onclick="return confirm('Are you sure you want to disable this feedback?');">

                                            Enabled

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="status-button status-disabled"
                                                onclick="return confirm('Are you sure you want to enable this feedback?');">

                                            Disabled

                                        </button>
                                    }

                                </form>

                            </td>


                            <!-- ACTION -->

                            <td>

                                <a asp-controller="SuperAdmin"
                                   asp-action="DetailsCandidateFeedback"
                                   asp-route-id="@item.nID"
                                   class="master-action-btn"
                                   title="View">

                                    <i class="fas fa-eye"></i>

                                </a>

                            </td>

                        </tr>

                        srNo++;
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            class="text-center">

                            No trainee feedback found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>


        <!-- MASTER PAGE INFO -->

        <div id="feedbackPageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>

 