    <!-- =========================================================
         NAVBAR JAVASCRIPT

         Plain vanilla JS - does NOT rely on bootstrap.Collapse
         or bootstrap.Dropdown APIs, so the hamburger and the
         Organization dropdown work even if the Bootstrap JS
         bundle on this page is missing, stale, or a different
         major version than the markup expects. All it ever does
         is toggle a ".show" class, which the CSS above renders.
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const navbar = document.getElementById("traineeNavbar");
            const toggler = document.getElementById("traineeNavbarToggler");
            const icon = toggler ? toggler.querySelector("i") : null;


            /* =====================================================
               OPEN / CLOSE HAMBURGER MENU
            ====================================================== */

            function setMenuOpen(isOpen) {

                if (!navbar || !toggler) {
                    return;
                }

                navbar.classList.toggle("show", isOpen);
                toggler.setAttribute("aria-expanded", isOpen ? "true" : "false");

                if (icon) {
                    icon.classList.toggle("fa-bars", !isOpen);
                    icon.classList.toggle("fa-xmark", isOpen);
                }
            }

            if (toggler && navbar) {

                toggler.addEventListener("click", function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                    const isOpen = !navbar.classList.contains("show");
                    setMenuOpen(isOpen);

                });
            }


            /* =====================================================
               ORGANIZATION DROPDOWN (works on mobile + desktop)
            ====================================================== */

            const dropdownToggles =
                document.querySelectorAll(".trainee-navbar .dropdown-toggle");

            dropdownToggles.forEach(function (toggle) {

                toggle.addEventListener("click", function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                    const parentItem = toggle.closest(".dropdown");
                    const menu = parentItem
                        ? parentItem.querySelector(".dropdown-menu")
                        : null;

                    if (!menu) {
                        return;
                    }

                    const isOpen = menu.classList.contains("show");

                    /* close any other open dropdowns first */
                    document
                        .querySelectorAll(".trainee-navbar .dropdown-menu.show")
                        .forEach(function (openMenu) {

                            if (openMenu !== menu) {

                                openMenu.classList.remove("show");

                                const otherToggle =
                                    openMenu.closest(".dropdown").querySelector(".dropdown-toggle");

                                if (otherToggle) {
                                    otherToggle.setAttribute("aria-expanded", "false");
                                }
                            }
                        });

                    menu.classList.toggle("show", !isOpen);
                    toggle.setAttribute("aria-expanded", (!isOpen).toString());
                });
            });


            /* =====================================================
               CLOSE DROPDOWN / MENU ON OUTSIDE CLICK
            ====================================================== */

            document.addEventListener("click", function (event) {

                if (navbar && toggler &&
                    !navbar.contains(event.target) &&
                    !toggler.contains(event.target)) {

                    setMenuOpen(false);
                }

                document
                    .querySelectorAll(".trainee-navbar .dropdown-menu.show")
                    .forEach(function (menu) {

                        const parentItem = menu.closest(".dropdown");

                        if (parentItem && !parentItem.contains(event.target)) {

                            menu.classList.remove("show");

                            const relatedToggle = parentItem.querySelector(".dropdown-toggle");

                            if (relatedToggle) {
                                relatedToggle.setAttribute("aria-expanded", "false");
                            }
                        }
                    });
            });


            /* =====================================================
               CLOSE MENU AFTER A NORMAL LINK CLICK (mobile only)
            ====================================================== */

            if (navbar) {

                const normalLinks =
                    navbar.querySelectorAll(".nav-link:not(.dropdown-toggle), .dropdown-item");

                normalLinks.forEach(function (link) {

                    link.addEventListener("click", function () {

                        if (window.innerWidth < 992) {
                            setMenuOpen(false);
                        }
                    });
                });
            }


            /* =====================================================
               RESET ON RESIZE TO DESKTOP
            ====================================================== */

            window.addEventListener("resize", function () {

                if (window.innerWidth >= 992) {
                    setMenuOpen(false);
                }
            });

        });

    </script>


