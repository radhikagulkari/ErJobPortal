        /* =========================================================
                   HAMBURGER

                   DESKTOP = COMPLETELY HIDDEN
                ========================================================== */

        .trainee-navbar-toggler {
            display: none !important;
            width: 46px;
            height: 46px;
            min-width: 46px;
            padding: 0 !important;
            margin-left: auto;
            border: 1px solid var(--trainee-border) !important;
            border-radius: 9px;
            background: #ffffff !important;
            color: var(--trainee-primary) !important;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            box-shadow: none !important;
            outline: none !important;
            cursor: pointer;
        }


            .trainee-navbar-toggler:hover {
                background: var(--trainee-primary-light) !important;
                border-color: var(--trainee-primary) !important;
            }


            .trainee-navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(30, 123, 103, .12) !important;
            }


            .trainee-navbar-toggler i {
                pointer-events: none;
            }


        /* =========================================================
                   TABLET + MOBILE

                   HAMBURGER APPEARS BELOW 992px
                ========================================================== */

        @@media (max-width: 991.98px) {
            /* NAVBAR */

            .trainee-navbar {
                min-height: 82px;
                overflow: visible !important;
            }


                .trainee-navbar .container-fluid {
                    min-height: 82px;
                    padding-left: 20px;
                    padding-right: 20px;
                    flex-wrap: wrap;
                }
            /* LOGO */

            .trainee-navbar-brand {
                margin-right: 0 !important;
            }


            .trainee-logo-icon {
                width: 43px;
                height: 43px;
                min-width: 43px;
                font-size: 18px;
            }


            .trainee-logo-text {
                font-size: 22px;
            }
            /* =====================================================
                       SHOW HAMBURGER
                    ====================================================== */

            .trainee-navbar-toggler {
                display: flex !important;
                flex-shrink: 0;
            }
            /* =====================================================
                       COLLAPSE

                       IMPORTANT:
                       width 100% makes menu appear UNDER navbar
                    ====================================================== */

            .trainee-navbar-collapse {
                /* Positioned OUT of normal flow so opening it never
                   changes the header's height - this is what was
                   causing the page content (and the navbar itself)
                   to jump/shake upward or downward on toggle. */
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                width: 100%;
                max-height: calc(100vh - 82px);
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
                background: #ffffff;
                border-top: 1px solid #edf2f0;
                padding: 12px 20px 18px;
                margin-top: 0;
                box-shadow: 0 20px 45px rgba(31, 77, 66, .16);
            }
            /* =====================================================
                       MENU
                    ====================================================== */

            .trainee-navbar .navbar-nav {
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: stretch;
                gap: 2px;
                margin: 0 !important;
            }


            .trainee-navbar .nav-item {
                width: 100%;
            }


            .trainee-navbar .nav-link {
                width: 100%;
                min-height: 46px;
                padding: 11px 15px !important;
                border-radius: 8px;
                justify-content: flex-start;
            }


                .trainee-navbar .nav-link:hover {
                    background: var(--trainee-primary-light);
                }


                .trainee-navbar .nav-link.active {
                    background: var(--trainee-primary-light);
                }


                    .trainee-navbar .nav-link.active::after {
                        display: none;
                    }
            /* =====================================================
                       MOBILE DROPDOWN
                    ====================================================== */

            .trainee-navbar .dropdown-menu {
                position: static;
                width: 100%;
                min-width: 100%;
                margin: 0 !important;
                padding: 5px 8px;
                border: 0;
                border-radius: 8px;
                box-shadow: none;
                background: #f7fbf9;
            }


            .trainee-navbar .dropdown-item {
                padding: 11px 15px;
                font-size: 13px;
            }
            /* =====================================================
                       AUTH BUTTONS
                    ====================================================== */

            .trainee-navbar-actions {
                width: 100%;
                margin: 12px 0 0;
                padding: 14px 0 0;
                border-top: 1px solid #edf2f0;
                display: flex;
                gap: 10px;
            }


            .trainee-signin,
            .trainee-signup {
                flex: 1;
                min-width: 0;
                height: 43px;
            }
        }


        /* =========================================================
                   MOBILE
                ========================================================== */

        @@media (max-width: 575.98px) {

            .trainee-navbar .container-fluid {
                padding-left: 12px;
                padding-right: 12px;
            }


            .trainee-navbar {
                min-height: 76px;
            }


                .trainee-navbar .container-fluid {
                    min-height: 76px;
                }


            .trainee-logo-icon {
                width: 40px;
                height: 40px;
                min-width: 40px;
                border-radius: 10px;
                font-size: 17px;
            }


            .trainee-logo-text {
                font-size: 20px;
            }


            .trainee-navbar-toggler {
                width: 43px;
                height: 43px;
                min-width: 43px;
                font-size: 18px;
            }


            .trainee-navbar-collapse {
                padding: 10px 2px 16px;
            }


            .trainee-navbar .nav-link {
                min-height: 44px;
                font-size: 13px;
                padding: 10px 13px !important;
            }


            .trainee-navbar-actions {
                gap: 8px;
            }


            .trainee-signin,
            .trainee-signup {
                font-size: 12px;
                height: 41px;
            }
        }


        /* =========================================================
                   EXTRA SMALL MOBILE
                ========================================================== */

        @@media (max-width: 380px) {

            .trainee-logo-text {
                font-size: 18px;
            }


            .trainee-logo-icon {
                width: 37px;
                height: 37px;
                min-width: 37px;
                font-size: 15px;
            }


            .trainee-navbar-toggler {
                width: 40px;
                height: 40px;
                min-width: 40px;
            }
        }


        /* =========================================================
                   DESKTOP

                   COLLAPSE ALWAYS VISIBLE, HAMBURGER HIDDEN
                ========================================================== */

        @@media (min-width: 992px) {

            .trainee-navbar-toggler {
                display: none !important;
            }


            .trainee-navbar-collapse {
                display: flex !important;
                flex-basis: auto !important;
                width: auto;
                background: transparent;
                border: 0;
                padding: 0;
                margin: 0;
                box-shadow: none;
            }


            .trainee-navbar .navbar-nav {
                display: flex !important;
                flex-direction: row;
                width: auto;
                /* Pushes the nav links (and, since it comes right
                   after in the flex row, the auth buttons too) over
                   to the right side of the navbar, next to the logo. */
                margin-left: auto;
            }


            .trainee-navbar-actions {
                display: flex !important;
                margin-left: 28px;
            }

            .trainee-navbar .dropdown-menu {
                position: absolute;
            }
        }


        /* =========================================================
                   CONTENT TOP SPACING
                ========================================================== */

        body.site-modern {
            padding-top: 0;
        }


        /* =========================================================
                   PRELOADER
                ========================================================== */
/* =========================================================
   GLOBAL PAGE LOADER
========================================================= */

        .preloaders {
            z-index: 999999 !important;
        }
    </style>

</head>


<body class="site-modern @ViewData["BodyClass"]">


    <!-- =========================================================
         PRELOADER
    ========================================================== -->

<div class="preloaders">

    <div class="trainee-loader">

        <!-- Outer Orbit -->
        <div class="trainee-orbit orbit-one"></div>

        <!-- Inner Orbit -->
        <div class="trainee-orbit orbit-two"></div>


        <!-- Orbit Dots -->
        <span class="trainee-dot dot-one"></span>

        <span class="trainee-dot dot-two"></span>

        <span class="trainee-dot dot-three"></span>

        <span class="trainee-dot dot-four"></span>


        <!-- Center -->
        <div class="trainee-core">

            <span>1Trainee</span>

        </div>

    </div>

</div>

    <!-- =========================================================
         START NAVBAR
    ========================================================== -->

    <header id="mainHeader">

        <nav class="navbar navbar-expand-lg trainee-navbar">

            <div class="container-fluid">


                <!-- =================================================
                     LOGO
                ================================================== -->

                <a class="navbar-brand trainee-navbar-brand"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="1Trainee Home">

                    <span class="trainee-logo-icon">

                        <i class="fa-solid fa-graduation-cap"></i>

                    </span>


                    <span class="trainee-logo-text">

                        1<span>Trainee</span>

                    </span>

                </a>


                <!-- =================================================
                     HAMBURGER
                ================================================== -->

                <button class="navbar-toggler trainee-navbar-toggler"
                        type="button"
                        id="traineeNavbarToggler"
                        aria-controls="traineeNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <i class="fa-solid fa-bars"></i>

                </button>


                <!-- =================================================
                     COLLAPSE AREA
                ================================================== -->

                <div class="collapse navbar-collapse trainee-navbar-collapse"
                     id="traineeNavbar">


                    <!-- =================================================
                         MAIN NAVIGATION
                    ================================================== -->

<ul class="navbar-nav mb-2 mb-lg-0">

    <!-- HOME -->
    <li class="nav-item">
        <a class="nav-link @navActive("Home", "Index")"
           asp-controller="Home"
           asp-action="Index">
            Home
        </a>
    </li>

    <!-- ABOUT -->
    <li class="nav-item">
        <a class="nav-link @navActive("Home", "About")"
           asp-controller="Home"
           asp-action="About">
            About
        </a>
    </li>

    <!-- ORGANIZATION -->
    <li class="nav-item dropdown">

        <a class="nav-link dropdown-toggle @navActive("Home", "Organization")"
           href="#"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
            Organization
        </a>

        <ul class="dropdown-menu">

            <!-- ORGANIZATION -->
            <li>
                <a class="dropdown-item @navActive("Home", "Organization")"
                   asp-controller="Home"
                   asp-action="Organization">

                    <i class="fa-solid fa-building me-2"></i>
                    Organization

