    <!-- =========================================================
         CUSTOM NAVBAR CSS
    ========================================================== -->

    <style>

        /* =========================================================
                   ROOT
                ========================================================== */

        :root {
            --trainee-primary: #1e7b67;
            --trainee-primary-dark: #176553;
            --trainee-primary-light: #eaf6f2;
            --trainee-border: #e1ebe7;
            --trainee-text: #344054;
            --trainee-muted: #667085;
        }


        /* =========================================================
                   RESET
                ========================================================== */

        .trainee-navbar,
        .trainee-navbar *,
        .trainee-navbar *::before,
        .trainee-navbar *::after {
            box-sizing: border-box;
        }


        /* =========================================================
                   MAIN NAVBAR
                ========================================================== */

        .trainee-navbar {
            width: 100%;
            min-height: 96px;
            padding: 0 !important;
            background: #ffffff !important;
            border-bottom: 1px solid var(--trainee-border);
            box-shadow: 0 4px 20px rgba(31, 77, 66, 0.08);
            position: fixed;
            z-index: 99999;
                top: 0px !important;
        }


            .trainee-navbar .container-fluid {
                min-height: 96px;
                padding-left: 35px;
                padding-right: 35px;
                display: flex;
                align-items: center;
            }


        /* =========================================================
                   LOGO
                ========================================================== */

        .trainee-navbar-brand {
            display: inline-flex !important;
            align-items: center;
            gap: 10px;
            margin: 0 40px 0 0 !important;
            padding: 0 !important;
            text-decoration: none !important;
            flex-shrink: 0;
        }


        .trainee-logo-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--trainee-primary);
            color: #ffffff;
            border-radius: 11px;
            font-size: 19px;
            box-shadow: 0 6px 18px rgba(30, 123, 103, 0.18);
        }


        .trainee-logo-text {
            color: #1f2937;
            font-family: "Plus Jakarta Sans", sans-serif;
            font-size: 24px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -0.7px;
        }


            .trainee-logo-text span {
                color: var(--trainee-primary);
            }


        /* =========================================================
                   NAVBAR COLLAPSE DESKTOP
                ========================================================== */

        .trainee-navbar-collapse {
            align-items: center;
            flex-grow: 1;
        }


        /* =========================================================
                   FORCE .show / hidden STATE
                   (Independent of whichever Bootstrap JS/CSS
                   version actually ships in this project - the
                   toggle logic below only ever adds/removes the
                   plain ".show" class, so these rules make sure
                   the visual state always matches it.)
                ========================================================== */

        .trainee-navbar .dropdown-menu {
            display: none;
        }

            .trainee-navbar .dropdown-menu.show {
                display: block !important;
            }

        @@media (max-width: 991.98px) {

            .trainee-navbar-collapse:not(.show) {
                display: none !important;
            }

            .trainee-navbar-collapse.show {
                display: block !important;
                animation: trainee-menu-in .22s ease;
            }
        }

        @@keyframes trainee-menu-in {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* =========================================================
                   NAVIGATION
                ========================================================== */

        .trainee-navbar .navbar-nav {
            display: flex;
            align-items: center;
            gap: 4px;
        }


        .trainee-navbar .nav-item {
            position: relative;
        }


        .trainee-navbar .nav-link {
            position: relative;
            display: flex;
            align-items: center;
            min-height: 96px;
            padding: 0 15px !important;
            color: var(--trainee-text) !important;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none !important;
            transition: color .2s ease, background .2s ease;
        }


            .trainee-navbar .nav-link:hover {
                color: var(--trainee-primary) !important;
            }


            .trainee-navbar .nav-link.active {
                color: var(--trainee-primary) !important;
            }


                /* =========================================================
                   ACTIVE UNDERLINE
                ========================================================== */

                .trainee-navbar .nav-link.active::after {
                     content: "";
    position: absolute;
    left: 15px;
    right: 15px;
    height: 3px;
    background: var(--trainee-primary);
    border-radius: 50px;
    top: 60px;
                }


        /* =========================================================
                   DROPDOWN ARROW
                ========================================================== */

        .trainee-navbar .dropdown-toggle::after {
            margin-left: 7px;
            vertical-align: middle;
            border-top-color: var(--trainee-primary);
            transition: transform .2s ease;
        }

        .trainee-navbar .dropdown-toggle[aria-expanded="true"]::after {
            transform: rotate(180deg);
        }


        /* =========================================================
                   DROPDOWN MENU
                ========================================================== */

        .trainee-navbar .dropdown-menu {
            min-width: 220px;
            margin-top: 0 !important;
            padding: 8px;
            border: 1px solid var(--trainee-border);
            border-radius: 11px;
            background: #ffffff;
            box-shadow: 0 18px 40px rgba(31, 77, 66, 0.14);
            z-index: 100000;
        }


        .trainee-navbar .dropdown-item {
            display: flex;
            align-items: center;
            padding: 11px 13px;
            border-radius: 8px;
            color: var(--trainee-text);
            font-family: "Inter", sans-serif;
            font-size: 13px;
            font-weight: 500;
            transition: background .2s ease, color .2s ease;
        }


            .trainee-navbar .dropdown-item:hover {
                background: var(--trainee-primary-light);
                color: var(--trainee-primary);
            }

            .trainee-navbar .dropdown-item.active {
                background: var(--trainee-primary-light);
                color: var(--trainee-primary);
                font-weight: 700;
            }


        /* =========================================================
                   AUTH BUTTONS
                ========================================================== */

     /* =========================================================
   NAVBAR ACTIONS
   ========================================================= */

.trainee-navbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.trainee-navbar-actions .trainee-signup {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: auto;
    min-width: 120px;
    height: 48px;

    padding: 0 26px;

    border: none;
    border-radius: var(--radius-pill);

    background: linear-gradient(
        135deg,
        var(--brand-500),
        var(--brand-700)
    );

    color: #ffffff !important;

    text-decoration: none !important;

    font-family: "Inter", sans-serif;
    font-size: 16px;
    font-weight: 600;

    box-shadow: 0 8px 20px rgba(13, 148, 136, 0.35);

    cursor: pointer;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}


/* =========================================================
   SIGN IN + SIGN UP COMMON STYLE
   ========================================================= */

.trainee-signin,
.trainee-signup {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    height: 48px;
    min-width: 120px;

    padding: 0 26px;

    border-radius: var(--radius-pill);

    font-family: "Inter", sans-serif;
    font-size: 16px;
    font-weight: 600;

    text-decoration: none !important;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease;
}


/* =========================================================
   SIGN IN BUTTON
   ========================================================= */

.trainee-signin {
    border: 1px solid var(--trainee-border);

    background: #ffffff;

    color: var(--trainee-text) !important;

    box-shadow: none;
}


/* SIGN IN HOVER */

.trainee-signin:hover {
    color: var(--brand-700) !important;

    border-color: var(--brand-500);

    background: var(--trainee-primary-light);

    transform: translateY(-2px);

    box-shadow: 0 8px 18px rgba(13, 148, 136, 0.18);
}


/* =========================================================
   SIGN UP BUTTON
   ========================================================= */

.trainee-signup {
    border: none;

    background: linear-gradient(
        135deg,
        var(--brand-500),
        var(--brand-700)
    );

    color: #ffffff !important;

    box-shadow: 0 8px 20px rgba(13, 148, 136, 0.35);
}


/* SIGN UP HOVER */

.trainee-signup:hover {
    color: #ffffff !important;

    background: linear-gradient(
        135deg,
        var(--brand-700),
        var(--brand-500)
    );

    transform: translateY(-2px);

    box-shadow: 0 12px 25px rgba(13, 148, 136, 0.42);
}


/* =========================================================
   ACTIVE
   ========================================================= */

.trainee-signin:active,
.trainee-signup:active {
    transform: translateY(0);

    box-shadow: 0 6px 14px rgba(13, 148, 136, 0.30);
}


/* =========================================================
   MOBILE
   ========================================================= */

@@media (max-width: 991px) {

    .trainee-navbar-actions {
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
    }

    .trainee-navbar-actions .trainee-signin,
    .trainee-navbar-actions .trainee-signup {
        width: 100%;
        min-width: 0;
        height: 46px;
    }

}
